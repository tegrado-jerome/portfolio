---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#eef0f2" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {site.ogImage && <meta property="og:image" content={new URL(site.ogImage, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- The one font, self-hosted (see global.css): no third-party request to block the first paint. -->
    <link rel="preload" href="/fonts/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    {site.gscVerification && <meta name="google-site-verification" content={site.gscVerification} />}

    <script is:inline>
      // Runs before first paint so a saved dark theme never flashes.
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        var theme;
        try {
          theme = localStorage.getItem("theme");
        } catch (e) {}
        if (theme === "dark") {
          root.dataset.theme = "dark";
          document.querySelector('meta[name="theme-color"]').content = "#141a22";
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="eyebrow sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-ink focus:px-4 focus:py-3 focus:text-paper"
      >Skip to content</a
    >
    <slot />


    <script>
      // "Back to top" links point at "/" — on the home page, scroll up instead of reloading,
      // and keep the address bar clean (no "#top").
      document.querySelectorAll<HTMLAnchorElement>("a[data-to-top]").forEach((a) =>
        a.addEventListener("click", (e) => {
          if (location.pathname !== "/") return;
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
          history.replaceState(null, "", "/");
        }),
      );
    </script>

    <script>
      // Reveal elements as they scroll into view — held back until the preloader lifts.
      const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const start = () => {
        if (!("IntersectionObserver" in window)) {
          targets.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              // Also reveal anything already scrolled past (e.g. after jumping to a #section link).
              if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        targets.forEach((el) => io.observe(el));
      };
      if (document.documentElement.classList.contains("is-preloading")) {
        document.addEventListener("preloader:done", start, { once: true });
      } else {
        start();
      }
    </script>

    {
      site.gaId && (
        <script is:inline define:vars={{ gaId: site.gaId }}>
          // Google Analytics 4, loaded once the page has finished loading so it never slows the first paint.
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            dataLayer.push(arguments);
          };
          gtag("js", new Date());
          gtag("config", gaId);
          addEventListener("load", function () {
            setTimeout(function () {
              var s = document.createElement("script");
              s.async = true;
              s.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
              document.head.appendChild(s);
            }, 1500);
          });
        </script>
      )
    }
  </body>
</html>
