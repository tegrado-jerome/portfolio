---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";
import Chat from "../components/Chat.astro";
import { site } from "../data/site";
---

<Layout title={`Page not found | ${site.name}`}>
  <Header />
  <main id="main">
    <section class="shell section" aria-labelledby="not-found-title">
      <p class="eyebrow mb-[clamp(14px,2vw,22px)] text-muted">404</p>
      <h1 id="not-found-title" class="mb-[clamp(18px,2.5vw,28px)] font-serif text-display font-normal">Lost the thread.</h1>
      <p class="text-body text-ink-soft">This page doesn’t exist. <a href="/" class="link-strong font-medium">Back to the start</a>.</p>
    </section>
  </main>
  <Footer />
  <CommandPalette />
  <Chat />
</Layout>
