---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette.astro";
import Chat from "../components/Chat.astro";
import StatusBar from "../components/StatusBar.astro";
import { site } from "../data/site";
---

<Layout title={`Page not found | ${site.name}`}>
  <Header />
  <main id="main">
    <section class="shell section" aria-labelledby="not-found-title">
      <div class="pane" data-pane="404">
        <div class="absolute inset-x-0 top-0 flex text-small" aria-hidden="true">
          <span class="text-ink"><span class="text-accent">~/</span>404</span>
        </div>
        <p class="mb-[clamp(14px,2vw,22px)] text-small text-muted"><span class="text-accent">jerome@ai</span> ~ cd {"<unknown>"}</p>
        <h1 id="not-found-title" class="mb-[clamp(18px,2.5vw,28px)] text-display font-medium tracking-[-0.045em]">Lost the thread.</h1>
        <p class="text-body text-ink-soft">This page doesn’t exist. <a href="/" class="link-strong font-medium">cd ~ (back to the start)</a></p>
      </div>
    </section>
  </main>
  <Footer />
  <CommandPalette />
  <Chat />
  <StatusBar />
</Layout>
