---
// One modal for every card (projects, awards, certifications): a click copies that card's <template data-detail>
// (see Detail.astro) in here. Styled like the command menu; closes with the button, Escape or a click outside.
// Where the browser supports View Transitions, the card's picture grows into the modal's picture and back.
import { faXmark } from "@fortawesome/free-solid-svg-icons";
import Icon from "./Icon.astro";
---

<dialog id="detail" class="detail" aria-labelledby="detail-title">
  <div class="detail-panel">
    <button type="button" data-detail-close class="tui-btn absolute top-3 right-3 inline-flex" aria-label="Close">
      [ <Icon icon={faXmark} class="text-[12px]" /> esc ]
    </button>
    <div data-detail-body></div>
  </div>
</dialog>

<style>
  .detail {
    width: min(640px, calc(100% - 32px));
    max-width: none;
    max-height: calc(100svh - 32px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: 0 24px 60px -20px rgb(20 20 20 / 0.3);
    overscroll-behavior: contain;
  }
  .detail-panel {
    position: relative;
    padding: clamp(20px, 4vw, 32px);
  }
  /* The path line leaves room for the close button on its right. */
  .detail :global(.detail-path) {
    padding-right: 96px;
  }
  .detail :global(.detail-link) {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .detail :global(.detail-link:hover) {
    background: var(--color-accent);
  }
  .detail::backdrop {
    background: rgb(20 20 20 / 0.35);
  }
  /* The page behind stays put while the modal is open. */
  :global(html:has(.detail[open])) {
    overflow: hidden;
  }
  /* Rises and fades in, and fades back out on close. */
  @media (prefers-reduced-motion: no-preference) {
    .detail,
    .detail::backdrop {
      transition:
        opacity 0.3s var(--ease-out-soft),
        translate 0.3s var(--ease-out-soft),
        scale 0.3s var(--ease-out-soft),
        overlay 0.3s allow-discrete,
        display 0.3s allow-discrete;
      opacity: 0;
    }
    .detail {
      translate: 0 12px;
      scale: 0.98;
    }
    .detail[open],
    .detail[open]::backdrop {
      opacity: 1;
      translate: 0 0;
      scale: 1;
    }
    @starting-style {
      .detail[open],
      .detail[open]::backdrop {
        opacity: 0;
      }
      .detail[open] {
        translate: 0 12px;
        scale: 0.98;
      }
    }
  }
  /* The picture's morph: the same soft curve as the modal. Both pictures fill the moving box, cropped, so the
     card's 5:4 cover and the modal's 16:10 frame blend without stretching. */
  :global(::view-transition-group(detail-media)) {
    animation-duration: 0.45s;
    animation-timing-function: var(--ease-out-soft);
  }
  :global(::view-transition-old(detail-media)),
  :global(::view-transition-new(detail-media)) {
    height: 100%;
    object-fit: cover;
  }
  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation-duration: 0.3s;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#detail")!;
  const body = dialog.querySelector<HTMLElement>("[data-detail-body]")!;

  const morphs = "startViewTransition" in document && !matchMedia("(prefers-reduced-motion: reduce)").matches;
  let source: HTMLElement | null = null; // the card picture the modal opened from
  const media = () => body.querySelector<HTMLElement>("figure");

  // Runs `update` as a view transition, with the shared picture name moved from `from` to `to`.
  function morph(from: HTMLElement | null, to: () => HTMLElement | null, update: () => void) {
    if (!morphs || !from) return update();
    from.style.viewTransitionName = "detail-media";
    const transition = document.startViewTransition(() => {
      from.style.viewTransitionName = "";
      update();
      const target = to();
      if (target) target.style.viewTransitionName = "detail-media";
    });
    transition.finished.finally(() => {
      const target = to();
      if (target) target.style.viewTransitionName = "";
    });
  }

  function open(trigger: HTMLElement) {
    const card = trigger.closest<HTMLElement>(".card");
    const template = card?.querySelector<HTMLTemplateElement>("template[data-detail]");
    if (!card || !template) return;
    source = card.querySelector<HTMLElement>(".media") ?? card;
    morph(source, media, () => {
      body.replaceChildren(template.content.cloneNode(true));
      body.querySelector("[data-detail-title]")!.id = "detail-title";
      dialog.showModal();
      dialog.scrollTop = 0;
      // Focus the close button without the ring a mouse click shouldn't show.
      dialog.querySelector<HTMLElement>("[data-detail-close]")!.focus({ focusVisible: false } as FocusOptions);
    });
  }

  function close() {
    // Only morph back when the card is on screen; otherwise it would fly in from off the page.
    const r = source?.getBoundingClientRect();
    const visible = r && r.bottom > 0 && r.top < innerHeight;
    morph(visible ? media() : null, () => source, () => dialog.close());
  }

  document.querySelectorAll<HTMLElement>("[data-detail-open]").forEach((trigger) =>
    trigger.addEventListener("click", () => open(trigger)),
  );
  dialog.querySelector("[data-detail-close]")!.addEventListener("click", close);
  // Escape closes through the same path, so it morphs back too.
  dialog.addEventListener("cancel", (e) => {
    e.preventDefault();
    close();
  });
  // A click on the dimmed area outside the panel closes it.
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) close();
  });
</script>
