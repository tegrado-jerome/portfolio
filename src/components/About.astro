---
import { site } from "../data/site";
import SectionHead from "./SectionHead.astro";
---

<section id="about" class="shell py-[clamp(56px,8vw,110px)]" aria-labelledby="about-title">
  <SectionHead id="about-title" title="About" />
  <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-[clamp(24px,4vw,64px)]">
    <p data-reveal class="eyebrow text-[11px] text-muted">In short</p>
    <div data-reveal style="--i:1" class="max-w-[640px] space-y-5 text-[15px] leading-[1.75] text-ink-soft">
      {site.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>
