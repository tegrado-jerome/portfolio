---
import { certifications } from "../data/certifications";
import { isSet } from "../data/placeholders";
import Spotlight from "./Spotlight.astro";

const entries = certifications.map((c) => ({
  title: c.name,
  year: c.year,
  href: c.href,
  image: c.image,
  imageAlt: c.imageAlt,
  caption: c.issuer,
  issuer: c.issuer,
  details: isSet(c.credentialId) ? [`Credential ID: ${c.credentialId}`] : [],
}));
---

<Spotlight id="certifications" title="Certifications" entries={entries} placeholder="CERTIFICATE" linkLabel="verify" />
