---
import { certifications } from "../data/certifications";
import CredentialGrid from "./CredentialGrid.astro";

const entries = certifications.map((c) => ({
  title: c.name,
  year: c.year,
  href: c.href,
  image: c.image,
  imageAlt: c.imageAlt,
  lines: [c.issuer, c.credentialId ? `ID ${c.credentialId}` : ""],
}));
---

<CredentialGrid id="certifications" title="Certifications" entries={entries} placeholder="CERTIFICATE" />
