---
import { faCertificate } from "@fortawesome/free-solid-svg-icons";
import { certifications } from "../data/certifications";
import { isSet } from "../data/placeholders";
import CredentialGrid from "./CredentialGrid.astro";

const entries = certifications.map((c) => ({
  title: c.name,
  year: c.year,
  href: c.href,
  image: c.image,
  imageAlt: c.imageAlt,
  caption: c.issuer,
  issuer: c.issuer,
  details: isSet(c.credentialId) ? [`Credential ID: ${c.credentialId}`] : [],
}));
---

<CredentialGrid id="certifications" title="Certifications" entries={entries} placeholder="CERTIFICATE" icon={faCertificate} linkLabel="verify" />
