---
import { capabilities } from "../data/site";
import SectionHead from "./SectionHead.astro";
---

<section id="capabilities" class="shell py-[clamp(56px,8vw,110px)]" aria-labelledby="capabilities-title">
  <SectionHead id="capabilities-title" title="Capabilities" />
  <div class="grid gap-x-[clamp(24px,3vw,48px)] gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      capabilities.map((group, i) => (
        <div data-reveal style={`--i:${i}`} class="border-t border-ink pt-5">
          <h3 class="mb-4 flex items-baseline gap-3 text-[16px] font-medium">
            <span class="text-[12px] tabular-nums text-muted">{String(i + 1).padStart(2, "0")}</span>
            {group.title}
          </h3>
          <ul class="space-y-1.5 text-[14px] text-ink-soft">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
