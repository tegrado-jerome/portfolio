---
import { faArrowDown, faArrowTurnDown, faArrowUp, faMagnifyingGlass } from "@fortawesome/free-solid-svg-icons";
import { site, socials } from "../data/site";
import { isSet } from "../data/placeholders";
import Icon from "./Icon.astro";

type Command = { label: string; group: string; action: string; value: string };

const commands: Command[] = [
  { label: "Home", group: "Go to", action: "goto", value: "top" },
  { label: "Selected Work", group: "Go to", action: "goto", value: "work" },
  { label: "Skills", group: "Go to", action: "goto", value: "skills" },
  { label: "Awards", group: "Go to", action: "goto", value: "awards" },
  { label: "Contact", group: "Go to", action: "goto", value: "contact" },
  { label: "Chat with me", group: "Action", action: "chat", value: "" },
  ...(isSet(site.email) ? [{ label: "Copy email address", group: "Action", action: "copy", value: site.email }] : []),
  { label: "Light theme", group: "Theme", action: "theme", value: "light" },
  { label: "Dark theme", group: "Theme", action: "theme", value: "dark" },
  ...socials.filter((s) => isSet(s.href)).map((s) => ({ label: s.label, group: "Link", action: "link", value: s.href })),
  ...(isSet(site.resume) ? [{ label: "Resume", group: "Link", action: "link", value: site.resume }] : []),
];
---

<dialog id="palette" class="palette" aria-label="Command menu">
  <div class="flex items-center gap-3 border-b border-line px-5">
    <Icon icon={faMagnifyingGlass} class="text-[14px] text-muted" />
    <input
      type="text"
      placeholder="Type a command or search…"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      class="w-full bg-transparent py-4 text-[16px] text-ink placeholder:text-muted focus:outline-none"
    />
  </div>

  <ul id="palette-list" role="listbox" aria-label="Commands" class="max-h-[min(360px,55vh)] overflow-y-auto p-2">
    {
      commands.map((c, i) => (
        <li
          id={`palette-option-${i}`}
          role="option"
          aria-selected="false"
          data-action={c.action}
          data-value={c.value}
          class="flex cursor-pointer items-center justify-between gap-4 rounded-[3px] px-3 py-2.5 text-body aria-selected:bg-ph"
        >
          <span>{c.label}</span>
          <span class="eyebrow text-muted">{c.group}</span>
        </li>
      ))
    }
  </ul>
  <p data-palette-empty hidden class="px-5 pb-5 text-small text-muted">No matching commands.</p>

  <!-- Key hints as small keycaps with a label each (after Linear's command menu). -->
  <p class="flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line px-4 py-2.5 text-small text-muted" aria-hidden="true">
    <span class="inline-flex items-center gap-1.5">
      <kbd class="key"><Icon icon={faArrowUp} class="text-[9px]" /></kbd>
      <kbd class="key"><Icon icon={faArrowDown} class="text-[9px]" /></kbd>
      Navigate
    </span>
    <span class="inline-flex items-center gap-1.5">
      <kbd class="key"><Icon icon={faArrowTurnDown} class="rotate-90 text-[9px]" /></kbd>
      Select
    </span>
    <span class="inline-flex items-center gap-1.5"><kbd class="key">esc</kbd> Close</span>
  </p>
  <p class="sr-only" aria-live="polite" data-palette-status></p>
</dialog>

<style>
  .palette {
    width: min(560px, calc(100% - 32px));
    margin: 18vh auto auto;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: 0 24px 60px -20px rgb(20 20 20 / 0.3);
  }
  .key {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding-inline: 5px;
    border: 1px solid var(--color-line);
    border-radius: 5px;
    background: color-mix(in srgb, var(--color-paper) 45%, white);
    box-shadow: 0 1px 0 var(--color-line);
    color: var(--color-ink);
    font: 500 var(--text-label) / 1 var(--font-mono);
  }
  :global([data-theme="dark"]) .key {
    background: color-mix(in srgb, var(--color-paper) 90%, white);
  }
  .palette::backdrop {
    background: rgb(20 20 20 / 0.25);
  }
  @media (prefers-reduced-motion: no-preference) {
    .palette[open] {
      animation: palette-in 0.18s var(--ease-out-soft);
    }
  }
  @keyframes palette-in {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }
</style>

<script>
  import { setTheme, themes } from "../scripts/theme";

  const dialog = document.querySelector<HTMLDialogElement>("#palette")!;
  const input = dialog.querySelector("input")!;
  const options = [...dialog.querySelectorAll<HTMLLIElement>("[role=option]")];
  const empty = dialog.querySelector<HTMLElement>("[data-palette-empty]")!;
  const status = dialog.querySelector("[data-palette-status]")!;
  let visible = options;
  let active = 0;

  function highlight(index: number) {
    options.forEach((o) => o.setAttribute("aria-selected", "false"));
    active = (index + visible.length) % visible.length;
    const option = visible[active];
    if (!option) return input.removeAttribute("aria-activedescendant");
    option.setAttribute("aria-selected", "true");
    option.scrollIntoView({ block: "nearest" });
    input.setAttribute("aria-activedescendant", option.id);
  }

  function filter() {
    const query = input.value.trim().toLowerCase();
    visible = options.filter((o) => {
      const match = o.textContent!.toLowerCase().includes(query);
      o.hidden = !match;
      return match;
    });
    empty.hidden = visible.length > 0;
    highlight(0);
  }

  function open() {
    if (dialog.open) return;
    input.value = "";
    filter();
    dialog.showModal();
    input.focus();
  }

  async function run(option: HTMLLIElement) {
    const { action, value = "" } = option.dataset;
    if (action === "copy") {
      await navigator.clipboard.writeText(value).catch(() => {});
      status.textContent = "Email address copied";
      setTimeout(() => dialog.close(), 500);
      return;
    }
    dialog.close();
    if (action === "goto") {
      const behavior = matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
      const target = document.getElementById(value);
      // Sections live on the home page; from any other page (like the 404), go there instead.
      if (!target) location.href = value === "top" ? "/" : `/#${value}`;
      else if (value === "top") window.scrollTo({ top: 0, behavior });
      else target.scrollIntoView({ behavior });
    } else if (action === "theme") {
      const theme = themes.find((t) => t === value);
      if (theme) setTheme(theme);
    } else if (action === "chat") {
      document.dispatchEvent(new Event("chat:open"));
    } else if (action === "link") {
      window.open(value, value.startsWith("/") ? "_self" : "_blank", "noopener");
    }
  }

  input.addEventListener("input", filter);
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      highlight(active + (e.key === "ArrowDown" ? 1 : -1));
    } else if (e.key === "Enter" && visible[active]) {
      e.preventDefault();
      run(visible[active]);
    }
  });
  options.forEach((o) => {
    o.addEventListener("click", () => run(o));
    o.addEventListener("pointermove", () => highlight(visible.indexOf(o)));
  });
  // Clicking the backdrop (the dialog element itself, outside its content) closes it.
  dialog.addEventListener("click", (e) => e.target === dialog && dialog.close());

  document.addEventListener("keydown", (e) => {
    const typing = e.target instanceof HTMLElement && e.target.closest("input, textarea, [contenteditable]");
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (dialog.open) dialog.close();
      else open();
    } else if (e.key === "/" && !typing) {
      e.preventDefault();
      open();
    }
  });
  document.querySelectorAll("[data-palette-open]").forEach((b) => b.addEventListener("click", open));
</script>
