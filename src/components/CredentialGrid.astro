---
// A credentials section as tall photo cards (Awards, Certifications) with the caption on the photo, like the hero
// portrait's honor line (after Apple Newsroom): three per row from tablets up, one on phones. Cards without a
// picture yet show a labelled placeholder with the caption in ink.
import SectionHead from "./SectionHead.astro";

export interface Credential {
  title: string;
  year: string;
  /** One short word or two after the year (e.g. "TUP Manila"). */
  caption: string;
  href?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  id: string;
  title: string;
  entries: Credential[];
  /** Label shown in cards that don't have a picture yet. */
  placeholder: string;
}

const { id, title, entries, placeholder } = Astro.props;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

{
  entries.length > 0 && (
    <section id={id} class="shell section" aria-labelledby={`${id}-title`}>
      <div class="pane" data-pane={slug}>
        <SectionHead id={`${id}-title`} title={title} />
        <ul class="grid gap-5 md:grid-cols-3 md:gap-[clamp(20px,2.5vw,32px)]">
          {entries.map((e, i) => {
            const Tag = e.href ? "a" : "div";
            return (
              <li data-reveal style={`--i:${i}`}>
                <Tag
                  href={e.href || undefined}
                  target={e.href ? "_blank" : undefined}
                  rel={e.href ? "noopener noreferrer" : undefined}
                  class:list={["card relative block aspect-[4/5] overflow-hidden rounded-[2px] bg-ph", e.image && "has-image"]}
                >
                  {e.image ? (
                    <img src={e.image} alt={e.imageAlt ?? ""} loading="lazy" decoding="async" class="size-full object-cover" />
                  ) : (
                    <span class="eyebrow absolute inset-0 grid place-items-center text-muted">[{placeholder}]</span>
                  )}
                  <span class="caption absolute inset-x-0 bottom-0 block px-4 pt-16 pb-4">
                    <span class="block text-heading">{e.title}</span>
                    <span class="sub block text-small tabular-nums">{[e.year, e.caption].filter(Boolean).join(" · ")}</span>
                  </span>
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .caption {
    color: var(--color-ink);
  }
  .caption .sub {
    color: var(--color-muted);
  }
  /* On a photo the caption sits on a dark fade, like the hero portrait. */
  .has-image .caption {
    background: linear-gradient(to top, rgb(0 0 0 / 0.88), rgb(0 0 0 / 0.55) 55%, transparent);
    color: #fff;
  }
  .has-image .caption .sub {
    color: rgb(255 255 255 / 0.8);
  }
  .card img {
    transition: scale 0.6s var(--ease-out-soft);
  }
  @media (hover: hover) {
    .card:hover img {
      scale: 1.03;
    }
  }
</style>
