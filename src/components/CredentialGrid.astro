---
// A credentials section as big photo cards (Awards, Certifications), sized like the project cards so they get the
// same weight: two per row from tablets up, one on phones. A 3:2 picture, the title, the year and a name, then an
// optional detail line. Cards without a picture yet show a labelled placeholder.
import SectionHead from "./SectionHead.astro";

export interface Credential {
  title: string;
  year: string;
  /** One short word or two after the year (e.g. "TUP Manila"). */
  caption: string;
  /** Optional one-liner under it (e.g. "GWA 1.36 · Rank 14 of 2,800+"). */
  detail?: string;
  href?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  id: string;
  title: string;
  entries: Credential[];
  /** Label shown in cards that don't have a picture yet. */
  placeholder: string;
}

const { id, title, entries, placeholder } = Astro.props;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

{
  entries.length > 0 && (
    <section id={id} class="shell section" aria-labelledby={`${id}-title`}>
      <div class="pane" data-pane={slug}>
        <SectionHead id={`${id}-title`} title={title} />
        <ul class="grid gap-y-[clamp(40px,5vw,72px)] md:grid-cols-2 md:gap-x-[clamp(24px,4vw,64px)]">
          {entries.map((e, i) => {
            const Tag = e.href ? "a" : "div";
            return (
              <li data-reveal style={`--i:${i}`}>
                <Tag
                  href={e.href || undefined}
                  target={e.href ? "_blank" : undefined}
                  rel={e.href ? "noopener noreferrer" : undefined}
                  class="card group block"
                >
                  <span class="thumb relative block aspect-[3/2] overflow-hidden rounded-[2px] bg-ph">
                    {e.image ? (
                      <img src={e.image} alt={e.imageAlt ?? ""} loading="lazy" decoding="async" class="size-full object-cover" />
                    ) : (
                      <span class="eyebrow absolute inset-0 grid place-items-center text-muted">[{placeholder}]</span>
                    )}
                  </span>
                  <span class="block pt-[18px]">
                    <span class="mb-1 block text-heading text-ink transition-colors duration-200 group-hover:text-accent">
                      {e.title}
                    </span>
                    <span class="block text-small text-muted tabular-nums">{[e.year, e.caption].filter(Boolean).join(" · ")}</span>
                    {e.detail && <span class="block text-small text-ink-soft tabular-nums">{e.detail}</span>}
                  </span>
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .thumb img {
    transition: scale 0.6s var(--ease-out-soft);
  }
  @media (hover: hover) {
    .card:hover .thumb img {
      scale: 1.03;
    }
  }
</style>
