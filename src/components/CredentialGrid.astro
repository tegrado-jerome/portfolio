---
// A credentials section as a grid of photo cards (Awards, Certifications), after Rauno Freiberg / Read.cv and
// LinkedIn's certificate grid: a 4:3 picture, the title, then one muted line of details. Cards without a
// picture yet show a labelled placeholder.
import SectionHead from "./SectionHead.astro";

export interface Credential {
  title: string;
  year: string;
  /** Detail parts under the title, joined with " · ". Empty ones are skipped. */
  lines: string[];
  href?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  id: string;
  title: string;
  entries: Credential[];
  /** Label shown in cards that don't have a picture yet. */
  placeholder: string;
}

const { id, title, entries, placeholder } = Astro.props;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

{
  entries.length > 0 && (
    <section id={id} class="shell section" aria-labelledby={`${id}-title`}>
      <div class="pane" data-pane={slug}>
        <SectionHead id={`${id}-title`} title={title} meta={`${entries.length} total`} />
        <ul class="grid grid-cols-2 gap-x-5 gap-y-8 md:grid-cols-3 lg:grid-cols-4">
          {entries.map((e, i) => {
            const Tag = e.href ? "a" : "div";
            return (
              <li data-reveal style={`--i:${i}`}>
                <Tag
                  href={e.href || undefined}
                  target={e.href ? "_blank" : undefined}
                  rel={e.href ? "noopener noreferrer" : undefined}
                  class="card group block"
                >
                  <span class="thumb relative block aspect-[4/3] overflow-hidden rounded-[2px] bg-ph">
                    {e.image ? (
                      <img src={e.image} alt={e.imageAlt ?? ""} loading="lazy" decoding="async" class="size-full object-cover" />
                    ) : (
                      <span class="absolute inset-0 grid place-items-center text-small text-muted">[{placeholder}]</span>
                    )}
                  </span>
                  <span class="mt-3 block text-body text-ink transition-colors duration-200 group-hover:text-accent">
                    {e.title}
                  </span>
                  <span class="block text-small text-muted">{[e.year, ...e.lines].filter(Boolean).join(" · ")}</span>
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .thumb img {
    transition: scale 0.6s var(--ease-out-soft);
  }
  @media (hover: hover) {
    .card:hover .thumb img {
      scale: 1.03;
    }
  }
</style>
