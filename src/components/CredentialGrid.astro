---
// A credentials section (Awards, Certifications) in the site's one card (.tile in global.css), a terminal window: the ~/path, the
// detail line, the picture, then who gave it and when. Three per row from tablets up, one on phones. Cards without a
// picture yet show a labelled placeholder. A click opens the full entry in a modal.
import { isSet } from "../data/placeholders";
import { slug as toSlug } from "../data/slug";
import Detail from "./Detail.astro";
import SectionHead from "./SectionHead.astro";

export interface Credential {
  title: string;
  year: string;
  /** One short word or two after the year (e.g. "TUP Manila"). */
  caption: string;
  /** Full name of who gave it, shown in the modal. */
  issuer: string;
  /** Extra lines for the modal (e.g. "GWA 1.36", "Credential ID: …"). */
  details?: string[];
  href?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  id: string;
  title: string;
  entries: Credential[];
  /** Label shown in cards that don't have a picture yet. */
  placeholder: string;
  /** Label for the modal's link to proof, e.g. "verify". */
  linkLabel: string;
}

const { id, title, entries, placeholder, linkLabel } = Astro.props;
const slug = toSlug(title);
---

{
  entries.length > 0 && (
    <section id={id} class="shell section" aria-labelledby={`${id}-title`}>
      <div class="pane" data-pane={slug}>
        <SectionHead id={`${id}-title`} title={title} />
        <ul class="card-grid grid md:grid-cols-3">
          {entries.map((e, i) => {
            const entrySlug = toSlug(e.title) || slug;
            return (
              <li data-reveal style={`--i:${i}`} class="flex">
                <article class="card tile relative w-full">
                  <div class="tile-top">
                    <span class="tile-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <h3 class="tile-title">
                      <button type="button" data-detail-open class="cursor-pointer text-left after:absolute after:inset-0 after:z-[1] after:content-['']">
                        <span aria-hidden="true">~/{slug}/</span><wbr /><strong>{e.title}</strong>
                      </button>
                    </h3>
                  </div>
                  <p class="tile-desc">{(e.details ?? []).find(isSet) ?? e.issuer}</p>
                  <div class="tile-media aspect-[4/3]">
                    {e.image ? (
                      <img src={e.image} alt={e.imageAlt ?? ""} loading="lazy" decoding="async" class="card-img" />
                    ) : (
                      <span class="eyebrow text-muted">[{placeholder}]</span>
                    )}
                  </div>
                  <p class="tile-meta">
                    <span class="truncate">{e.caption}</span>
                    <span>{e.year}</span>
                  </p>
                  <Detail
                    path={`${slug}/${entrySlug}`}
                    title={e.title}
                    meta={[e.year, e.issuer]}
                    image={e.image}
                    imageAlt={e.imageAlt}
                    placeholder={placeholder}
                    text={(e.details ?? []).filter(isSet)}
                    link={isSet(e.href) ? { href: e.href, label: linkLabel } : undefined}
                  />
                </article>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}
