---
// A credentials section as tall photo cards (Awards, Certifications) with the caption on the photo, like the hero
// portrait's honor line (after Apple Newsroom): three per row from tablets up, one on phones. Cards without a
// picture yet show a labelled placeholder with the caption in ink. A click opens the full entry in a modal.
import { isSet } from "../data/placeholders";
import { slug as toSlug } from "../data/slug";
import Detail from "./Detail.astro";
import SectionHead from "./SectionHead.astro";

export interface Credential {
  title: string;
  year: string;
  /** One short word or two after the year (e.g. "TUP Manila"). */
  caption: string;
  /** Full name of who gave it, shown in the modal. */
  issuer: string;
  /** Extra lines for the modal (e.g. "GWA 1.36", "Credential ID: …"). */
  details?: string[];
  href?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  id: string;
  title: string;
  entries: Credential[];
  /** Label shown in cards that don't have a picture yet. */
  placeholder: string;
  /** Label for the modal's link to proof, e.g. "verify". */
  linkLabel: string;
}

const { id, title, entries, placeholder, linkLabel } = Astro.props;
const slug = toSlug(title);
---

{
  entries.length > 0 && (
    <section id={id} class="shell section" aria-labelledby={`${id}-title`}>
      <div class="pane" data-pane={slug}>
        <SectionHead id={`${id}-title`} title={title} />
        <ul class="card-grid grid md:grid-cols-3">
          {entries.map((e, i) => {
            const entrySlug = toSlug(e.title) || slug;
            return (
              <li data-reveal style={`--i:${i}`}>
                <div class:list={["card relative block aspect-[4/5] overflow-hidden rounded-[2px] bg-ph", e.image && "has-image"]}>
                  {e.image ? (
                    <img src={e.image} alt={e.imageAlt ?? ""} loading="lazy" decoding="async" class="card-img size-full object-cover" />
                  ) : (
                    <span class="eyebrow absolute inset-0 grid place-items-center text-muted">[{placeholder}]</span>
                  )}
                  <div class="caption absolute inset-x-0 bottom-0 px-4 pt-16 pb-4">
                    <h3 class="text-heading font-normal">{e.title}</h3>
                    <p class="sub text-small tabular-nums">{[e.year, e.caption].filter(Boolean).join(" · ")}</p>
                  </div>
                  {/* The caption is positioned too, so the button covering the whole card sits here, not in the title. */}
                  <button type="button" data-detail-open aria-label={e.title} class="absolute inset-0 z-[1] cursor-pointer" />
                  <Detail
                    path={`${slug}/${entrySlug}`}
                    title={e.title}
                    meta={[e.year, e.issuer]}
                    image={e.image}
                    imageAlt={e.imageAlt}
                    placeholder={placeholder}
                    text={(e.details ?? []).filter(isSet)}
                    link={isSet(e.href) ? { href: e.href, label: linkLabel } : undefined}
                  />
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .caption {
    color: var(--color-ink);
  }
  .caption .sub {
    color: var(--color-muted);
  }
  /* On a photo the caption sits on a dark fade, like the hero portrait. */
  .has-image .caption {
    background: linear-gradient(to top, rgb(0 0 0 / 0.88), rgb(0 0 0 / 0.55) 55%, transparent);
    color: #fff;
  }
  .has-image .caption .sub {
    color: rgb(255 255 255 / 0.8);
  }
</style>
