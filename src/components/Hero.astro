---
import { assistant } from "../data/assistant";
import { site } from "../data/site";
import Timeline from "./Timeline.astro";
---

<!-- Text on the left, portrait on the right, top-aligned: the reference's layout (adikrz.netlify.app). -->
<section id="top" class="shell pt-[clamp(48px,8vw,110px)]" aria-labelledby="hero-title">
  <div class="grid items-start gap-[clamp(32px,6vw,90px)] md:grid-cols-[minmax(0,1fr)_clamp(200px,18vw,260px)]">
    <div class="max-w-[640px]">
      <p data-reveal class="eyebrow mb-[clamp(14px,2vw,22px)] text-muted">{site.headline}</p>
      <h1
        id="hero-title"
        data-reveal
        class="hero-title mb-[clamp(18px,2.5vw,28px)] font-serif text-display font-normal"
      >
        {
          site.name.split(" ").map((word, i) => (
            <>
              <span class="hero-word" style={`--w:${i}`}>
                <span>{word}</span>
              </span>{" "}
            </>
          ))
        }
      </h1>
      <p data-reveal style="--i:1" class="max-w-[52ch] text-body text-ink-soft">{site.intro}</p>

      <!-- Ask-my-AI bar as a terminal line (after Warp / v0): a mono prompt with a blinking block cursor.
           It sends the question straight into the chat. Needs JS, so it stays hidden without it. -->
      <div data-reveal style="--i:2" class="mt-[clamp(20px,3vw,32px)] hidden max-w-[460px] in-[.js]:block">
        <form data-hero-ask class="ask term flex items-center gap-2 rounded-[4px] border border-line py-1.5 pr-1.5 pl-4 font-mono text-[16px]">
          <span class="inline-flex shrink-0 gap-[1ch] whitespace-nowrap" aria-hidden="true">
            <span class="text-accent max-[380px]:hidden">jerome@ai</span>
            <span class="text-muted max-[380px]:hidden">~</span>
            <span class="text-ink">ask</span>
          </span>
          <span class="relative flex min-w-0 flex-1 items-center">
            <label for="hero-ask" class="sr-only">Ask my AI about my work</label>
            <!-- w-0 lets the field shrink on narrow phones instead of pushing the bar off screen.
                 The blank placeholder lets CSS know when the field is empty, to show the idle cursor. -->
            <input
              id="hero-ask"
              type="text"
              maxlength="800"
              autocomplete="off"
              spellcheck="false"
              placeholder=" "
              class="w-0 min-w-0 flex-1 bg-transparent py-1.5 text-ink caret-accent focus:outline-none"
            />
            <span class="idle-caret" aria-hidden="true"></span>
          </span>
          <button
            type="submit"
            aria-label="Ask"
            disabled
            class="send grid h-9 shrink-0 place-items-center px-1 transition-opacity duration-200 disabled:opacity-35"
          >
            <kbd class="key">↵</kbd>
          </button>
        </form>
        <p class="mt-2.5 font-mono text-small text-muted">
          try:
          {
            assistant.suggestions.slice(0, 1).map((q) => (
              <button type="button" data-hero-ask-chip class="try link-strong ml-1 lowercase">
                {q}
              </button>
            ))
          }
        </p>
      </div>

    </div>

    <!-- Crop marks frame the photo and spread out on hover. -->
    <div data-reveal style="--i:2" class="portrait group relative w-full max-md:mx-auto max-md:max-w-[220px]">
      <span class="mark top-0 left-0 border-t border-l" aria-hidden="true"></span>
      <span class="mark top-0 right-0 border-t border-r" aria-hidden="true"></span>
      <span class="mark bottom-0 left-0 border-b border-l" aria-hidden="true"></span>
      <span class="mark right-0 bottom-0 border-r border-b" aria-hidden="true"></span>
      <figure id="portrait" class="relative m-0 aspect-[4/5] overflow-hidden rounded-[2px] bg-ph">
        {
          site.portrait ? (
            <img
              src={site.portrait}
              alt={`Portrait of ${site.name}`}
              width="960"
              height="1200"
              class="size-full object-cover"
            />
          ) : (
            <span class="eyebrow absolute inset-0 grid place-items-center text-muted">[PORTRAIT]</span>
          )
        }
        {
          site.honor && (
            <figcaption class="absolute inset-x-0 bottom-0 z-[2] flex items-center gap-3 bg-linear-to-t from-black/90 via-black/60 to-transparent px-3 pt-12 pb-3 text-white">
              <img
                src={site.honor.logo}
                alt={site.honor.school}
                width="40"
                height="40"
                class="size-7 shrink-0"
              />
              <span>
                <span class="block font-serif text-body leading-tight">{site.honor.title}</span>
                <span class="eyebrow block text-white/80">{site.honor.detail}</span>
              </span>
            </figcaption>
          )
        }
      </figure>
    </div>
  </div>
  <Timeline />
</section>

<style>
  .hero-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    /* room for tall capitals and descenders inside the mask */
    padding-block: 0.12em;
    margin-block: -0.12em;
  }
  .hero-word > span {
    display: inline-block;
  }
  :global(.js) .hero-title[data-reveal] {
    opacity: 1;
    transform: none;
  }
  :global(.js) .hero-title .hero-word > span {
    transform: translateY(105%);
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--w) * 90ms);
  }
  :global(.js) .hero-title:global(.is-visible) .hero-word > span {
    transform: none;
  }
  .mark {
    position: absolute;
    z-index: 4;
    width: 14px;
    height: 14px;
    border-color: var(--color-ink);
    translate: var(--x) var(--y);
    transition: translate 0.6s cubic-bezier(0.19, 1, 0.22, 1);
    pointer-events: none;
  }
  .mark.left-0 {
    --x: -7px;
  }
  .mark.right-0 {
    --x: 7px;
  }
  .mark.top-0 {
    --y: -7px;
  }
  .mark.bottom-0 {
    --y: 7px;
  }
  .portrait:hover .mark {
    translate: calc(var(--x) * 2) calc(var(--y) * 2);
  }
  /* The crop marks breathe in and out while hovered, and on their own on touch screens. */
  @media (prefers-reduced-motion: no-preference) {
    .portrait:hover .mark {
      translate: var(--x) var(--y);
      animation: mark-breathe 1.2s ease-in-out infinite alternate;
    }
  }
  @media (hover: none) and (prefers-reduced-motion: no-preference) {
    .mark {
      animation: mark-breathe 2.4s ease-in-out infinite alternate;
    }
  }
  @keyframes mark-breathe {
    to {
      translate: calc(var(--x) * 2) calc(var(--y) * 2);
    }
  }
  /* Same surface as the chat's composer. Idle: light border. Hover: darker. Active (focused): ink border and a soft ring. */
  .ask {
    background: color-mix(in srgb, var(--color-paper) 45%, white);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .ask:hover {
    border-color: var(--color-muted);
  }
  .ask:focus-within {
    border-color: var(--color-ink);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-ink) 8%, transparent);
  }
  /* The ring replaces the default focus outline on the field itself. */
  .ask input:focus-visible {
    outline: none;
  }
  /* A blinking block cursor while the field is empty and not focused; typing shows the real caret. */
  .idle-caret {
    display: none;
    position: absolute;
    left: 0;
    width: 0.6em;
    height: 1.15em;
    background: var(--color-ink);
    pointer-events: none;
  }
  .term:not(:focus-within) input:placeholder-shown + .idle-caret {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .idle-caret {
      animation: blink 1.1s steps(1) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .send .key {
    display: inline-grid;
    place-items: center;
    min-width: 26px;
    height: 24px;
    padding-inline: 6px;
    border: 1px solid var(--color-line);
    border-radius: 5px;
    background: var(--color-paper);
    box-shadow: 0 1px 0 var(--color-line);
    color: var(--color-ink);
    font: 500 var(--text-label) / 1 var(--font-mono);
    transition: border-color 0.2s ease;
  }
  .send:not(:disabled):hover .key {
    border-color: var(--color-ink);
  }
  /* The quick question reads as a "try" hint with a dotted underline. */
  .try {
    border-bottom: 1px dotted var(--color-muted);
  }
  :global([data-theme="dark"]) .ask {
    background: color-mix(in srgb, var(--color-paper) 90%, white);
  }
</style>

<script>
  import { asciiLens } from "../scripts/ascii-lens";

  const portrait = document.getElementById("portrait");
  const img = portrait?.querySelector("img");
  const init = () => {
    if (portrait && img) asciiLens(portrait, { cell: 8, radius: 66, alpha: 0.55, image: img, className: "z-[3]", autoplay: true });
  };
  // Wait for the preloader so the drifting dots on touch screens start at the bottom when the photo is first seen.
  if (document.documentElement.classList.contains("is-preloading")) {
    document.addEventListener("preloader:done", init, { once: true });
  } else {
    init();
  }

  // The ask bar and its quick questions hand the question to the chat (see Chat.astro "chat:ask").
  const askForm = document.querySelector<HTMLFormElement>("[data-hero-ask]");
  const askInput = askForm?.querySelector("input");
  const askButton = askForm?.querySelector("button");
  const askChat = (question: string) => {
    if (question.trim()) document.dispatchEvent(new CustomEvent("chat:ask", { detail: question }));
  };
  // The send button only becomes active once there's something to send.
  const syncAskButton = () => (askButton!.disabled = askInput!.value.trim() === "");
  askInput?.addEventListener("input", syncAskButton);
  askForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    askChat(askInput!.value);
    askInput!.value = "";
    syncAskButton();
  });
  document.querySelectorAll<HTMLButtonElement>("[data-hero-ask-chip]").forEach((chip) =>
    chip.addEventListener("click", () => askChat(chip.textContent ?? "")),
  );
</script>
