---
import { faArrowRight, faFileLines } from "@fortawesome/free-solid-svg-icons";
import { site, socials } from "../data/site";
import { isSet } from "../data/placeholders";
import Icon from "./Icon.astro";
import Timeline from "./Timeline.astro";

// Placeholder links point nowhere ("#") until the real URLs are filled in.
const linkedin = socials.find((s) => s.label === "LinkedIn");
const heroLinks = [
  ...(linkedin ? [{ label: "LinkedIn", href: isSet(linkedin.href) ? linkedin.href : "#", icon: linkedin.icon }] : []),
  { label: "Resume", href: isSet(site.resume) ? site.resume : "#", icon: faFileLines },
];
---

<!-- Text on the left, portrait on the right, top-aligned: the reference's layout (adikrz.netlify.app). -->
<section id="top" class="shell pt-[clamp(48px,8vw,110px)]" aria-labelledby="hero-title">
  <div class="grid items-start gap-[clamp(32px,6vw,90px)] md:grid-cols-[minmax(0,1fr)_clamp(200px,18vw,260px)]">
    <div class="max-w-[640px]">
      <p data-reveal class="eyebrow mb-[clamp(14px,2vw,22px)] text-[11px] text-muted">{site.headline}</p>
      <h1
        id="hero-title"
        data-reveal
        class="hero-title mb-[clamp(18px,2.5vw,28px)] font-serif text-[clamp(52px,7.5vw,104px)] leading-[0.9] font-normal tracking-[-0.02em]"
      >
        {
          site.name.split(" ").map((word, i) => (
            <>
              <span class="hero-word" style={`--w:${i}`}>
                <span>{word}</span>
              </span>{" "}
            </>
          ))
        }
      </h1>
      <p data-reveal style="--i:1" class="max-w-[52ch] text-[15px] leading-[1.75] text-ink-soft">{site.intro}</p>
      <ul data-reveal style="--i:2" class="mt-[clamp(20px,3vw,32px)] flex flex-wrap gap-x-7 gap-y-3">
        {
          heroLinks.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer" class="group eyebrow inline-flex items-center gap-2 text-[11px] text-ink">
                {l.icon && <Icon icon={l.icon} class="text-[14px] text-accent" />}
                <span class="brush">{l.label}</span>
                <Icon
                  icon={faArrowRight}
                  class="-rotate-45 text-[11px] text-muted transition-transform duration-300 ease-out-soft group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Crop marks frame the photo and spread out on hover. -->
    <div data-reveal style="--i:2" class="portrait group relative w-full max-md:mx-auto max-md:max-w-[220px]">
      <span class="mark top-0 left-0 border-t border-l" aria-hidden="true"></span>
      <span class="mark top-0 right-0 border-t border-r" aria-hidden="true"></span>
      <span class="mark bottom-0 left-0 border-b border-l" aria-hidden="true"></span>
      <span class="mark right-0 bottom-0 border-r border-b" aria-hidden="true"></span>
      <figure id="portrait" class="relative m-0 aspect-[4/5] overflow-hidden rounded-[2px] bg-ph">
        {
          site.portrait ? (
            <img
              src={site.portrait}
              alt={`Portrait of ${site.name}`}
              width="960"
              height="1200"
              class="size-full object-cover"
            />
          ) : (
            <span class="eyebrow absolute inset-0 grid place-items-center text-[11px] text-muted">[PORTRAIT]</span>
          )
        }
        {
          site.honor && (
            <figcaption class="absolute inset-x-0 bottom-0 z-[2] flex items-center gap-3 bg-linear-to-t from-black/90 via-black/60 to-transparent px-3 pt-12 pb-3 text-white">
              <img
                src={site.honor.logo}
                alt={site.honor.school}
                width="40"
                height="40"
                class="size-7 shrink-0"
              />
              <span>
                <span class="block font-serif text-[15px] leading-tight italic">{site.honor.title}</span>
                <span class="eyebrow block text-[9px] text-white/80">{site.honor.detail}</span>
              </span>
            </figcaption>
          )
        }
      </figure>
    </div>
  </div>
  <Timeline />
</section>

<style>
  .hero-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    /* room for tall capitals and descenders inside the mask */
    padding-block: 0.12em;
    margin-block: -0.12em;
  }
  .hero-word > span {
    display: inline-block;
  }
  :global(.js) .hero-title[data-reveal] {
    opacity: 1;
    transform: none;
  }
  :global(.js) .hero-title .hero-word > span {
    transform: translateY(105%);
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--w) * 90ms);
  }
  :global(.js) .hero-title:global(.is-visible) .hero-word > span {
    transform: none;
  }
  .mark {
    position: absolute;
    z-index: 4;
    width: 14px;
    height: 14px;
    border-color: var(--color-ink);
    translate: var(--x) var(--y);
    transition: translate 0.6s cubic-bezier(0.19, 1, 0.22, 1);
    pointer-events: none;
  }
  .mark.left-0 {
    --x: -7px;
  }
  .mark.right-0 {
    --x: 7px;
  }
  .mark.top-0 {
    --y: -7px;
  }
  .mark.bottom-0 {
    --y: 7px;
  }
  .portrait:hover .mark {
    translate: calc(var(--x) * 2) calc(var(--y) * 2);
  }
  /* The crop marks breathe in and out while hovered, and on their own on touch screens. */
  @media (prefers-reduced-motion: no-preference) {
    .portrait:hover .mark {
      translate: var(--x) var(--y);
      animation: mark-breathe 1.2s ease-in-out infinite alternate;
    }
  }
  @media (hover: none) and (prefers-reduced-motion: no-preference) {
    .mark {
      animation: mark-breathe 2.4s ease-in-out infinite alternate;
    }
  }
  @keyframes mark-breathe {
    to {
      translate: calc(var(--x) * 2) calc(var(--y) * 2);
    }
  }
</style>

<script>
  import { asciiLens } from "../scripts/ascii-lens";

  const portrait = document.getElementById("portrait");
  const img = portrait?.querySelector("img");
  const init = () => {
    if (portrait && img) asciiLens(portrait, { cell: 8, radius: 66, alpha: 0.55, image: img, className: "z-[3]", autoplay: true });
  };
  // Wait for the preloader so the drifting dots on touch screens start at the bottom when the photo is first seen.
  if (document.documentElement.classList.contains("is-preloading")) {
    document.addEventListener("preloader:done", init, { once: true });
  } else {
    init();
  }
</script>
