---
import { site } from "../data/site";
---

<!-- Centered name and intro, with the portrait as a wide band below (after pacomepertant.com). -->
<section id="top" class="shell pt-[clamp(48px,8vw,110px)] text-center" aria-labelledby="hero-title">
  <p data-reveal class="eyebrow mb-[clamp(14px,2vw,22px)] text-[11px] text-muted">{site.headline}</p>
  <h1
    id="hero-title"
    data-reveal
    class="hero-title mb-[clamp(18px,2.5vw,28px)] font-serif text-[clamp(52px,8.5vw,128px)] leading-[0.9] font-normal tracking-[-0.02em]"
  >
    {
      site.name.split(" ").map((word, i) => (
        <>
          <span class="hero-word" style={`--w:${i}`}>
            <span>{word}</span>
          </span>{" "}
        </>
      ))
    }
  </h1>
  <p data-reveal style="--i:1" class="mx-auto max-w-[52ch] text-[15px] leading-[1.75] text-ink-soft">{site.intro}</p>

  <figure
    id="portrait"
    data-reveal
    style="--i:2"
    class="group relative mx-auto mt-[clamp(32px,5vw,64px)] mb-0 aspect-[4/3] w-full max-w-[760px] overflow-hidden rounded-[2px] bg-ph sm:aspect-[16/8]"
  >
    {
      site.portrait ? (
        <img
          src={site.portrait}
          alt={`Portrait of ${site.name}`}
          width="1600"
          height="700"
          class="size-full object-cover object-[center_25%] grayscale transition-[filter] duration-[450ms] ease-[ease] group-hover:grayscale-0"
        />
      ) : (
        <figcaption class="eyebrow absolute inset-0 grid place-items-center text-[11px] text-muted">[PORTRAIT]</figcaption>
      )
    }
  </figure>
</section>

<style>
  .hero-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    /* room for tall capitals and descenders inside the mask */
    padding-block: 0.12em;
    margin-block: -0.12em;
  }
  .hero-word > span {
    display: inline-block;
  }
  :global(.js) .hero-title[data-reveal] {
    opacity: 1;
    transform: none;
  }
  :global(.js) .hero-title .hero-word > span {
    transform: translateY(105%);
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--w) * 90ms);
  }
  :global(.js) .hero-title:global(.is-visible) .hero-word > span {
    transform: none;
  }
</style>

<script>
  import { asciiLens } from "../scripts/ascii-lens";

  const portrait = document.getElementById("portrait");
  const img = portrait?.querySelector("img");
  if (portrait && img) asciiLens(portrait, { cell: 8, radius: 66, alpha: 0.55, image: img, className: "z-[3]" });
</script>
