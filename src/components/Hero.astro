---
import { faArrowTurnDown } from "@fortawesome/free-solid-svg-icons";
import { assistant } from "../data/assistant";
import { contactHref, site } from "../data/site";
import { isSet } from "../data/placeholders";
import Icon from "./Icon.astro";
---

<!-- Text on the left, portrait on the right, top-aligned: the reference's layout (adikrz.netlify.app).
     On phones the portrait comes first, so visitors see who this is before the name. -->
<!-- Fills the first screen below the header, so nothing else shows until you scroll. -->
<section id="top" class="hero relative shell flex min-h-[calc(100svh-65px)] flex-col justify-center py-[clamp(32px,5vw,72px)] sm:min-h-[calc(100svh-73px)]" aria-labelledby="hero-title">
  <!-- A faint dot grid behind the hero that lights up around the mouse (after brittanychiang.com's spotlight).
       The glow is mouse only; the faint grid shows everywhere. -->
  <div class="dots dots-base" aria-hidden="true"></div>
  <div class="dots dots-lit" aria-hidden="true"><div class="dots dots-core"></div></div>
  <!-- The status bar names this pane "jerome-tegrado". -->
  <div data-pane="jerome-tegrado" class="relative">
  <div class="grid items-start gap-[clamp(32px,6vw,90px)] md:grid-cols-[minmax(0,1fr)_clamp(200px,18vw,260px)]">
    <!-- One column (phones and small tablets): everything centred on the portrait's axis. -->
    <div class="max-w-[640px] max-md:mx-auto max-md:text-center">
      <!-- Name, then intro, then the main action. The headline isn't shown; it's the page title's role for search. -->
      <h1
        id="hero-title"
        data-reveal
       
        class="hero-title mb-[clamp(18px,2.5vw,28px)] text-display max-sm:text-[clamp(26px,9vw,50px)] max-sm:whitespace-nowrap font-medium tracking-[-0.045em] max-sm:tracking-[-0.02em]"
      >
        {
          site.name.split(" ").map((word, i) => (
            <>
              <span class="hero-word" style={`--w:${i}`}>
                <span>{word}</span>
              </span>{" "}
            </>
          ))
        }
      </h1>
      <!-- One line on phones: no wrapping, and the size follows the screen width so it always fits. -->
      <p data-reveal style="--i:1" class="max-w-[52ch] max-md:mx-auto text-body text-ink-soft max-sm:text-[clamp(11px,3.6vw,15px)] max-sm:whitespace-nowrap">
        {site.intro}
      </p>

      <!-- Ask-my-AI bar as a terminal line (after Warp / v0): a mono prompt with a blinking block cursor.
           It sends the question straight into the chat. Needs JS, so it stays hidden without it. -->
      <div data-reveal style="--i:2" class="mt-[clamp(20px,3vw,32px)] hidden max-w-[460px] max-md:mx-auto in-[.js]:block">
        <!-- The data-* values feed the prompt's shell commands (whoami, cat resume, sudo hire jerome). -->
        <form
          data-hero-ask
          data-headline={site.headline}
          data-contact={contactHref}
          data-resume={isSet(site.resume) ? site.resume : ""}
          class="ask term flex text-left items-center gap-2 rounded-[4px] border border-line py-1.5 pr-1.5 pl-4 font-mono text-[16px]">
          <span class="inline-flex shrink-0 gap-[1ch] whitespace-nowrap" aria-hidden="true">
            <span class="text-accent">jerome@ai</span>
            <span class="text-muted">~</span>
          </span>
          <span class="relative flex min-w-0 flex-1 items-center">
            <label for="hero-ask" class="sr-only">Ask my AI about my work</label>
            <!-- w-0 lets the field shrink on narrow phones instead of pushing the bar off screen.
                 The blank placeholder lets CSS know when the field is empty; while it is (and not focused),
                 "type here!" types itself out over it with a blinking cursor. -->
            <input
              id="hero-ask"
              type="text"
              maxlength="800"
              autocomplete="off"
              spellcheck="false"
              placeholder=" "
              class="w-0 min-w-0 flex-1 bg-transparent py-1.5 text-ink caret-accent focus:outline-none"
            />
            <span class="guide" aria-hidden="true"><span data-guide-text></span><span class="guide-caret"></span></span>
          </span>
          <button
            type="submit"
            aria-label="Ask"
            disabled
            class="send grid h-9 shrink-0 place-items-center px-1 transition-opacity duration-200 disabled:opacity-35"
          >
            <kbd class="key"><Icon icon={faArrowTurnDown} class="rotate-90 text-[12px]" /></kbd>
          </button>
        </form>
        <!-- Output of the prompt's few shell commands (help, ls, cd…); it takes the "try" hint's place. -->
        <p data-hero-out hidden aria-live="polite" class="out mt-2.5 font-mono text-small text-muted"></p>
        <p data-hero-try class="mt-2.5 font-mono text-small text-muted">
          try:
          {
            assistant.suggestions.slice(0, 1).map((q) => (
              <button type="button" data-hero-ask-chip class="try link-strong ml-1 lowercase">
                {q}
              </button>
            ))
          }
          <span class="max-sm:hidden"> · or <button type="button" data-hero-cmd class="try link-strong">help</button></span>
        </p>
      </div>

    </div>

    <!-- Crop marks frame the photo and spread out on hover. -->
    <div data-reveal style="--i:2" class="portrait group relative w-full max-md:order-first max-md:mx-auto max-md:max-w-[220px]">
      <span class="mark top-0 left-0 border-t border-l" aria-hidden="true"></span>
      <span class="mark top-0 right-0 border-t border-r" aria-hidden="true"></span>
      <span class="mark bottom-0 left-0 border-b border-l" aria-hidden="true"></span>
      <span class="mark right-0 bottom-0 border-r border-b" aria-hidden="true"></span>
      <figure id="portrait" class="relative m-0 aspect-[4/5] overflow-hidden rounded-[2px] bg-ph">
        {
          site.portrait ? (
            <img
              src={site.portrait}
              alt={`Portrait of ${site.name}`}
              width="640"
              height="800"
              class="size-full object-cover"
            />
          ) : (
            <span class="eyebrow absolute inset-0 grid place-items-center text-muted">[PORTRAIT]</span>
          )
        }
        {
          site.honor && (
            <figcaption class="absolute inset-x-0 bottom-0 z-[2] flex items-center gap-3 bg-linear-to-t from-black/90 via-black/60 to-transparent px-3 pt-12 pb-3 text-white">
              <img
                src={site.honor.logo}
                alt={site.honor.school}
                width="40"
                height="40"
                class="size-7 shrink-0"
              />
              <span>
                <span class="block text-body leading-tight">{site.honor.title}</span>
                {/* Each "·" part stays whole; on narrow photos they stack instead of breaking mid-phrase. */}
                <span class="eyebrow block text-white/80">
                  {site.honor.detail.split(" · ").map((part, i) => (
                    <span class="whitespace-nowrap max-md:block">
                      {i > 0 && <span class="max-md:hidden"> · </span>}
                      {part}
                    </span>
                  ))}
                </span>
              </span>
            </figcaption>
          )
        }
      </figure>
    </div>
  </div>
  </div>
</section>

<style>
  /* A mono space is a full character wide; with the tight letter tracking it reads as a gap, so pull the words closer. */
  .hero-title {
    word-spacing: -0.3em;
  }
  /* Smaller on phones, so the letters and words need less pulling in to read naturally. */
  @media (max-width: 639px) {
    .hero-title {
      word-spacing: -0.2em;
    }
  }
  .hero-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    /* room for tall capitals and descenders inside the mask */
    padding-block: 0.12em;
    margin-block: -0.12em;
  }
  .hero-word > span {
    display: inline-block;
  }
  :global(.js) .hero-title[data-reveal] {
    opacity: 1;
    transform: none;
  }
  :global(.js) .hero-title .hero-word > span {
    transform: translateY(105%);
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--w) * 90ms);
  }
  :global(.js) .hero-title:global(.is-visible) .hero-word > span {
    transform: none;
  }
  .mark {
    position: absolute;
    z-index: 4;
    width: 14px;
    height: 14px;
    border-color: var(--color-ink);
    translate: var(--x) var(--y);
    transition: translate 0.6s cubic-bezier(0.19, 1, 0.22, 1);
    pointer-events: none;
  }
  .mark.left-0 {
    --x: -7px;
  }
  .mark.right-0 {
    --x: 7px;
  }
  .mark.top-0 {
    --y: -7px;
  }
  .mark.bottom-0 {
    --y: 7px;
  }
  .portrait:hover .mark {
    translate: calc(var(--x) * 2) calc(var(--y) * 2);
  }
  /* The crop marks breathe in and out while hovered, and on their own on touch screens. */
  @media (prefers-reduced-motion: no-preference) {
    .portrait:hover .mark {
      translate: var(--x) var(--y);
      animation: mark-breathe 1.2s ease-in-out infinite alternate;
    }
  }
  @media (hover: none) and (prefers-reduced-motion: no-preference) {
    .mark {
      animation: mark-breathe 2.4s ease-in-out infinite alternate;
    }
  }
  @keyframes mark-breathe {
    to {
      translate: calc(var(--x) * 2) calc(var(--y) * 2);
    }
  }
  /* Same surface as the chat's composer. Idle: light border. Hover: darker. Active (focused): ink border and a soft ring. */
  .ask {
    background: color-mix(in srgb, var(--color-paper) 45%, white);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .ask:hover {
    border-color: var(--color-muted);
  }
  .ask:focus-within {
    border-color: var(--color-ink);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-ink) 8%, transparent);
  }
  /* The ring replaces the default focus outline on the field itself. */
  .ask input:focus-visible {
    outline: none;
  }
  /* Never wider than the field, so it can't run under the send key. */
  .guide {
    display: none;
    position: absolute;
    left: 0;
    max-width: 100%;
    overflow: hidden;
    align-items: center;
    color: var(--color-muted);
    white-space: pre;
    pointer-events: none;
  }
  .term:not(:focus-within) input:placeholder-shown + .guide {
    display: inline-flex;
  }
  .guide-caret {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    margin-left: 1px;
    background: var(--color-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .guide-caret {
      animation: guide-blink 1.1s steps(1) infinite;
    }
  }
  @keyframes guide-blink {
    50% {
      opacity: 0;
    }
  }
  .send .key {
    display: inline-grid;
    place-items: center;
    min-width: 30px;
    height: 26px;
    padding-inline: 6px;
    border: 1px solid var(--color-line);
    border-radius: 5px;
    background: var(--color-paper);
    box-shadow: 0 1px 0 var(--color-line);
    color: var(--color-ink);
    font: 500 var(--text-label) / 1 var(--font-mono);
    transition: border-color 0.2s ease;
  }
  .send:not(:disabled):hover .key {
    border-color: var(--color-ink);
  }
  .dots {
    position: absolute;
    inset-block: 0;
    left: calc(50% - 50vw);
    width: 100vw;
    pointer-events: none;
    --dot: color-mix(in srgb, var(--color-ink) 16%, transparent);
    background: radial-gradient(circle, var(--dot) 1.2px, transparent 1.6px) 0 0 / 24px 24px;
  }
  /* Fades out toward the edges, so the grid sits behind the name and portrait instead of filling the screen. */
  .dots-base {
    mask: radial-gradient(ellipse 75% 70% at 50% 50%, #000 20%, transparent 80%);
  }
  /* Around the mouse: darker dots, and accent-blue ones right at the centre. */
  .dots-lit {
    --dot: color-mix(in srgb, var(--color-ink) 65%, transparent);
    mask: radial-gradient(300px circle at var(--mx, 50%) var(--my, 50%), #000, rgb(0 0 0 / 0.4) 45%, transparent 80%);
    opacity: 0;
    transition: opacity 0.8s var(--ease-out-soft);
  }
  .dots-core {
    left: 0;
    --dot: var(--color-accent);
    mask: radial-gradient(120px circle at var(--mx, 50%) var(--my, 50%), #000, transparent);
  }
  .dots-lit.is-lit {
    opacity: 1;
  }
  .out :global(button),
  .out :global(a) {
    color: var(--color-ink);
    transition: color 0.2s ease;
  }
  .out :global(button:hover),
  .out :global(a:hover) {
    color: var(--color-accent);
  }
  /* The quick question reads as a "try" hint with a dotted underline. */
  .try {
    border-bottom: 1px dotted var(--color-muted);
  }
  :global([data-theme="dark"]) .ask {
    background: color-mix(in srgb, var(--color-paper) 90%, white);
  }
</style>

<script>
  import { asciiLens } from "../scripts/ascii-lens";
  import { pointTo } from "../scripts/point";
  import { play } from "../scripts/sound";

  const portrait = document.getElementById("portrait");
  const img = portrait?.querySelector("img");
  const init = () => {
    if (portrait && img) asciiLens(portrait, { cell: 8, radius: 66, alpha: 0.55, image: img, className: "z-[3]", autoplay: true });
  };
  // Wait for the preloader so the drifting dots on touch screens start at the bottom when the photo is first seen.
  if (document.documentElement.classList.contains("is-preloading")) {
    document.addEventListener("preloader:done", init, { once: true });
  } else {
    init();
  }

  // The ask bar and its quick questions hand the question to the chat (see Chat.astro "chat:ask").
  const askForm = document.querySelector<HTMLFormElement>("[data-hero-ask]");
  const askInput = askForm?.querySelector("input");
  const askButton = askForm?.querySelector("button");
  const askChat = (question: string) => {
    if (question.trim()) document.dispatchEvent(new CustomEvent("chat:ask", { detail: question }));
  };
  // Guide text: types each line, holds, erases, and moves on to the next, hinting at the shell commands too.
  // Narrow phones get the short version of a line when the long one wouldn't fit the field (plus the caret).
  // Reduced motion shows the first line still.
  const guide = document.querySelector<HTMLElement>("[data-guide-text]");
  if (guide) {
    const field = document.getElementById("hero-ask")!;
    const lines = [
      ["type here!", "type here!"],
      ["ask me anything", "ask me!"],
      ["or type help", "try help"],
    ];
    const chWidth = () => parseFloat(getComputedStyle(field).fontSize) * 0.6; // Geist Mono's advance width
    const pick = ([long, short]: string[]) => ((long.length + 1) * chWidth() <= field.clientWidth ? long : short);
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      guide.textContent = lines[0][0];
    } else {
      let line = 0;
      let text = pick(lines[0]);
      let i = 0;
      let deleting = false;
      const step = () => {
        i += deleting ? -1 : 1;
        guide.textContent = text.slice(0, i);
        let delay = deleting ? 55 : 115;
        if (!deleting && i === text.length) {
          deleting = true;
          delay = 2200;
        } else if (deleting && i === 0) {
          deleting = false;
          text = pick(lines[++line % lines.length]);
          delay = 700;
        }
        setTimeout(step, delay);
      };
      setTimeout(step, 600);
    }
  }

  // A few shell commands work in the prompt, as a small easter egg for the terminal look. Anything else goes to the chat.
  const out = document.querySelector<HTMLElement>("[data-hero-out]")!;
  const tryLine = document.querySelector<HTMLElement>("[data-hero-try]")!;
  const { headline = "", contact = "", resume = "" } = askForm?.dataset ?? {};
  const sections = [...document.querySelectorAll<HTMLElement>("main section[id], footer[id]")]
    .map((el) => el.id)
    .filter((id) => id !== "top");

  const cmd = (label: string, line = label) => {
    const b = Object.assign(document.createElement("button"), { type: "button", textContent: label });
    b.addEventListener("click", () => run(line));
    return b;
  };
  const link = (label: string, href: string) =>
    Object.assign(document.createElement("a"), { href, textContent: label, target: "_blank", rel: "noopener noreferrer" });
  const join = (nodes: Node[], gap: string) => nodes.flatMap((n, i) => (i ? [gap, n] : [n]));

  function print(...parts: (string | Node)[]) {
    out.replaceChildren(...parts);
    out.hidden = parts.length === 0;
    tryLine.hidden = !out.hidden;
  }

  // Returns false when the line isn't a command, so it's sent to the chat instead.
  function run(line: string) {
    const input = line.trim().toLowerCase().replace(/\s+/g, " ");
    const [name, ...args] = input.split(" ");
    const arg = args.join(" ").replace(/^(~\/|\.\/)/, "").replace(/\/$/, "");
    switch (name) {
      case "help":
        print(...join(["ls", "cd projects", "whoami", "cat resume", "sudo hire jerome"].map((c) => cmd(c)), " · "));
        return true;
      case "ls":
        print(...join(sections.map((id) => cmd(`${id}/`, `cd ${id}`)), "  "));
        return true;
      case "cd":
        if (!arg || arg === "~" || arg === "..") pointTo("top");
        else if (!sections.includes(arg) || !pointTo(arg)) {
          print(`cd: no such section: ${arg}. try `, cmd("ls"));
          return true;
        }
        print();
        return true;
      case "pwd":
        print("~/jerome-tegrado");
        return true;
      case "whoami":
        print(headline.toLowerCase());
        return true;
      case "cat":
        if (!arg.startsWith("resume")) return false;
        print(...(resume ? ["resume.pdf: ", link("open", resume)] : ["resume.pdf is still compiling. my inbox isn't: ", link("let's talk", contact)]));
        return true;
      case "sudo":
        print(...(arg === "hire jerome" ? ["access granted. ", link("[ let's talk ]", contact)] : ["nice try. this incident will be reported."]));
        return true;
      case "clear":
        print();
        return true;
    }
    return false;
  }

  // The dot grid follows the mouse, at most once per frame.
  const hero = document.querySelector<HTMLElement>(".hero");
  const dots = hero?.querySelector<HTMLElement>(".dots-lit");
  if (hero && dots && matchMedia("(hover: hover) and (pointer: fine)").matches) {
    let queued = false;
    let x = 0;
    let y = 0;
    hero.addEventListener("pointermove", (e) => {
      x = e.clientX;
      y = e.clientY;
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        const r = dots.getBoundingClientRect();
        dots.style.setProperty("--mx", `${x - r.left}px`);
        dots.style.setProperty("--my", `${y - r.top}px`);
        dots.classList.add("is-lit");
      });
    });
    hero.addEventListener("pointerleave", () => dots.classList.remove("is-lit"));
  }

  // The send button only becomes active once there's something to send.
  const syncAskButton = () => (askButton!.disabled = askInput!.value.trim() === "");
  askInput?.addEventListener("input", syncAskButton);
  askInput?.addEventListener("keydown", (e) => {
    if (e.key.length === 1 || e.key === "Backspace") play("key");
  });
  askForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!askInput!.value.trim()) return;
    play("send");
    if (!run(askInput!.value)) askChat(askInput!.value);
    askInput!.value = "";
    syncAskButton();
  });
  document.querySelector("[data-hero-cmd]")?.addEventListener("click", () => run("help"));
  document.querySelectorAll<HTMLButtonElement>("[data-hero-ask-chip]").forEach((chip) =>
    chip.addEventListener("click", () => askChat(chip.textContent ?? "")),
  );
</script>
