---
// Awards printed as a terminal log (matching the hero prompt bar and the ~/ section paths):
// a command line, one ✓ line per award, then an idle prompt with a blinking cursor.
import { awards } from "../data/awards";
import SectionHead from "./SectionHead.astro";
---

{
  awards.length > 0 && (
    <section id="awards" class="shell section" aria-labelledby="awards-title">
      <div class="pane" data-pane="awards">
      <SectionHead id="awards-title" title="Awards" meta={`${awards.length} total`} />
      <div class="log font-mono text-small leading-[1.9] sm:text-body">
        <p data-reveal aria-hidden="true">
          <span class="text-accent">jerome@ai</span> <span class="text-muted">~</span> <span class="text-ink">awards --list</span>
        </p>
        <ul>
          {awards.map((a, i) => (
            <li data-reveal style={`--i:${i + 1}`} class="line grid grid-cols-[auto_auto_minmax(0,1fr)] gap-x-[1.2ch]">
              <span class="text-online" aria-hidden="true">✓</span>
              <span class="text-ink tabular-nums">{a.year}</span>
              <span>
                {a.href ? (
                  <a href={a.href} target="_blank" rel="noopener noreferrer" class="link-strong">
                    {a.title}
                  </a>
                ) : (
                  <span class="text-ink">{a.title}</span>
                )}
                <span class="text-muted">
                  {" "}· {a.issuer}
                  {a.detail && ` · ${a.detail}`}
                </span>
              </span>
            </li>
          ))}
        </ul>
        <p data-reveal style={`--i:${awards.length + 1}`} aria-hidden="true">
          <span class="text-accent">jerome@ai</span> <span class="text-muted">~</span> <span class="cursor"></span>
        </p>
      </div>
      </div>
    </section>
  )
}

<style>
  /* Hovering a line highlights it like a selected row in a terminal. */
  .line {
    margin-inline: -8px;
    padding-inline: 8px;
    border-radius: 3px;
    transition: background-color 0.2s ease;
  }
  .line:hover {
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--color-ink);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: log-blink 1.1s steps(1) infinite;
    }
  }
  @keyframes log-blink {
    50% {
      opacity: 0;
    }
  }
</style>
