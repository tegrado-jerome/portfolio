---
import { faAward } from "@fortawesome/free-solid-svg-icons";
import { awards } from "../data/awards";
import CredentialGrid from "./CredentialGrid.astro";

const entries = awards.map((a) => ({
  title: a.title,
  year: a.year,
  href: a.href,
  image: a.image,
  imageAlt: a.imageAlt,
  caption: a.short ?? a.issuer,
  issuer: a.issuer,
  details: a.detail ? [a.detail] : [],
}));
---

<CredentialGrid id="awards" title="Awards" entries={entries} placeholder="AWARD PHOTO" icon={faAward} linkLabel="view proof" />
