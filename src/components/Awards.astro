---
// Awards as a hairline list: year, award, issuer. Hovering a row fades the others, like the journey line.
import { faArrowRight } from "@fortawesome/free-solid-svg-icons";
import { awards } from "../data/awards";
import Icon from "./Icon.astro";
---

{
  awards.length > 0 && (
    <section id="awards" class="shell py-[clamp(56px,8vw,110px)]" aria-labelledby="awards-title">
      <h2 id="awards-title" data-reveal class="eyebrow mb-[clamp(20px,3vw,32px)] text-[11px] text-muted">
        Awards
      </h2>
      <ul class="awards border-t border-line">
        {awards.map((a, i) => (
          <li data-reveal style={`--i:${i}`} class="award border-b border-line">
            <div class="grid gap-1 py-5 md:grid-cols-[120px_minmax(0,1fr)_minmax(0,1fr)] md:items-baseline md:gap-6">
              <span class="text-[12px] text-muted tabular-nums">{a.year}</span>
              <p class="font-serif text-[clamp(20px,2vw,26px)] leading-tight">
                {a.href ? (
                  <a href={a.href} target="_blank" rel="noopener noreferrer" class="group inline-flex items-baseline gap-2">
                    <span class="brush">{a.title}</span>
                    <Icon icon={faArrowRight} class="-rotate-45 text-[12px] text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                  </a>
                ) : (
                  a.title
                )}
                {a.detail && <span class="ml-2 align-middle font-sans text-[12px] text-muted">{a.detail}</span>}
              </p>
              <span class="text-[13px] text-ink-soft md:text-right">{a.issuer}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .award > div {
    transition: opacity 0.3s ease;
  }
  @media (hover: hover) {
    .awards:hover .award:not(:hover) > div {
      opacity: 0.35;
    }
  }
</style>
