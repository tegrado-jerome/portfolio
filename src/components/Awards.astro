---
import { awards } from "../data/awards";
import CredentialGrid from "./CredentialGrid.astro";

const entries = awards.map((a) => ({
  title: a.title,
  year: a.year,
  href: a.href,
  image: a.image,
  imageAlt: a.imageAlt,
  lines: [a.issuer, ...(a.detail ? a.detail.split(" · ") : [])],
}));
---

<CredentialGrid id="awards" title="Awards" entries={entries} placeholder="AWARD PHOTO" />
