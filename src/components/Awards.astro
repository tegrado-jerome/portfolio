---
// Awards as a hairline list: award, issuer, then the year on the right. Hovering a row fades the others, like the journey line.
import { awards } from "../data/awards";
import SectionHead from "./SectionHead.astro";
---

{
  awards.length > 0 && (
    <section id="awards" class="shell section" aria-labelledby="awards-title">
      <SectionHead id="awards-title" title="Awards" />
      <ul class="awards border-t border-line">
        {awards.map((a, i) => (
          <li data-reveal style={`--i:${i}`} class="award border-b border-line">
            <div class="grid gap-1 py-5 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_96px] md:items-baseline md:gap-6">
              <p class="font-serif text-heading">
                {a.href ? (
                  <a href={a.href} target="_blank" rel="noopener noreferrer" class="link-strong">
                    {a.title}
                  </a>
                ) : (
                  a.title
                )}
                {a.detail && <span class="ml-2 align-middle font-sans text-small text-muted">{a.detail}</span>}
              </p>
              <span class="text-small text-muted">{a.issuer}</span>
              <span class="eyebrow text-muted tabular-nums md:text-right">{a.year}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .award > div {
    transition: opacity 0.3s ease;
  }
  @media (hover: hover) {
    .awards:hover .award:not(:hover) > div {
      opacity: 0.35;
    }
  }
</style>
