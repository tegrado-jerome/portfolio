---
import { awards } from "../data/awards";
import CredentialLog from "./CredentialLog.astro";

const entries = awards.map((a) => ({
  title: a.title,
  year: a.year,
  href: a.href,
  lines: [a.issuer, ...(a.detail ? a.detail.split(" · ") : [])],
}));
---

<CredentialLog id="awards" title="Awards" entries={entries} />
