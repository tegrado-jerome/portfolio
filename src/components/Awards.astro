---
import { awards } from "../data/awards";
import Spotlight from "./Spotlight.astro";

const entries = awards.map((a) => ({
  title: a.title,
  year: a.year,
  href: a.href,
  image: a.image,
  imageAlt: a.imageAlt,
  document: a.document,
  caption: a.short ?? a.issuer,
  issuer: a.issuer,
  details: a.detail ? [a.detail] : [],
}));
---

<Spotlight id="awards" title="Awards" entries={entries} placeholder="AWARD PHOTO" linkLabel="view proof" />
