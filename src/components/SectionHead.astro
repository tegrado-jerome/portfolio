---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div data-reveal class="mb-[clamp(32px,4.5vw,56px)] flex items-center gap-7">
  <h2 id={id} class="font-serif text-title font-normal">
    {title}
  </h2>
  <span class="hidden h-px flex-1 translate-y-[0.3em] bg-line sm:block" aria-hidden="true"></span>
</div>
