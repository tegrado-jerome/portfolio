---
// A section's ~/path title, at the top of its `.pane`.
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const path = title.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<div class="absolute inset-x-0 top-0 text-small">
  <h2 id={id} class="font-normal text-ink">
    <span class="sr-only">{title}</span>
    <span aria-hidden="true"><span class="text-accent">~/</span>{path}</span>
  </h2>
</div>
