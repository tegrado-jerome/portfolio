---
// A section whose cards (the slot: one <li class="stack-item" style="--i:N"> per card, each holding a .stack-card)
// stack as you scroll. Used by Projects and Experience.
import SectionHead from "./SectionHead.astro";

interface Props {
  id: string;
  title: string;
  count: number;
}

const { id, title, count } = Astro.props;
---

<!-- Sticky stack (after the stacking-cards demos on scroll-driven-animations.style and CodyHouse): the stack pins near
     the top, and each scroll of about a third of the screen slides the next card up from below onto it, while the
     ones behind sink back, tilt a touch and dim, a light fake 3D. Every card lands whole, and the scroll it takes is
     set by --per, not by the card's height, so it never drags. A "keep scrolling" pill counts the cards and leaves once
     the last one lands. Without JS, or with reduced motion, the cards are a plain list. -->
<section id={id} class="shell section" aria-labelledby={`${id}-title`}>
  <div class="pane" data-pane={id}>
    <SectionHead id={`${id}-title`} title={title} />
    <div class="stack-wrap">
      <div class="stack" data-stack style={`--n:${count}`}>
        <div class="stack-pin">
          <ol class="stack-list">
            <slot />
          </ol>
        </div>
      </div>
    </div>
    <p class="stack-hint is-waiting" data-stack-hint data-pause-offscreen aria-hidden="true">
      <span class="mouse"><span class="wheel"></span></span>
      <span><span data-stack-count class="tabular-nums">01/{String(count).padStart(2, "0")}</span> · keep scrolling</span>
    </p>
  </div>
</section>

<style>
  /* The cards' width, for sizing their height from it. */
  .stack-wrap {
    container-type: inline-size;
  }
  .stack {
    /* Wide screens: the picture pane takes 1.6 of the card's 2.3 parts of width and is 16:10, so the card is that
       pane's height (0.4348 of the card's width) plus the title bar. Capped to fit the screen. */
    --card-h: min(calc(43.48cqw + 41px), calc(100svh - 150px));
    --top: 24px;
    --step: 14px;
    --per: 36svh; /* scroll it takes to bring in the next card */
  }
  /* Tablets stack the card (picture on top), so it gets taller. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .stack {
      /* A full-width 16:10 picture (62.5% of the width tall) plus the title bar and the story under it. */
      --card-h: min(calc(62.5cqw + 250px), calc(100svh - 160px));
    }
  }
  @media (max-width: 767px) {
    .stack {
      --card-h: min(700px, calc(100svh - 140px));
      --top: 16px;
      --step: 10px;
      --per: 34svh;
    }
  }
  /* Plain list: no JS, or reduced motion. */
  .stack-list {
    display: grid;
    gap: 16px;
  }
  .stack-list > :global(.stack-item) {
    height: var(--card-h);
  }

  /* The stack (the script adds .is-live): the track is tall enough to scroll through every card, the pin holds the
     cards in place meanwhile, and each card waits below the screen until its turn. The track clips only its bottom
     edge, so a waiting card never shows over the next section. */
  .stack.is-live {
    height: calc(var(--card-h) + (var(--n) - 1) * (var(--step) + var(--per)));
    clip-path: inset(-60px -60px 0 -60px);
  }
  .is-live .stack-pin {
    position: sticky;
    top: var(--top);
    height: calc(var(--card-h) + (var(--n) - 1) * var(--step));
  }
  .is-live .stack-list {
    display: block;
    position: relative;
    height: 100%;
  }
  .is-live :global(.stack-item) {
    position: absolute;
    top: calc(var(--i) * var(--step));
    right: 0;
    left: 0;
    /* A card still waiting below the screen leaves its box in place; the box lets clicks through, and only the card
       itself (wherever it has moved) takes them. */
    pointer-events: none;
  }
  .is-live :global(.stack-item > .stack-card) {
    pointer-events: auto;
  }
  /* One GPU layer per card; the script moves it with a single transform. */
  .is-live :global(.stack-item > .stack-card) {
    transform-origin: 50% 0;
    will-change: transform;
    backface-visibility: hidden;
  }

  /* The hint rides at the bottom of the screen while the stack is on it. Same pill on every screen. */
  .stack-hint {
    position: sticky;
    bottom: 16px;
    z-index: 5;
    display: flex;
    gap: 10px;
    align-items: center;
    width: max-content;
    margin: 24px auto 0;
    padding: 6px 12px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-muted);
    font-size: var(--text-small);
    transition: opacity 0.4s ease;
  }
  @media (min-width: 1024px) {
    .stack-hint {
      bottom: 56px; /* above the status bar */
    }
  }
  /* Out of sight until the stack has pinned (the section fully on screen, not just entering), and again once the
     last card has landed. */
  .stack-hint.is-done,
  .stack-hint.is-waiting {
    opacity: 0;
  }
  .mouse {
    position: relative;
    display: block;
    width: 14px;
    height: 21px;
    border: 1.5px solid currentColor;
    border-radius: 7px;
  }
  .wheel {
    position: absolute;
    top: 4px;
    left: 50%;
    width: 2px;
    height: 5px;
    margin-left: -1px;
    border-radius: 1px;
    background: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wheel {
      animation: wheel 1.6s ease-in-out infinite;
    }
  }
  @keyframes wheel {
    0% {
      translate: 0 0;
      opacity: 1;
    }
    70% {
      translate: 0 7px;
      opacity: 0;
    }
    100% {
      translate: 0 0;
      opacity: 0;
    }
  }
</style>

<script>
  // Scroll through the track moves the cards: `arrived[i]` goes 0 → 1 as card i slides up from below the screen onto
  // the stack. A card's depth is how much of the cards after it have arrived; deeper cards shrink, tilt back and dim.
  //
  // Built to stay smooth on slow phones and in every browser:
  // - each card is one GPU layer, moved with a single transform (slide and depth combined), so the browser only
  //   recombines layers and never repaints a card while it moves;
  // - the dimming changes in small steps, so a card is repainted a handful of times per pass, not every frame;
  // - nothing is written unless it changed (the counter's text included), and nothing runs while the stack is off
  //   screen.
  for (const stack of document.querySelectorAll<HTMLElement>("[data-stack]")) {
    const pane = stack.closest("[data-pane]")!;
    const hint = pane.querySelector<HTMLElement>("[data-stack-hint]");
    const count = pane.querySelector<HTMLElement>("[data-stack-count]");
    if (hint && count && !matchMedia("(prefers-reduced-motion: reduce)").matches) setUp(stack, hint, count);
  }

  function setUp(stack: HTMLElement, hint: HTMLElement, count: HTMLElement) {
    const items = [...stack.querySelectorAll<HTMLElement>(".stack-item")];
    const cards = items.map((li) => li.firstElementChild as HTMLElement);
    const dims = cards.map((card) => card.querySelector<HTMLElement>(".dim")!);
    const pin = stack.querySelector<HTMLElement>(".stack-pin")!;
    const total = String(items.length).padStart(2, "0");
    const lastTransform = items.map(() => "");
    const lastDim = items.map(() => "");
    let lastCount = "";
    let lastDone = false;
    let lastWaiting = false;
    stack.classList.add("is-live");

    // Sizes, measured again only when the screen size changes.
    let top = 0; // where the pin sticks
    let per = 1; // scroll per card
    let rise: number[] = []; // how far below its spot each card waits: just off the bottom of the screen
    const measure = () => {
      top = parseFloat(getComputedStyle(pin).top);
      per = Math.max(1, (stack.offsetHeight - pin.offsetHeight) / Math.max(1, items.length - 1));
      rise = items.map((li) => Math.max(0, innerHeight - top - li.offsetTop));
    };

    // The cards glide toward where the scroll says they should be instead of snapping to it, closing about 63% of
    // the gap every GLIDE ms: softer with a mouse wheel (a notch jumps ~100px at once), lighter on touch screens,
    // where the finger already scrolls smoothly, so they trail it a little without feeling slow.
    const GLIDE = matchMedia("(pointer: fine)").matches ? 150 : 100; // ms
    let shown = 0; // the progress on screen, in cards
    let lastTime = 0; // 0 while at rest
    let snap = true; // jump straight there (first paint, resize)
    let frame = 0;

    function render() {
      const arrived = items.map((_, i) => (i === 0 ? 1 : Math.min(1, Math.max(0, shown - (i - 1)))));
      for (let i = 0; i < items.length; i++) {
        // The slide eases out, so each card settles softly onto the stack.
        const slide = i ? (1 - (1 - arrived[i]) ** 2) : 1;
        let depth = 0;
        for (let j = i + 1; j < items.length; j++) depth += arrived[j];
        depth = Math.min(depth, 3);
        const y = (1 - slide) * rise[i] - depth * 6;
        const transform =
          y || depth
            ? `translate3d(0, ${y.toFixed(1)}px, 0) perspective(1400px) rotateX(${(depth * 2.5).toFixed(2)}deg) scale(${(1 - depth * 0.05).toFixed(4)})`
            : "";
        if (transform !== lastTransform[i]) cards[i].style.transform = lastTransform[i] = transform;
        const dim = (Math.round(Math.min(depth, 2) * 4) / 20).toFixed(2); // 0, 0.05 … 0.4
        if (dim !== lastDim[i]) dims[i].style.opacity = lastDim[i] = dim;
      }
      const landed = `${String(Math.max(1, arrived.filter((a) => a >= 0.5).length)).padStart(2, "0")}/${total}`;
      if (landed !== lastCount) count!.textContent = lastCount = landed;
      const done = arrived[arrived.length - 1] >= 0.98;
      if (done !== lastDone) hint!.classList.toggle("is-done", (lastDone = done));
    }

    function update(now: number) {
      frame = 0;
      const target = (top - stack!.getBoundingClientRect().top) / per;
      // The hint waits until the stack has actually pinned; while the section is only part-way up the screen it stays
      // out of sight.
      const waiting = target < 0;
      if (waiting !== lastWaiting) hint!.classList.toggle("is-waiting", (lastWaiting = waiting));
      if (snap) {
        shown = target;
        snap = false;
      } else if (lastTime) {
        shown += (target - shown) * (1 - Math.exp(-Math.min(64, now - lastTime) / GLIDE));
        if (Math.abs(target - shown) < 0.0005) shown = target;
      }
      lastTime = shown === target ? 0 : now;
      if (lastTime) frame = requestAnimationFrame(update);
      render();
    }
    const queue = () => (frame ||= requestAnimationFrame(update));
    const resized = () => {
      measure();
      snap = true;
      queue();
    };
    resized();

    let watching = false;
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting === watching) return;
      watching = entry.isIntersecting;
      if (watching) {
        addEventListener("scroll", queue, { passive: true });
        addEventListener("resize", resized, { passive: true });
        resized();
      } else {
        removeEventListener("scroll", queue);
        removeEventListener("resize", resized);
      }
    }).observe(stack);
  }
</script>
