---
// Two-column quotes with dates and linked names (after set.studio and irene-butenko.com).
import { testimonials } from "../data/testimonials";
---

{
  testimonials.length > 0 && (
    <section id="testimonials" class="shell py-[clamp(56px,8vw,110px)]" aria-labelledby="testimonials-title">
      <div class="grid gap-8 md:grid-cols-12 md:gap-10">
        <h2 id="testimonials-title" data-reveal class="eyebrow text-[11px] text-muted md:col-span-3">
          Kind words
        </h2>
        <div class="grid md:col-span-9 md:grid-cols-2">
          {testimonials.map((t, i) => (
            <figure
              data-reveal
              style={`--i:${i}`}
              class="m-0 border-line py-8 first:pt-0 max-md:not-first:border-t md:py-0 md:odd:pr-9 md:even:border-l md:even:pl-9"
            >
              <p class="mb-3 text-[12px] text-muted tabular-nums">
                {String(i + 1).padStart(2, "0")} — {t.year}
              </p>
              <blockquote class="m-0 max-w-[34ch] font-serif text-[clamp(22px,1rem+1.2vw,28px)] leading-[1.3]">
                <p>{t.quote}</p>
              </blockquote>
              <figcaption class="mt-4 text-[15px] font-medium">
                {t.href ? (
                  <a href={t.href} target="_blank" rel="noopener noreferrer" class="brush">
                    {t.name}
                  </a>
                ) : (
                  t.name
                )}
                <span class="text-[12px] font-normal tracking-[0.06em] text-muted uppercase">
                  {" "}
                  · {t.role}, {t.company}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}
