---
// Quotes as slightly tilted paper notes (after the reference's Atelier collage); hovering one straightens it.
import { testimonials } from "../data/testimonials";
import SectionHead from "./SectionHead.astro";
---

{
  testimonials.length > 0 && (
    <section id="testimonials" class="shell section" aria-labelledby="testimonials-title">
      <SectionHead id="testimonials-title" title="Kind words" />
      <div class="grid items-start gap-10 md:grid-cols-2 md:gap-x-[clamp(28px,4vw,64px)]">
        {testimonials.map((t, i) => (
          <figure data-reveal style={`--i:${i}`} class:list={["m-0", i % 2 === 1 && "md:mt-12"]}>
            <div class="note p-[clamp(22px,2.5vw,32px)]" style={`--tilt:${i % 2 ? 2 : -2.5}deg`}>
              {/* Quote first, then who said it, their role, and when. */}
              <blockquote class="m-0 font-serif text-heading">
                <p>{t.quote}</p>
              </blockquote>
              <figcaption class="mt-5">
                <span class="block text-body font-medium">
                  {t.href ? (
                    <a href={t.href} target="_blank" rel="noopener noreferrer" class="link-strong">
                      {t.name}
                    </a>
                  ) : (
                    t.name
                  )}
                </span>
                <span class="block text-small text-muted">
                  {t.role}, {t.company}
                </span>
                <span class="eyebrow mt-2 block text-muted tabular-nums">{t.year}</span>
              </figcaption>
            </div>
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  .note {
    background: color-mix(in srgb, var(--color-paper) 40%, white);
    box-shadow: 0 18px 40px -22px rgb(0 0 0 / 0.35);
    transform: rotate(var(--tilt));
    transition:
      transform 0.45s cubic-bezier(0.2, 0.75, 0.2, 1),
      box-shadow 0.45s ease;
  }
  :global([data-theme="dark"]) .note {
    background: color-mix(in srgb, var(--color-paper) 88%, white);
  }
  .note:hover {
    transform: rotate(0) translateY(-4px);
    box-shadow: 0 26px 50px -24px rgb(0 0 0 / 0.4);
  }
  @media (max-width: 767px) {
    .note {
      transform: rotate(calc(var(--tilt) / 2));
    }
  }
</style>
