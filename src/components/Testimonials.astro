---
// Quotes as straight hairline boxes inside the "kind-words" pane.
import { testimonials } from "../data/testimonials";
import SectionHead from "./SectionHead.astro";
---

{
  testimonials.length > 0 && (
    <section id="testimonials" class="shell section" aria-labelledby="testimonials-title">
      <div class="pane" data-pane="kind-words">
      <SectionHead id="testimonials-title" title="Kind words" />
      <div class="grid items-start gap-12 md:grid-cols-2 md:gap-x-[clamp(32px,5vw,80px)]">
        {testimonials.map((t, i) => (
          <figure data-reveal style={`--i:${i}`} class="m-0">
            <div class="note h-full p-[clamp(24px,3vw,40px)]">
              {/* Quote first, then who said it, their role, and when. */}
              <blockquote class="m-0 text-heading">
                <p>{t.quote}</p>
              </blockquote>
              <figcaption class="mt-5">
                <span class="block text-body font-medium">
                  {t.href ? (
                    <a href={t.href} target="_blank" rel="noopener noreferrer" class="link-strong">
                      {t.name}
                    </a>
                  ) : (
                    t.name
                  )}
                </span>
                <span class="block text-small text-muted">
                  {t.role}, {t.company}
                </span>
                <span class="eyebrow mt-2 block text-muted tabular-nums">{t.year}</span>
              </figcaption>
            </div>
          </figure>
        ))}
      </div>
      </div>
    </section>
  )
}

<style>
  /* Straight hairline boxes inside the pane; hover darkens the border like a focused TUI box. */
  .note {
    border: 1px solid var(--color-line);
    border-radius: 2px;
    transition: border-color 0.2s ease;
  }
  .note:hover {
    border-color: var(--color-ink);
  }
</style>
