---
// Quotes as straight hairline boxes inside the "kind-words" pane.
import { testimonials } from "../data/testimonials";
import { faUser } from "@fortawesome/free-solid-svg-icons";
import Icon from "./Icon.astro";
import SectionHead from "./SectionHead.astro";
---

{
  testimonials.length > 0 && (
    <section id="testimonials" class="shell section" aria-labelledby="testimonials-title">
      <div class="pane" data-pane="kind-words">
      <SectionHead id="testimonials-title" title="Kind words" />
      <div class="grid items-start gap-12 md:grid-cols-2 md:gap-x-[clamp(32px,5vw,80px)]">
        {testimonials.map((t, i) => (
          <figure data-reveal style={`--i:${i}`} class="m-0">
            <div class="note h-full p-[clamp(24px,3vw,40px)]">
              {/* Quote first, then who said it, their role, and when. */}
              <blockquote class="m-0 text-heading">
                <p>{t.quote}</p>
              </blockquote>
              {/* A round photo beside the name, like a LinkedIn recommendation. */}
              <figcaption class="mt-5 flex items-start gap-3">
                <span class="grid size-10 shrink-0 place-items-center overflow-hidden rounded-full bg-ph text-muted">
                  {t.avatar ? (
                    <img src={t.avatar} alt="" width="80" height="80" loading="lazy" decoding="async" class="size-full object-cover" />
                  ) : (
                    <Icon icon={faUser} class="text-[14px]" />
                  )}
                </span>
                <span>
                <span class="block text-body font-medium">
                  {t.href ? (
                    <a href={t.href} target="_blank" rel="noopener noreferrer" class="link-strong">
                      {t.name}
                    </a>
                  ) : (
                    t.name
                  )}
                </span>
                <span class="block text-small text-muted">
                  {t.role}, {t.company}
                </span>
                <span class="eyebrow mt-2 block text-muted tabular-nums">{t.year}</span>
                </span>
              </figcaption>
            </div>
          </figure>
        ))}
      </div>
      </div>
    </section>
  )
}

<style>
  /* No box: a soft surface, like a selected block in a terminal. */
  .note {
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }
</style>
