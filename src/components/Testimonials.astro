---
// Quotes one at a time, centred, with no box (after Stripe's customer quotes): the person's photo above, the quote, who
// said it. Under it the companies sit on one short bar that fills as the quotes move on by themselves, every 8 seconds,
// to the right, without stopping. A swipe or a click on a company jumps there. With reduced motion it never moves on its
// own. Without JS every quote shows, one under the other.
import { testimonials as all } from "../data/testimonials";
import { faUser } from "@fortawesome/free-solid-svg-icons";
import Icon from "./Icon.astro";
import SectionHead from "./SectionHead.astro";

const testimonials = all.filter((t) => t.quote);
const n = testimonials.length;
---

{
  n > 0 && (
    <section id="testimonials" class="shell screen" aria-labelledby="testimonials-title">
      <div class="pane" data-pane="testimonials">
        <SectionHead id="testimonials-title" title="Testimonials" />
        <div class="quotes" data-quotes data-reveal>
          <div class="viewport" data-quotes-viewport>
            <ul class="track" data-quotes-track>
              {testimonials.map((t, i) => (
                <li class="slide" aria-hidden={i === 0 ? undefined : "true"}>
                  <figure class="m-0 flex flex-col items-center gap-5 text-center">
                    <span class="avatar">
                      {t.avatar ? (
                        <img src={t.avatar} alt="" width="144" height="144" loading="lazy" decoding="async" class="size-full object-cover" />
                      ) : (
                        <Icon icon={faUser} class="text-[20px]" />
                      )}
                    </span>
                    <blockquote class="quote">
                      <p>“{t.quote}”</p>
                    </blockquote>
                    <figcaption class="text-small">
                      <span class="text-ink">{t.name}</span>
                      <span class="text-muted"> · {t.role}, {t.company}</span>
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </div>
          {n > 1 && (
            <div class="nav hidden in-[.js]:block" style={`--n:${n}`}>
              <ul class="companies">
                {testimonials.map((t, i) => (
                  <li>
                    <button type="button" data-quotes-to={i} aria-current={i === 0 ? "true" : undefined} aria-label={`Quote from ${t.name}`}>
                      {t.company}
                    </button>
                  </li>
                ))}
              </ul>
              <span class="rail" aria-hidden="true"><i data-quotes-fill></i></span>
            </div>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .slide {
    padding: 0 16px;
  }
  .slide + .slide {
    margin-top: 56px;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-ph);
    color: var(--color-muted);
  }
  .quote {
    max-width: 50ch;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(18px, 2.2vw, 26px);
    line-height: 1.45;
    text-wrap: balance;
  }
  /* With JS: one quote in view, the rest waiting to its right. */
  :global(.js) .viewport {
    overflow: hidden;
    touch-action: pan-y;
  }
  :global(.js) .track {
    display: flex;
    transition: transform 0.7s var(--ease-out-soft);
  }
  /* Every quote is as tall as the longest one: the photo stays at the top, the name at the bottom, and a shorter quote
     sits centred between them, so nothing shifts as they change. */
  :global(.js) .slide {
    display: flex;
    flex: 0 0 100%;
    margin: 0;
    padding-block: 8px 32px;
  }
  :global(.js) .slide figure {
    flex: 1;
  }
  :global(.js) .quote {
    display: flex;
    flex: 1;
    align-items: center;
  }
  /* The companies over one short bar; the fill runs the length of the bar over all the quotes. */
  .nav {
    width: min(100%, 420px);
    margin: 8px auto 0;
  }
  .companies {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
  }
  .companies li {
    display: flex;
    justify-content: center;
    min-width: 0;
  }
  .companies button {
    max-width: 100%;
    overflow: hidden;
    padding: 4px 2px;
    color: var(--color-muted);
    font-size: var(--text-small);
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .companies button[aria-current="true"] {
    color: var(--color-ink);
  }
  @media (hover: hover) {
    .companies button:hover {
      color: var(--color-ink);
    }
  }
  .rail {
    position: relative;
    display: block;
    height: 2px;
    margin-top: 10px;
    overflow: hidden;
    background: var(--color-line);
  }
  .rail i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    background: var(--color-ink);
    transform: scaleX(var(--p, 0));
    transform-origin: 0 50%;
  }
  @media (max-width: 767px) {
    .companies button {
      font-size: 12px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-quotes]");
  const fill = root?.querySelector<HTMLElement>("[data-quotes-fill]");
  if (root && fill) {
    const DURATION = 8000; // ms per quote: about 25 words at a relaxed reading pace, plus a beat to take in the face
    const track = root.querySelector<HTMLElement>("[data-quotes-track]")!;
    const viewport = root.querySelector<HTMLElement>("[data-quotes-viewport]")!;
    const slides = [...track.children] as HTMLElement[];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-quotes-to]")];
    const n = slides.length;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = 0;
    let elapsed = 0; // ms spent on the current quote
    let last = 0;
    let onScreen = false;
    let frame = 0;

    const draw = () => fill.style.setProperty("--p", String((current + Math.min(1, elapsed / DURATION)) / n));
    function go(i: number) {
      current = (i + n) % n;
      elapsed = 0;
      track.style.transform = `translateX(${-current * 100}%)`;
      slides.forEach((s, k) => (k === current ? s.removeAttribute("aria-hidden") : s.setAttribute("aria-hidden", "true")));
      buttons.forEach((b, k) => (k === current ? b.setAttribute("aria-current", "true") : b.removeAttribute("aria-current")));
      draw();
    }
    // Runs only while the section is on screen and the tab is visible, so it costs nothing elsewhere on the page.
    function tick(now: number) {
      frame = 0;
      if (last) elapsed += Math.min(100, now - last);
      last = now;
      if (elapsed >= DURATION) go(current + 1);
      else draw();
      run();
    }
    function run() {
      const moving = !still && onScreen && !document.hidden;
      if (moving && !frame) frame = requestAnimationFrame(tick);
      if (!moving) {
        cancelAnimationFrame(frame);
        frame = 0;
        last = 0;
      }
    }

    buttons.forEach((b, k) => b.addEventListener("click", () => (go(k), run())));
    document.addEventListener("visibilitychange", run);
    new IntersectionObserver(([entry]) => ((onScreen = entry.isIntersecting), run())).observe(root);

    // A sideways swipe moves to the next or previous quote.
    let x0 = 0;
    let y0 = 0;
    viewport.addEventListener("pointerdown", (e) => ((x0 = e.clientX), (y0 = e.clientY)));
    viewport.addEventListener("pointerup", (e) => {
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(e.clientY - y0) * 1.5) go(current + (dx < 0 ? 1 : -1));
    });

    go(0);
  }
</script>
