---
// Quotes in the site's one card (.tile in global.css): photo and name, role and company, the quote, then the year.
// Three per row when there are three (or six…), otherwise two.
import { testimonials } from "../data/testimonials";
import { faUser } from "@fortawesome/free-solid-svg-icons";
import Icon from "./Icon.astro";
import SectionHead from "./SectionHead.astro";
---

{
  testimonials.length > 0 && (
    <section id="testimonials" class="shell section" aria-labelledby="testimonials-title">
      <div class="pane" data-pane="testimonials">
      <SectionHead id="testimonials-title" title="Testimonials" />
      <div class:list={["card-grid grid", testimonials.length % 3 === 0 ? "md:grid-cols-3" : "md:grid-cols-2"]}>
        {testimonials.map((t, i) => (
          <figure data-reveal style={`--i:${i}`} class="tile m-0">
            <figcaption class="tile-top">
              <span class="tile-icon rounded-full bg-ph text-muted">
                {t.avatar ? (
                  <img src={t.avatar} alt="" width="52" height="52" loading="lazy" decoding="async" class="size-full object-cover" />
                ) : (
                  <Icon icon={faUser} class="text-[11px]" />
                )}
              </span>
              <span class="tile-title">{t.name}</span>
            </figcaption>
            <p class="tile-desc">{t.role}, {t.company}</p>
            <blockquote class="quote">
              <p>{t.quote}</p>
            </blockquote>
            <p class="tile-meta mt-auto">
              <span>{t.company}</span>
              <span>{t.year}</span>
            </p>
          </figure>
        ))}
      </div>
      </div>
    </section>
  )
}

<style>
  /* The quote sits where a picture would, on the same placeholder surface. */
  .quote {
    margin: 0 18px 18px;
    padding: 18px;
    border-radius: 3px;
    background: var(--color-ph);
    font-size: var(--text-heading);
    line-height: 1.45;
  }
  .quote::before {
    content: "“";
    display: block;
    height: 0.6em;
    color: var(--color-accent);
    font-size: 1.8em;
    line-height: 1;
  }
</style>
