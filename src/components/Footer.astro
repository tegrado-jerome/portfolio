---
import { site, socials } from "../data/site";

const year = new Date().getFullYear();
const emailHref = site.email.includes("@") ? `mailto:${site.email}` : "#";
const linkClass = "brush text-[15px]";
---

<!-- Light footer with a name block and link columns (after set.studio / editorial studio footers). -->
<footer id="contact" class="shell border-t border-line pt-[clamp(48px,6vw,80px)] pb-[clamp(28px,4vw,44px)]">
  <div class="grid gap-10 sm:grid-cols-3 md:grid-cols-[2fr_1fr_1fr_1fr]">
    <p class="font-serif text-[clamp(36px,4vw,48px)] leading-none sm:col-span-3 md:col-span-1">
      {site.name.split(" ").map((word, i) => (i ? [<br />, word] : word))}
    </p>

    <div>
      <h2 class="eyebrow mb-3 text-[11px] text-muted">Contact</h2>
      <ul class="space-y-2">
        <li><a href={emailHref} class={linkClass}>{site.email}</a></li>
      </ul>
    </div>

    <div>
      <h2 class="eyebrow mb-3 text-[11px] text-muted">Social</h2>
      <ul class="space-y-2">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
                {s.label} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="eyebrow mb-3 text-[11px] text-muted">Site</h2>
      <ul class="space-y-2">
        <li><a href="#work" class={linkClass}>Work</a></li>
        <li><a href="/" data-to-top class={linkClass}>Top ↑</a></li>
        <li class="hidden in-[.js]:list-item">
          <button type="button" data-palette-open class={linkClass}>Command menu</button>
        </li>
      </ul>
    </div>
  </div>

  <div class="mt-[clamp(48px,7vw,90px)] flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-[12px] text-muted">
    <p class="eyebrow text-[11px]">© {year} {site.name}</p>
    {
      site.timezone && (
        <p class="eyebrow text-[11px]">
          Local time <time data-clock={site.timezone} class="text-ink tabular-nums" />
        </p>
      )
    }
  </div>
</footer>

<script>
  const clock = document.querySelector<HTMLTimeElement>("[data-clock]");
  if (clock) {
    const format = new Intl.DateTimeFormat("en-GB", { timeZone: clock.dataset.clock, hour: "2-digit", minute: "2-digit" });
    const tick = () => (clock.textContent = format.format(new Date()));
    tick();
    setInterval(tick, 30_000);
  }
</script>
