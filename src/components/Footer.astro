---
import { faArrowRight } from "@fortawesome/free-solid-svg-icons";
import { site, socials } from "../data/site";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
const emailHref = site.email.includes("@") ? `mailto:${site.email}` : "#";
const photo = site.footerImage;
---

<!-- The page fades into a full-bleed photo (after the reference, adikrz.netlify.app). -->
<footer
  id="contact"
  class="footer relative flex min-h-[clamp(420px,46vw,640px)] items-end overflow-hidden px-5 pt-40 pb-[clamp(28px,4vw,48px)] text-white sm:px-[clamp(20px,11vw,200px)]"
  style={`--photo: url("${photo}")`}
  data-image={photo}
>
  <div class="relative z-[2] flex w-full flex-col gap-[clamp(22px,4vw,44px)]">
    <div class="flex items-center justify-between gap-6">
      <a href="/" data-to-top aria-label="Back to top" class="logo-mark size-12 bg-white transition-opacity hover:opacity-80"></a>
      <a href={emailHref} class="group eyebrow inline-flex items-center gap-2.5 text-[13px] text-white transition-opacity hover:opacity-80">
        Let's talk
        <Icon
          icon={faArrowRight}
          class="-rotate-45 text-[15px] transition-transform duration-300 ease-out-soft group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>
    <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
      <ul class="flex gap-7">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="eyebrow inline-flex items-center gap-2 text-[11px] text-white/75 transition-colors hover:text-white"
              >
                <Icon icon={s.icon} class="text-[16px]" />
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {
          site.timezone && (
            <p class="eyebrow text-[11px] text-white/75">
              Local time <time data-clock={site.timezone} class="text-white tabular-nums" />
            </p>
          )
        }
        <p class="eyebrow text-[11px] text-white/75">© {year} {site.name}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background:
      linear-gradient(180deg, var(--color-paper) 0%, transparent 50%),
      linear-gradient(180deg, rgb(20 20 20 / 0.1), rgb(20 20 20 / 0.55)),
      var(--photo) center / cover no-repeat,
      var(--color-night);
  }
  .logo-mark {
    display: block;
    mask: url("/images/logo.png") center / contain no-repeat;
  }
  .footer:hover > :global(.ascii-lens) {
    opacity: 0.5;
  }
</style>

<script>
  import { asciiLens } from "../scripts/ascii-lens";

  const clock = document.querySelector<HTMLTimeElement>("[data-clock]");
  if (clock) {
    const format = new Intl.DateTimeFormat("en-GB", { timeZone: clock.dataset.clock, hour: "2-digit", minute: "2-digit" });
    const tick = () => (clock.textContent = format.format(new Date()));
    tick();
    setInterval(tick, 30_000);
  }

  // Same cursor-following ASCII lens as the reference's footer, sampled from the photo.
  const footer = document.getElementById("contact")!;
  const src = footer.dataset.image;
  if (src) {
    const image = new Image();
    image.onload = () => asciiLens(footer, { cell: 9, radius: 92, alpha: 0.5, image, className: "z-[1]" });
    image.src = src;
  }
</script>
