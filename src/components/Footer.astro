---
// The last TUI pane, ~/contact: the contact command, a big "let's talk", bracketed links, and the footer photo
// rendered as ASCII art in the background (the futuristic take on the reference's photo footer).
import { faArrowRight, faArrowUp, faFileLines } from "@fortawesome/free-solid-svg-icons";
import { contactHref, site, socials } from "../data/site";
import { isSet } from "../data/placeholders";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
// LinkedIn and resume sit here beside "Let's talk", where visitors look when they're ready to reach out,
// each with its real logo. Placeholder links point nowhere ("#") until the real URLs are filled in.
const profileLinks = [
  ...socials.map((s) => ({ label: s.label, href: isSet(s.href) ? s.href : "#", icon: s.icon })),
  { label: "Resume", href: isSet(site.resume) ? site.resume : "#", icon: faFileLines },
];
---

<footer id="contact" data-pane="contact" class="shell pt-[clamp(80px,10vw,160px)] pb-[clamp(48px,6vw,96px)]">
  <div class="pane">
    <div class="absolute inset-x-6 -top-[0.8em] z-[2] flex text-small">
      <span class="bg-paper px-2 text-ink"><span class="text-accent">~/</span>contact</span>
    </div>

    <!-- Clipped on its own, so the pane title above the line never gets cut off. -->
    <div class="art-wrap" aria-hidden="true"><canvas class="ascii-art" data-image={site.footerImage}></canvas></div>

    <div class="relative z-[1] flex flex-col gap-7">
      <p class="text-small text-muted"><span class="text-accent">jerome@ai</span> ~ <span class="text-ink">contact</span></p>
      <a
        href={contactHref}
        target="_blank"
        rel="noopener noreferrer"
        class="group link-strong inline-flex w-fit items-center gap-[0.3em] text-title font-medium tracking-[-0.03em]"
      >
        let's talk
        <Icon
          icon={faArrowRight}
          class="-rotate-45 text-[0.6em] transition-transform duration-300 ease-out-soft group-hover:translate-x-1 group-hover:-translate-y-1"
        />
      </a>
      {isSet(site.email) && <p class="text-body text-muted">{site.email}</p>}
      <ul class="flex flex-wrap gap-2">
        {
          profileLinks.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer" class="tui-btn inline-flex border border-line">
                [ <Icon icon={l.icon} class="text-[14px]" /> {l.label.toLowerCase()} ]
              </a>
            </li>
          ))
        }
        <li>
          <a href="/" data-to-top class="tui-btn inline-flex border border-line">
            [ <Icon icon={faArrowUp} class="text-[12px]" /> top ]
          </a>
        </li>
      </ul>
      <p class="mt-4 text-small text-muted">© {year} {site.name.toLowerCase().replace(" ", "-")}</p>
    </div>
  </div>
</footer>

<style>
  /* The photo as ASCII art beside the text, fading in from the right. Phones skip it: there's no room
     beside the text there, and behind it the glyphs made the text hard to read. */
  .art-wrap {
    position: absolute;
    inset: 1px 0 0 auto;
    width: 60%;
    overflow: hidden;
    pointer-events: none;
  }
  .ascii-art {
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(to right, transparent, #000 45%);
  }
  @media (max-width: 767px) {
    .art-wrap {
      display: none;
    }
  }
</style>

<script>
  // Draws the footer photo once as ASCII characters (darker pixels get denser glyphs), redrawn on resize and theme change.
  const RAMP = " .:-=+*#%@";
  const canvas = document.querySelector<HTMLCanvasElement>(".ascii-art");
  if (canvas?.dataset.image) {
    const image = new Image();
    image.onload = () => {
      const draw = () => {
        const cell = 9;
        const { width: w, height: h } = canvas.getBoundingClientRect();
        if (!w || !h) return;
        const dpr = Math.min(2, devicePixelRatio || 1);
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        const ctx = canvas.getContext("2d")!;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const cols = Math.ceil(w / cell);
        const rows = Math.ceil(h / cell);
        const off = document.createElement("canvas");
        off.width = cols;
        off.height = rows;
        const octx = off.getContext("2d", { willReadFrequently: true })!;
        const s = Math.max(cols / image.naturalWidth, rows / image.naturalHeight);
        octx.drawImage(image, (cols - image.naturalWidth * s) / 2, (rows - image.naturalHeight * s) / 2, image.naturalWidth * s, image.naturalHeight * s);
        const px = octx.getImageData(0, 0, cols, rows).data;
        ctx.font = `${cell + 1}px ${getComputedStyle(document.body).fontFamily}`;
        ctx.textBaseline = "top";
        ctx.fillStyle = getComputedStyle(document.body).getPropertyValue("--color-muted");
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            const i = (y * cols + x) * 4;
            const light = (0.299 * px[i] + 0.587 * px[i + 1] + 0.114 * px[i + 2]) / 255;
            const ch = RAMP[Math.floor((1 - light) * (RAMP.length - 1))];
            if (ch !== " ") ctx.fillText(ch, x * cell, y * cell);
          }
        }
      };
      draw();
      new ResizeObserver(draw).observe(canvas);
      document.addEventListener("themechange", draw);
    };
    image.src = canvas.dataset.image;
  }
</script>
