---
// The last TUI pane, ~/contact: a status line, one big line, my email with a copy button, then bracketed profile links
// (after raviklaassens.com's "available from" and rauno.me's copy-on-click email).
import { faArrowUp, faCopy, faFileLines } from "@fortawesome/free-solid-svg-icons";
import { contactHref, site, socials } from "../data/site";
import { isSet } from "../data/placeholders";
import Icon from "./Icon.astro";
import SectionHead from "./SectionHead.astro";

const year = new Date().getFullYear();
// LinkedIn and resume sit here, where visitors look when they're ready to reach out, each with its real logo.
// Placeholder links point nowhere ("#") until the real URLs are filled in.
const profileLinks = [
  ...socials.map((s) => ({ label: s.label, href: isSet(s.href) ? s.href : "#", icon: s.icon })),
  { label: "Resume", href: isSet(site.resume) ? site.resume : "#", icon: faFileLines },
];
---

<footer id="contact" data-pane="contact" aria-labelledby="contact-title" class="shell section pb-[clamp(48px,6vw,96px)]">
  <div class="pane">
    <SectionHead id="contact-title" title="Contact" />

    <div class="relative z-[1] flex flex-col gap-7">
      {
        site.availability && (
          <p class="text-small text-ink">
            <span class="dot" aria-hidden="true" />
            {site.availability}
            {site.lookingFor && <span class="text-muted"> · {site.lookingFor}</span>}
          </p>
        )
      }
      <p class="text-title font-medium">Let's build something.</p>
      <div class="flex flex-wrap items-center gap-3">
        <a href={contactHref} target="_blank" rel="noopener noreferrer" class="link-strong text-heading break-all">{site.email}</a>
        <button type="button" data-copy-email={site.email} class="tui-btn inline-flex">
          [ <Icon icon={faCopy} class="text-[12px]" /><span data-copy-label> copy</span> ]
        </button>
        <span class="sr-only" role="status" data-copy-status></span>
      </div>
      <ul class="flex flex-wrap gap-2">
        {
          profileLinks.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer" class="tui-btn inline-flex">
                [ <Icon icon={l.icon} class="text-[14px]" /> {l.label.toLowerCase()} ]
              </a>
            </li>
          ))
        }
        <li>
          <a href="/" data-to-top class="tui-btn inline-flex">
            [ <Icon icon={faArrowUp} class="text-[12px]" /> top ]
          </a>
        </li>
      </ul>
      <p class="mt-4 text-small text-muted">© {year} {site.name.toLowerCase().replace(" ", "-")}</p>
    </div>
  </div>
</footer>

<style>
  .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--color-online);
    vertical-align: 1px;
  }
</style>

<script>
  // Copy my email, and say "copied" on the button for a moment.
  const button = document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const label = button?.querySelector("[data-copy-label]");
  const status = document.querySelector("[data-copy-status]");
  let timer: number | undefined;
  button?.addEventListener("click", async () => {
    await navigator.clipboard?.writeText(button.dataset.copyEmail!).catch(() => {});
    label!.textContent = " copied ✓";
    status!.textContent = "Email address copied";
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      label!.textContent = " copy";
      status!.textContent = "";
    }, 2000);
  });
</script>
