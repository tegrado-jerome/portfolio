---
import { faArrowUp, faXmark } from "@fortawesome/free-solid-svg-icons";
import { assistant } from "../data/assistant";
import Icon from "./Icon.astro";
---

<!-- Chat with an AI version of Jerome. Talks to /api/chat (worker/index.ts); JS-only. -->
<button
  type="button"
  data-chat-open
  class="eyebrow fixed right-4 bottom-4 z-30 hidden items-center gap-2 rounded-full border border-line bg-paper px-4 py-3 text-[11px] text-ink shadow-[0_8px_24px_-12px_rgb(0_0_0/0.6)] transition-colors hover:border-accent in-[.js]:inline-flex sm:right-6 sm:bottom-6"
  aria-controls="chat"
  aria-expanded="false"
>
  <span class="size-[7px] rounded-full bg-accent" aria-hidden="true"></span>
  Chat with me
</button>

<section
  id="chat"
  hidden
  aria-labelledby="chat-title"
  class="fixed inset-x-3 bottom-3 z-40 flex h-[min(560px,calc(100dvh-24px))] flex-col overflow-hidden rounded-[6px] border border-line bg-paper shadow-[0_24px_60px_-20px_rgb(0_0_0/0.7)] sm:inset-x-auto sm:right-6 sm:bottom-6 sm:w-[380px]"
>
  <header class="flex items-start justify-between gap-4 border-b border-line px-5 py-4">
    <div>
      <h2 id="chat-title" class="flex items-center gap-2 text-[15px] font-medium">
        Jerome
        <span class="eyebrow rounded-[3px] border border-line px-1.5 py-0.5 text-[9px] text-muted">AI</span>
      </h2>
      <p class="text-[12px] text-muted">An AI version of me — answers come from this portfolio.</p>
    </div>
    <button type="button" data-chat-close class="-m-2 p-2 text-muted transition-colors hover:text-ink" aria-label="Close chat">
      <Icon icon={faXmark} class="text-[16px]" />
    </button>
  </header>

  <ol data-chat-log aria-live="polite" class="flex flex-1 flex-col gap-3 overflow-y-auto px-5 py-4 text-[14px] leading-[1.55]">
    <li class="max-w-[85%] self-start whitespace-pre-line text-ink-soft">{assistant.greeting}</li>
  </ol>

  <div data-chat-suggestions class="flex flex-wrap gap-2 px-5 pb-3">
    {
      assistant.suggestions.map((s) => (
        <button type="button" class="rounded-full border border-line px-3 py-1.5 text-[12px] text-ink-soft transition-colors hover:border-accent hover:text-ink">
          {s}
        </button>
      ))
    }
  </div>

  <form data-chat-form class="flex items-end gap-2 border-t border-line p-3">
    <label for="chat-input" class="sr-only">Your message</label>
    <textarea
      id="chat-input"
      rows="1"
      maxlength="800"
      placeholder="Ask me something…"
      class="max-h-32 min-h-10 flex-1 resize-none bg-transparent px-2 py-2 text-[14px] text-ink placeholder:text-muted focus:outline-none"
    ></textarea>
    <button
      type="submit"
      class="grid size-10 shrink-0 place-items-center rounded-full bg-accent text-paper transition-opacity disabled:opacity-40"
      aria-label="Send"
    >
      <Icon icon={faArrowUp} class="text-[14px]" />
    </button>
  </form>
  <p class="px-5 pb-3 text-[10px] text-muted">AI can make mistakes. For anything important, email me directly.</p>
</section>

<script>
  type Message = { role: "user" | "assistant"; content: string };

  const panel = document.getElementById("chat")!;
  const opener = document.querySelector<HTMLButtonElement>("[data-chat-open]")!;
  const log = panel.querySelector<HTMLOListElement>("[data-chat-log]")!;
  const suggestions = panel.querySelector<HTMLElement>("[data-chat-suggestions]")!;
  const form = panel.querySelector<HTMLFormElement>("[data-chat-form]")!;
  const input = panel.querySelector<HTMLTextAreaElement>("#chat-input")!;
  const send = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const history: Message[] = [];
  let pending = false;

  function open() {
    panel.hidden = false;
    opener.hidden = true;
    opener.setAttribute("aria-expanded", "true");
    input.focus();
  }

  function close() {
    panel.hidden = true;
    opener.hidden = false;
    opener.setAttribute("aria-expanded", "false");
    opener.focus();
  }

  // Text only (textContent) — model output is never parsed as HTML.
  function addBubble(role: Message["role"] | "error", text: string) {
    const li = document.createElement("li");
    li.textContent = text;
    li.className =
      role === "user"
        ? "max-w-[85%] self-end whitespace-pre-line rounded-[6px] bg-ph px-3 py-2 text-ink"
        : role === "error"
          ? "max-w-[85%] self-start text-[13px] text-muted"
          : "max-w-[85%] self-start whitespace-pre-line text-ink-soft";
    log.append(li);
    log.scrollTop = log.scrollHeight;
    return li;
  }

  async function ask(question: string) {
    const text = question.trim();
    if (!text || pending) return;
    pending = true;
    send.disabled = true;
    suggestions.hidden = true;
    input.value = "";

    history.push({ role: "user", content: text });
    addBubble("user", text);
    const typing = addBubble("assistant", "…");

    try {
      // The server accepts at most 12 messages. History alternates and ends with the visitor,
      // so the last 11 always start with a user turn.
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history.slice(-11) }),
      });
      const data: { reply?: string; error?: string } = await res.json().catch(() => ({}));
      typing.remove();
      if (!res.ok || !data.reply) throw new Error(data.error ?? "The chat is unavailable right now.");
      history.push({ role: "assistant", content: data.reply });
      addBubble("assistant", data.reply);
    } catch (error) {
      typing.remove();
      history.pop(); // keep history alternating so the next question is still valid
      addBubble("error", error instanceof Error ? error.message : "Something went wrong.");
    } finally {
      pending = false;
      send.disabled = false;
      input.focus();
    }
  }

  opener.addEventListener("click", open);
  panel.querySelector("[data-chat-close]")!.addEventListener("click", close);
  panel.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
  document.addEventListener("chat:open", open);

  suggestions.querySelectorAll("button").forEach((b) => b.addEventListener("click", () => ask(b.textContent ?? "")));
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    ask(input.value);
  });
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      ask(input.value);
    }
  });
</script>
