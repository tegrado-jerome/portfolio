---
import { faArrowUp, faStop, faXmark } from "@fortawesome/free-solid-svg-icons";
import { assistant } from "../data/assistant";
import { site } from "../data/site";
import Icon from "./Icon.astro";
---

<!-- Floating round trigger (after guillaumemaarek.com) opening an editorial side sheet (after chat-sdk.dev, Mintlify).
     Messages are bubbles, mine on the left and the visitor's on the right. The composer follows ChatGPT. -->
<button
  type="button"
  data-chat-open
  aria-controls="chat"
  aria-expanded="false"
  aria-label="Chat with the AI version of me"
  class="group fixed right-4 bottom-4 z-30 hidden size-14 rounded-full border-2 border-paper bg-ink shadow-[0_12px_30px_-10px_rgb(0_0_0/0.45)] transition-transform duration-300 ease-out-soft hover:scale-105 place-items-center in-[.js]:grid sm:right-6 sm:bottom-6"
>
  {
    site.chatAvatar ? (
      <img src={site.chatAvatar} alt="" width="112" height="112" class="size-full rounded-full object-cover" />
    ) : (
      <span class="chat-logo mx-auto block size-8 bg-white" aria-hidden="true" />
    )
  }
  <span
    class="eyebrow pointer-events-none absolute right-full mr-3 rounded-full border border-line bg-paper px-3 py-1.5 text-[10px] whitespace-nowrap text-ink opacity-0 transition-opacity group-hover:opacity-100 max-sm:hidden"
    aria-hidden="true">Ask me</span
  >
</button>

<aside id="chat" class="sheet" aria-labelledby="chat-title">
  <header class="flex items-baseline justify-between border-b border-line pb-4">
    <h2 id="chat-title" class="font-serif text-[30px] leading-none">
      Jerome <span class="text-[18px] text-muted">(AI)</span>
    </h2>
    <button type="button" data-chat-close class="-m-2 p-2 text-muted transition-colors hover:text-ink" aria-label="Close chat">
      <Icon icon={faXmark} class="text-[15px]" />
    </button>
  </header>

  <ol data-chat-log aria-live="polite" class="flex flex-1 flex-col gap-4 overflow-y-auto py-6">
    <li class="msg-ai">
      {
        site.chatAvatar ? (
          <img data-avatar src={site.chatAvatar} alt="" width="56" height="56" class="avatar object-cover" />
        ) : (
          <span data-avatar class="avatar grid place-items-center bg-ink" aria-hidden="true">
            <span class="chat-logo block size-4 bg-paper" />
          </span>
        )
      }
      <p class="bubble">{assistant.greeting}</p>
    </li>
  </ol>

  <ul data-chat-suggestions class="mb-3 space-y-1 text-[13px]">
    {
      assistant.suggestions.map((s) => (
        <li>
          <button type="button" class="text-muted transition-colors hover:text-ink">
            {s}
          </button>
        </li>
      ))
    }
  </ul>

  <form data-chat-form class="composer flex items-end gap-2 rounded-[26px] border border-line py-2 pr-2 pl-5 transition-colors focus-within:border-muted">
    <label for="chat-input" class="sr-only">Your message</label>
    <textarea
      id="chat-input"
      rows="1"
      maxlength="800"
      placeholder="Ask me something…"
      class="max-h-32 flex-1 resize-none self-center bg-transparent py-1.5 text-[16px] leading-[1.4] text-ink placeholder:text-muted focus:outline-none"
    ></textarea>
    <button
      type="submit"
      data-state="send"
      disabled
      aria-label="Send"
      class="grid size-9 shrink-0 place-items-center rounded-full bg-ink text-paper transition-opacity disabled:opacity-25"
    >
      <Icon icon={faArrowUp} class="send-icon text-[14px]" />
      <Icon icon={faStop} class="stop-icon text-[11px]" />
    </button>
  </form>
  <p class="mt-2.5 text-center text-[11px] text-muted">AI answers from my portfolio. May be imperfect.</p>
</aside>

<style>
  .chat-logo {
    mask: url("/images/logo.png") center / contain no-repeat;
  }
  .sheet {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 45;
    display: flex;
    flex-direction: column;
    width: min(420px, 100%);
    padding: 28px;
    background: var(--color-paper);
    border-left: 1px solid var(--color-line);
    visibility: hidden;
    opacity: 0;
    transform: translateX(24px);
    transition:
      opacity 0.24s var(--ease-out-soft),
      transform 0.24s var(--ease-out-soft),
      visibility 0s linear 0.24s;
  }
  .sheet[data-open] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  [data-chat-log] {
    overscroll-behavior: contain;
  }
  /* Me on the left with my photo, the visitor on the right. */
  [data-chat-log] :global(.msg-ai) {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding-right: 36px;
  }
  [data-chat-log] :global(.msg-user) {
    display: flex;
    justify-content: flex-end;
    padding-left: 48px;
  }
  [data-chat-log] :global(.avatar) {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 999px;
  }
  [data-chat-log] :global(.bubble) {
    padding: 10px 14px;
    border-radius: 18px;
    font-size: 15px;
    line-height: 1.5;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  [data-chat-log] :global(.msg-ai .bubble) {
    background: var(--color-ph);
    border-bottom-left-radius: 4px;
  }
  [data-chat-log] :global(.msg-user .bubble) {
    background: var(--color-ink);
    color: var(--color-paper);
    border-bottom-right-radius: 4px;
  }
  .composer {
    background: color-mix(in srgb, var(--color-paper) 45%, white);
  }
  :global([data-theme="dark"]) .composer {
    background: color-mix(in srgb, var(--color-paper) 90%, white);
  }
  [data-state="send"] :global(.stop-icon),
  [data-state="stop"] :global(.send-icon) {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.writing) {
      animation: writing 1.4s ease-in-out infinite;
    }
  }
  @keyframes writing {
    50% {
      opacity: 0.35;
    }
  }
  @media (max-width: 639px) {
    .sheet {
      padding: 20px;
      border-left: 0;
      transform: translateY(24px);
    }
    /* The sheet is full-screen here, so the page behind it must not scroll. */
    :global(html.chat-open),
    :global(html.chat-open body) {
      overflow: hidden;
    }
  }
</style>

<script>
  type Message = { role: "user" | "assistant"; content: string };

  const sheet = document.getElementById("chat")!;
  const log = sheet.querySelector<HTMLOListElement>("[data-chat-log]")!;
  const avatar = log.querySelector("[data-avatar]")!;
  const suggestions = sheet.querySelector<HTMLElement>("[data-chat-suggestions]")!;
  const form = sheet.querySelector<HTMLFormElement>("[data-chat-form]")!;
  const input = sheet.querySelector<HTMLTextAreaElement>("#chat-input")!;
  const send = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const openers = document.querySelectorAll<HTMLButtonElement>("[data-chat-open]");
  const history: Message[] = [];
  let request: AbortController | null = null;
  let returnFocus: HTMLElement | null = null;

  function setOpen(open: boolean) {
    sheet.toggleAttribute("data-open", open);
    document.documentElement.classList.toggle("chat-open", open);
    openers.forEach((b) => {
      b.setAttribute("aria-expanded", String(open));
      b.hidden = open; // the sheet covers the corner; its own close button takes over
    });
    if (open) {
      returnFocus = document.activeElement as HTMLElement | null;
      input.focus();
    } else {
      returnFocus?.focus();
    }
  }

  function syncButton() {
    const busy = request !== null;
    send.dataset.state = busy ? "stop" : "send";
    send.setAttribute("aria-label", busy ? "Stop" : "Send");
    send.disabled = !busy && input.value.trim() === "";
  }

  function growInput() {
    input.style.height = "auto";
    input.style.height = `${input.scrollHeight}px`;
  }

  function paragraph(className: string, text: string) {
    const p = document.createElement("p");
    p.className = className;
    p.textContent = text; // text only — model output is never parsed as HTML
    return p;
  }

  function message(role: Message["role"], bubble: HTMLElement) {
    const li = document.createElement("li");
    li.className = role === "user" ? "msg-user" : "msg-ai";
    if (role === "assistant") li.append(avatar.cloneNode(true));
    li.append(bubble);
    return li;
  }

  async function ask(question: string) {
    const text = question.trim();
    if (!text || request) return;
    suggestions.hidden = true;
    input.value = "";
    growInput();

    history.push({ role: "user", content: text });
    const writing = paragraph("bubble writing text-muted", "writing…");
    log.append(message("user", paragraph("bubble", text)), message("assistant", writing));
    writing.scrollIntoView({ block: "end", behavior: "smooth" });

    request = new AbortController();
    log.setAttribute("aria-busy", "true");
    syncButton();
    try {
      // The server accepts at most 12 messages. History alternates and ends with the visitor,
      // so the last 11 always start with a user turn.
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history.slice(-11) }),
        signal: request.signal,
      });
      const data: { reply?: string; error?: string } = await res.json().catch(() => ({}));
      if (!res.ok || !data.reply) throw new Error(data.error ?? "The chat is unavailable right now.");
      history.push({ role: "assistant", content: data.reply });
      writing.replaceWith(paragraph("bubble", data.reply));
    } catch (error) {
      history.pop(); // keep history alternating so the next question is still valid
      const stopped = error instanceof DOMException && error.name === "AbortError";
      writing.replaceWith(
        paragraph("bubble text-muted", stopped ? "Stopped." : error instanceof Error ? error.message : "Something went wrong."),
      );
    } finally {
      request = null;
      log.removeAttribute("aria-busy");
      syncButton();
      input.focus();
    }
  }

  openers.forEach((b) => b.addEventListener("click", () => setOpen(!sheet.hasAttribute("data-open"))));
  sheet.querySelector("[data-chat-close]")!.addEventListener("click", () => setOpen(false));
  sheet.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
  document.addEventListener("chat:open", () => setOpen(true));

  suggestions.querySelectorAll("button").forEach((b) => b.addEventListener("click", () => ask(b.textContent ?? "")));
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (request) request.abort();
    else ask(input.value);
  });
  input.addEventListener("input", () => {
    growInput();
    syncButton();
  });
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      ask(input.value);
    }
  });
</script>
