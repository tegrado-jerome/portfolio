---
import { faComment, faXmark } from "@fortawesome/free-solid-svg-icons";
import { assistant } from "../data/assistant";
import Icon from "./Icon.astro";
---

<!-- Floating round trigger (after guillaumemaarek.com) opening an editorial side sheet (after chat-sdk.dev, Mintlify). -->
<button
  type="button"
  data-chat-open
  aria-controls="chat"
  aria-expanded="false"
  aria-label="Chat with the AI version of me"
  class="group fixed right-4 bottom-4 z-30 hidden size-12 place-items-center rounded-full border border-ink bg-paper text-ink shadow-[0_10px_30px_-12px_rgb(0_0_0/0.45)] transition-colors hover:bg-ink hover:text-paper in-[.js]:grid sm:right-6 sm:bottom-6"
>
  <Icon icon={faComment} class="text-[17px]" />
  <span
    class="eyebrow pointer-events-none absolute right-full mr-3 rounded-full border border-line bg-paper px-3 py-1.5 text-[10px] whitespace-nowrap text-ink opacity-0 transition-opacity group-hover:opacity-100 max-sm:hidden"
    aria-hidden="true">Ask me</span
  >
</button>

<aside id="chat" class="sheet" aria-labelledby="chat-title">
  <header class="flex items-baseline justify-between border-b border-line pb-4">
    <h2 id="chat-title" class="font-serif text-[30px] leading-none">
      Jerome <span class="text-[18px] text-muted">(AI)</span>
    </h2>
    <button type="button" data-chat-close class="-m-2 p-2 text-muted transition-colors hover:text-ink" aria-label="Close chat">
      <Icon icon={faXmark} class="text-[15px]" />
    </button>
  </header>

  <ol data-chat-log aria-live="polite" class="flex-1 space-y-6 overflow-y-auto pt-6 text-[15px] leading-[1.6]">
    <li>
      <p class="eyebrow mb-1.5 text-[10px] text-accent">Jerome, AI</p>
      <p class="text-ink-soft">{assistant.greeting}</p>
    </li>
  </ol>

  <ul data-chat-suggestions class="mb-3 space-y-1 text-[13px]">
    {
      assistant.suggestions.map((s) => (
        <li>
          <button type="button" class="text-muted transition-colors hover:text-ink">
            {s}
          </button>
        </li>
      ))
    }
  </ul>

  <form data-chat-form class="flex items-end gap-3 border border-line p-3.5 focus-within:border-accent">
    <label for="chat-input" class="sr-only">Your message</label>
    <textarea
      id="chat-input"
      rows="1"
      maxlength="800"
      placeholder="Ask me something…"
      class="max-h-32 flex-1 resize-none bg-transparent text-[15px] text-ink placeholder:text-muted focus:outline-none"
    ></textarea>
    <button type="submit" class="shrink-0 text-[11px] text-muted transition-colors hover:text-accent disabled:opacity-40">
      ↵ send
    </button>
  </form>
  <p class="mt-2.5 text-[11px] text-muted">AI answers from my portfolio. May be imperfect.</p>
</aside>

<style>
  .sheet {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 45;
    display: flex;
    flex-direction: column;
    width: min(420px, 100%);
    padding: 28px;
    background: var(--color-paper);
    border-left: 1px solid var(--color-line);
    visibility: hidden;
    opacity: 0;
    transform: translateX(24px);
    transition:
      opacity 0.24s var(--ease-out-soft),
      transform 0.24s var(--ease-out-soft),
      visibility 0s linear 0.24s;
  }
  .sheet[data-open] {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  @media (max-width: 639px) {
    .sheet {
      padding: 20px;
      border-left: 0;
      transform: translateY(24px);
    }
  }
</style>

<script>
  type Message = { role: "user" | "assistant"; content: string };

  const sheet = document.getElementById("chat")!;
  const log = sheet.querySelector<HTMLOListElement>("[data-chat-log]")!;
  const suggestions = sheet.querySelector<HTMLElement>("[data-chat-suggestions]")!;
  const form = sheet.querySelector<HTMLFormElement>("[data-chat-form]")!;
  const input = sheet.querySelector<HTMLTextAreaElement>("#chat-input")!;
  const send = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const openers = document.querySelectorAll<HTMLButtonElement>("[data-chat-open]");
  const history: Message[] = [];
  let pending = false;
  let returnFocus: HTMLElement | null = null;

  function setOpen(open: boolean) {
    sheet.toggleAttribute("data-open", open);
    openers.forEach((b) => {
      b.setAttribute("aria-expanded", String(open));
      b.hidden = open; // the sheet covers the corner; its own close button takes over
    });
    if (open) {
      returnFocus = document.activeElement as HTMLElement | null;
      input.focus();
    } else {
      returnFocus?.focus();
    }
  }

  // Text only (textContent) — model output is never parsed as HTML.
  function addMessage(role: Message["role"] | "error", text: string) {
    const li = document.createElement("li");
    const label = document.createElement("p");
    const body = document.createElement("p");
    label.className = "eyebrow mb-1.5 text-[10px] text-accent";
    label.textContent = role === "user" ? "You" : "Jerome, AI";
    body.className = role === "user" ? "whitespace-pre-line text-ink" : "whitespace-pre-line text-ink-soft";
    body.textContent = text;
    if (role === "error") {
      body.className = "text-[13px] text-muted";
      li.append(body);
    } else {
      li.append(label, body);
    }
    log.append(li);
    log.scrollTop = log.scrollHeight;
    return li;
  }

  async function ask(question: string) {
    const text = question.trim();
    if (!text || pending) return;
    pending = true;
    send.disabled = true;
    suggestions.hidden = true;
    input.value = "";

    history.push({ role: "user", content: text });
    addMessage("user", text);
    const thinking = addMessage("assistant", "…");

    try {
      // The server accepts at most 12 messages. History alternates and ends with the visitor,
      // so the last 11 always start with a user turn.
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history.slice(-11) }),
      });
      const data: { reply?: string; error?: string } = await res.json().catch(() => ({}));
      thinking.remove();
      if (!res.ok || !data.reply) throw new Error(data.error ?? "The chat is unavailable right now.");
      history.push({ role: "assistant", content: data.reply });
      addMessage("assistant", data.reply);
    } catch (error) {
      thinking.remove();
      history.pop(); // keep history alternating so the next question is still valid
      addMessage("error", error instanceof Error ? error.message : "Something went wrong.");
    } finally {
      pending = false;
      send.disabled = false;
      input.focus();
    }
  }

  openers.forEach((b) => b.addEventListener("click", () => setOpen(!sheet.hasAttribute("data-open"))));
  sheet.querySelector("[data-chat-close]")!.addEventListener("click", () => setOpen(false));
  sheet.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
  document.addEventListener("chat:open", () => setOpen(true));

  suggestions.querySelectorAll("button").forEach((b) => b.addEventListener("click", () => ask(b.textContent ?? "")));
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    ask(input.value);
  });
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      ask(input.value);
    }
  });
</script>
