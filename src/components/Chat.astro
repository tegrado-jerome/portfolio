---
import { faArrowTurnDown, faXmark } from "@fortawesome/free-solid-svg-icons";
import { assistant } from "../data/assistant";
import { site } from "../data/site";
import Icon from "./Icon.astro";
---

<!-- Floating round trigger (after guillaumemaarek.com) opening an editorial side sheet (after chat-sdk.dev, Mintlify).
     Messages are bubbles, mine on the left and the visitor's on the right. The composer follows ChatGPT. -->
<button
  type="button"
  data-chat-open
  aria-controls="chat"
  aria-expanded="false"
  aria-label="Chat with me"
  class="chat-fab is-tucked group fixed right-4 bottom-4 z-30 hidden size-14 rounded-full border-2 border-paper bg-ink shadow-[0_12px_30px_-10px_rgb(0_0_0/0.45)] place-items-center in-[.js]:grid sm:right-6 sm:bottom-6"
>
  {
    site.chatAvatar ? (
      <img src={site.chatAvatar} alt="" width="112" height="112" class="size-full rounded-full object-cover" />
    ) : (
      <span class="chat-logo mx-auto block size-8 bg-white" aria-hidden="true" />
    )
  }
  <span
    class="eyebrow pointer-events-none absolute right-full mr-3 rounded-[2px] border border-line bg-paper px-3 py-1.5 whitespace-nowrap text-ink opacity-0 transition-opacity group-hover:opacity-100 max-sm:hidden"
    aria-hidden="true">Ask me</span
  >
</button>

<aside id="chat" class="sheet" role="dialog" aria-labelledby="chat-title" tabindex="-1">
  <p id="chat-keys" class="sr-only">Enter to send, Shift and Enter for a new line, Escape to close.</p>
  <!-- Laid out like Messenger's chat header: photo with an online dot, name, status underneath. -->
  <header class="flex items-center justify-between border-b border-line pb-4">
    <div class="flex items-center gap-3">
      <span class="relative shrink-0">
        {
          site.chatAvatar ? (
            <img src={site.chatAvatar} alt="" width="80" height="80" class="size-10 rounded-full object-cover" />
          ) : (
            <span class="grid size-10 place-items-center rounded-full bg-ink">
              <span class="chat-logo block size-5 bg-paper" />
            </span>
          )
        }
        <span class="online-badge" aria-hidden="true"></span>
      </span>
      <div>
        <h2 id="chat-title" class="text-heading leading-none">jerome</h2>
        <p class="mt-1 text-small text-muted">Online</p>
      </div>
    </div>
    <button type="button" data-chat-close class="-m-2 p-2 text-muted transition-colors hover:text-ink" aria-label="Close chat">
      <Icon icon={faXmark} class="text-[15px]" />
    </button>
  </header>

  <ol data-chat-log aria-live="polite" class="mb-3 flex flex-1 flex-col gap-4 overflow-y-auto py-6">
    <!-- Like Messenger, the thread opens with my profile, and it stays at the top of the conversation. -->
    <li class="flex flex-col items-center gap-1.5 pt-6 pb-4 text-center">
      {
        site.chatAvatar ? (
          <img src={site.chatAvatar} alt="" width="152" height="152" class="mb-2 size-[76px] rounded-full object-cover" />
        ) : (
          <span class="mb-2 grid size-[76px] place-items-center rounded-full bg-ink" aria-hidden="true">
            <span class="chat-logo block size-8 bg-paper" />
          </span>
        )
      }
      <p class="text-heading">{site.name.toLowerCase().replace(" ", "-")}</p>
      <p class="text-small text-muted">Online</p>
    </li>
    <!-- Quick replies (Messenger's icebreakers): outlined bubbles on the visitor's side. They sit at the bottom of the
         thread and scroll with it. -->
    <li data-chat-suggestions class="mt-auto">
      <ul class="flex flex-col items-end gap-2">
        {
          assistant.suggestions.map((s) => (
            <li>
              <button
                type="button"
                class="rounded-[2px] border border-ink px-3 py-1.5 text-small text-ink transition-colors duration-200 hover:bg-ink hover:text-paper"
              >
                {s}
              </button>
            </li>
          ))
        }
      </ul>
    </li>
  </ol>
  <!-- My avatar, copied next to each of my replies. -->
  <template data-avatar>
    {
      site.chatAvatar ? (
        <img src={site.chatAvatar} alt="" width="56" height="56" class="avatar object-cover" />
      ) : (
        <span class="avatar grid place-items-center bg-ink" aria-hidden="true">
          <span class="chat-logo block size-4 bg-paper" />
        </span>
      )
    }
  </template>

  <form data-chat-form class="composer flex items-end gap-2 rounded-[4px] border border-line py-2 pr-2 pl-4">
    <label for="chat-input" class="sr-only">Your message</label>
    <textarea
      id="chat-input"
      rows="1"
      maxlength="800"
      enterkeyhint="send"
      autocapitalize="sentences"
      aria-describedby="chat-keys"
      placeholder="Ask me something…"
      class="max-h-32 flex-1 resize-none self-center bg-transparent py-1.5 text-[16px] leading-[1.4] text-ink placeholder:text-muted focus:outline-none"
    ></textarea>
    <button
      type="submit"
      data-state="send"
      disabled
      aria-label="Send"
      class="send grid h-9 shrink-0 place-items-center px-1 transition-opacity duration-200 disabled:opacity-35"
    >
      <!-- A keycap like the hero prompt bar's: ↵ to send, "■ stop" while I'm replying. -->
      <kbd class="key">
        <Icon icon={faArrowTurnDown} class="send-icon rotate-90 text-[12px]" />
        <span class="stop-icon"><span class="stop-square"></span>stop</span>
      </kbd>
    </button>
  </form>
  <!-- Always one line: on narrow phones the size follows the screen width so it fits. -->
  <p class="mt-2.5 text-center text-small whitespace-nowrap text-muted max-sm:text-[clamp(10px,3.2vw,13px)]">Replies are AI-generated from my portfolio.</p>
</aside>

<style>
  /* The round chat button tucks away while the hero's prompt bar is on screen (it does the same job there),
     and gently fades back in once you scroll past it. */
  .chat-fab {
    transition:
      opacity 0.5s var(--ease-out-soft),
      translate 0.5s var(--ease-out-soft),
      scale 0.3s var(--ease-out-soft);
  }
  .chat-fab:hover {
    scale: 1.05;
  }
  .chat-fab.is-tucked {
    opacity: 0;
    translate: 0 12px;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 0.5s var(--ease-out-soft),
      translate 0.5s var(--ease-out-soft),
      visibility 0s linear 0.5s;
  }
  /* Hidden while the chat is open (the sheet's close button takes over), fading out as the sheet slides in. */
  .chat-fab.is-covered {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s var(--ease-out-soft),
      visibility 0s linear 0.2s;
  }
  .online-badge {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 12px;
    height: 12px;
    border: 2px solid var(--color-paper);
    border-radius: 50%;
    background: var(--color-online);
  }
  .chat-logo {
    mask: url("/images/logo.png") center / contain no-repeat;
  }
  .sheet {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 45;
    display: flex;
    flex-direction: column;
    width: min(420px, 100%);
    padding: 28px;
    background: var(--color-paper);
    border-left: 1px solid var(--color-line);
    visibility: hidden;
    /* Slides in from the edge on the iOS sheet curve (as in Vaul): quick to start, long soft landing.
       Closing runs a little faster than opening. */
    transform: translateX(100%);
    box-shadow: 0 0 0 transparent;
    transition:
      transform 0.38s var(--ease-sheet),
      box-shadow 0.38s var(--ease-sheet),
      visibility 0s linear 0.38s;
    will-change: transform;
    --ease-sheet: cubic-bezier(0.32, 0.72, 0, 1);
  }
  .sheet[data-open] {
    visibility: visible;
    transform: none;
    box-shadow: -24px 0 60px -30px rgb(0 0 0 / 0.25);
    transition:
      transform 0.5s var(--ease-sheet),
      box-shadow 0.5s var(--ease-sheet),
      visibility 0s;
  }
  /* The sheet itself takes focus on open (so phones don't raise the keyboard); it needs no ring. */
  .sheet:focus {
    outline: none;
  }
  [data-chat-log] {
    overscroll-behavior: contain;
  }
  /* Me on the left with my photo, the visitor on the right. */
  [data-chat-log] :global(.msg-ai) {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding-right: 36px;
  }
  [data-chat-log] :global(.msg-user) {
    display: flex;
    justify-content: flex-end;
    padding-left: 48px;
  }
  [data-chat-log] :global(.avatar) {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 999px;
  }
  [data-chat-log] :global(.bubble) {
    padding: 10px 14px;
    border-radius: 4px;
    font-size: 15px;
    line-height: 1.5;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  [data-chat-log] :global(.msg-ai .bubble) {
    background: var(--color-ph);
    border-bottom-left-radius: 4px;
    white-space: normal;
  }
  /* Rendered replies (src/scripts/markdown.ts): bold, italics, lists, tables, code. */
  [data-chat-log] :global(.msg-ai .bubble:not(.typing-dots) > * + *) {
    margin-top: 0.6em;
  }
  [data-chat-log] :global(.bubble strong),
  [data-chat-log] :global(.bubble .md-heading) {
    font-weight: 600;
  }
  [data-chat-log] :global(.bubble ul),
  [data-chat-log] :global(.bubble ol) {
    padding-left: 1.25em;
  }
  [data-chat-log] :global(.bubble ul) {
    list-style: disc;
  }
  [data-chat-log] :global(.bubble ol) {
    list-style: decimal;
  }
  [data-chat-log] :global(.bubble li + li) {
    margin-top: 0.25em;
  }
  [data-chat-log] :global(.bubble code),
  [data-chat-log] :global(.bubble pre) {
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    font-size: 0.9em;
  }
  [data-chat-log] :global(.bubble code) {
    padding: 0.1em 0.35em;
  }
  [data-chat-log] :global(.bubble pre) {
    padding: 8px 10px;
    overflow-x: auto;
    white-space: pre;
  }
  [data-chat-log] :global(.md-table) {
    overflow-x: auto;
  }
  [data-chat-log] :global(.bubble table) {
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.4;
  }
  [data-chat-log] :global(.bubble th),
  [data-chat-log] :global(.bubble td) {
    padding: 5px 8px;
    border: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
    /* Words stay whole in cells; a wide table scrolls sideways instead. */
    overflow-wrap: normal;
  }
  [data-chat-log] :global(.bubble th) {
    font-weight: 600;
  }
  [data-chat-log] :global(.show-chip) {
    height: 28px;
    margin-left: -8px;
    color: var(--color-accent);
  }
  /* The chip's accent text would otherwise win over tui-btn's inverted hover and turn unreadable. */
  [data-chat-log] :global(.show-chip:hover),
  [data-chat-log] :global(.show-chip:focus-visible) {
    color: var(--color-paper);
  }
  [data-chat-log] :global(.md-link) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* My email: in the accent colour, bolder, and always on one line. It shrinks with the screen so it fits the bubble. */
  [data-chat-log] :global(.md-email) {
    color: var(--color-accent);
    font-weight: 600;
    font-size: min(1em, 3.6vw);
    white-space: nowrap;
    overflow-wrap: normal;
    transition: opacity 0.2s ease;
  }
  [data-chat-log] :global(.md-email:hover) {
    opacity: 0.75;
  }
  [data-chat-log] :global(.msg-user .bubble) {
    background: var(--color-ink);
    color: var(--color-paper);
    border-bottom-right-radius: 4px;
  }
  /* Same states as the hero ask bar: idle light border, hover darker, focused ink border with a soft ring. */
  .composer {
    background: color-mix(in srgb, var(--color-paper) 45%, white);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .composer:hover {
    border-color: var(--color-muted);
  }
  .composer:focus-within {
    border-color: var(--color-ink);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-ink) 8%, transparent);
  }
  .composer textarea:focus-visible {
    outline: none;
  }
  :global([data-theme="dark"]) .composer {
    background: color-mix(in srgb, var(--color-paper) 90%, white);
  }
  .send .key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 26px;
    padding-inline: 6px;
    border: 1px solid var(--color-line);
    border-radius: 5px;
    background: var(--color-paper);
    box-shadow: 0 1px 0 var(--color-line);
    color: var(--color-ink);
    font: 500 var(--text-label) / 1 var(--font-mono);
    transition: border-color 0.2s ease;
  }
  .send:not(:disabled):hover .key,
  .send[data-state="stop"] .key {
    border-color: var(--color-ink);
  }
  .stop-icon {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .stop-square {
    width: 8px;
    height: 8px;
    border-radius: 1.5px;
    background: currentColor;
  }
  [data-state="send"] :global(.stop-icon),
  [data-state="stop"] :global(.send-icon) {
    display: none;
  }
  /* "Typing" dots while the reply is on its way. */
  [data-chat-log] :global(.typing-dots) {
    display: flex;
    gap: 4px;
    padding-block: 16px;
  }
  [data-chat-log] :global(.typing-dots span) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-muted);
  }
  /* The reply fades in word by word. A word (and the blocks around it) stays out of the layout until its turn. */
  [data-chat-log] :global(.pending) {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-chat-log] :global(.typing-dots span) {
      animation: typing-dot 1.2s ease-in-out infinite;
    }
    [data-chat-log] :global(.typing-dots span:nth-child(2)) {
      animation-delay: 0.15s;
    }
    [data-chat-log] :global(.typing-dots span:nth-child(3)) {
      animation-delay: 0.3s;
    }
    [data-chat-log] :global(.word) {
      animation: word-in 0.6s ease-out both;
    }
  }
  @keyframes typing-dot {
    0%,
    60%,
    100% {
      translate: 0 0;
      opacity: 0.4;
    }
    30% {
      translate: 0 -4px;
      opacity: 1;
    }
  }
  @keyframes word-in {
    from {
      opacity: 0;
      filter: blur(3px);
    }
  }
  @media (max-width: 639px) {
    .sheet {
      padding: 20px;
      border-left: 0;
      transform: translateY(100%);
    }
    /* More room for my replies, so an email address fits on one line. */
    [data-chat-log] :global(.msg-ai) {
      padding-right: 12px;
    }
    /* The sheet is full-screen here, so the page behind it must not scroll. */
    :global(html.chat-open),
    :global(html.chat-open body) {
      overflow: hidden;
    }
  }
</style>

<script>
  import { markdown } from "../scripts/markdown";
  import { findTarget, pointTo } from "../scripts/point";
  import { play } from "../scripts/sound";

  type Message = { role: "user" | "assistant"; content: string };

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  // A reply never shows sooner than 4s after sending, and the typing dots wait half a second before they appear,
  // like a person reading then answering. Sending is locked until the reply is done, so this also paces visitors
  // to one message every few seconds at most.
  const MIN_REPLY_DELAY = 4000; // ms
  const TYPING_DOTS_DELAY = 500; // ms

  // Resolves after `ms`, or straight away once the visitor presses stop.
  function wait(ms: number, signal: AbortSignal) {
    return new Promise<void>((resolve) => {
      if (ms <= 0 || signal.aborted) return resolve();
      const timer = setTimeout(resolve, ms);
      signal.addEventListener("abort", () => (clearTimeout(timer), resolve()), { once: true });
    });
  }

  const sheet = document.getElementById("chat")!;
  const log = sheet.querySelector<HTMLOListElement>("[data-chat-log]")!;
  const avatar = sheet.querySelector<HTMLTemplateElement>("template[data-avatar]")!.content.firstElementChild!;
  const suggestions = sheet.querySelector<HTMLElement>("[data-chat-suggestions]")!;
  const form = sheet.querySelector<HTMLFormElement>("[data-chat-form]")!;
  const input = sheet.querySelector<HTMLTextAreaElement>("#chat-input")!;
  const send = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const openers = document.querySelectorAll<HTMLButtonElement>("[data-chat-open]");
  const history: Message[] = [];
  let request: AbortController | null = null;
  let returnFocus: HTMLElement | null = null;

  function setOpen(open: boolean) {
    sheet.toggleAttribute("data-open", open);
    document.documentElement.classList.toggle("chat-open", open);
    openers.forEach((b) => {
      b.setAttribute("aria-expanded", String(open));
      b.classList.toggle("is-covered", open); // the sheet covers the corner; its own close button takes over
    });
    if (open) {
      // Focus the sheet, not the text field: on phones the keyboard only comes up once the visitor taps the field.
      returnFocus = document.activeElement as HTMLElement | null;
      sheet.focus({ preventScroll: true });
    } else {
      returnFocus?.focus();
    }
    fitToViewport();
  }

  // "Stick to bottom", like ChatGPT and Messenger: the log follows new text only while the visitor is at the
  // bottom. Scrolling up to read turns that off, so it never fights them; scrolling back down turns it on.
  let stickToBottom = true;
  log.addEventListener(
    "scroll",
    () => (stickToBottom = log.scrollHeight - log.scrollTop - log.clientHeight < 40),
    { passive: true },
  );
  function toBottom(smooth = false) {
    log.scrollTo({ top: log.scrollHeight, behavior: smooth && !reduceMotion ? "smooth" : "auto" });
  }

  // Phones: the on-screen keyboard shrinks the visible area without resizing the page (iOS especially), so the
  // sheet is sized to the visible viewport, keeping the input just above the keyboard and the latest message
  // in view.
  const phone = matchMedia("(max-width: 639px)");
  const viewport = window.visualViewport;
  function fitToViewport() {
    if (!viewport || !phone.matches || !sheet.hasAttribute("data-open")) {
      sheet.style.removeProperty("height");
      sheet.style.removeProperty("top");
      return;
    }
    sheet.style.top = `${viewport.offsetTop}px`;
    sheet.style.height = `${viewport.height}px`;
    if (stickToBottom) toBottom();
  }
  viewport?.addEventListener("resize", fitToViewport);
  viewport?.addEventListener("scroll", fitToViewport);
  input.addEventListener("focus", () => {
    // Once the keyboard has slid up, bring the latest message back into view.
    setTimeout(() => {
      fitToViewport();
      if (stickToBottom) toBottom();
    }, 300);
  });

  function syncButton() {
    const busy = request !== null;
    send.dataset.state = busy ? "stop" : "send";
    send.setAttribute("aria-label", busy ? "Stop" : "Send");
    send.disabled = !busy && input.value.trim() === "";
  }

  function growInput() {
    input.style.height = "auto";
    input.style.height = `${input.scrollHeight}px`;
  }

  function paragraph(className: string, text: string) {
    const p = document.createElement("p");
    p.className = className;
    p.textContent = text; // text only — model output is never parsed as HTML
    return p;
  }

  function typingDots() {
    const bubble = document.createElement("div");
    bubble.className = "bubble typing-dots";
    bubble.setAttribute("aria-label", "Jerome is typing");
    bubble.append(...Array.from({ length: 3 }, () => document.createElement("span")));
    return bubble;
  }

  // Wraps every word of the rendered reply in a hidden span, and hides the blocks around it too, so nothing
  // (not even an empty bullet) shows before its first word. Returns the words in reading order.
  function wrapWords(root: Node) {
    const texts: Text[] = [];
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    while (walker.nextNode()) texts.push(walker.currentNode as Text);
    const words: HTMLElement[] = [];
    for (const node of texts) {
      if (!node.data.trim()) continue;
      const parts = node.data.split(/(\s+)/).map((part) => {
        if (!part || /^\s+$/.test(part)) return part;
        const word = Object.assign(document.createElement("span"), { className: "word pending", textContent: part });
        words.push(word);
        return word;
      });
      for (let el = node.parentElement; el && el !== root; el = el.parentElement) el.classList.add("pending");
      node.replaceWith(...parts.filter(Boolean));
    }
    return words;
  }

  // Shows a word, and the blocks it sits in.
  function reveal(word: HTMLElement, root: HTMLElement) {
    for (let el: HTMLElement | null = word; el && el !== root; el = el.parentElement) el.classList.remove("pending");
  }

  // Fades the reply in word by word, about 25 words a second, speeding up so even long replies finish in about 3s.
  // Each word eases in from a soft blur. Timed by the clock, not by frames, so it runs the same on 60 Hz and 120 Hz.
  // Stopping mid-way shows the rest at once: the reply is already complete, only its display is animated.
  function typeOut(bubble: HTMLElement, text: string, signal: AbortSignal) {
    bubble.replaceChildren(markdown(text));
    if (reduceMotion) return Promise.resolve();
    const words = wrapWords(bubble);
    const step = Math.min(40, 3000 / words.length); // ms per word
    const start = performance.now();
    let shown = 0;
    return new Promise<void>((resolve) => {
      const frame = (now: number) => {
        const target = signal.aborted ? words.length : Math.min(words.length, Math.floor((now - start) / step) + 1);
        for (; shown < target; shown++) reveal(words[shown], bubble);
        if (stickToBottom) toBottom();
        if (shown >= words.length) resolve();
        else requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    });
  }

  // A reply that's about part of the page scrolls there (laptops and up, where the page shows beside the chat) and
  // gets a chip to go back to it. On phones the chat covers the page, so the chip closes it first.
  function showChip(bubble: HTMLElement, target: string, auto: boolean) {
    if (!findTarget(target)) return;
    const chip = document.createElement("button");
    chip.type = "button";
    chip.className = "show-chip tui-btn inline-flex";
    chip.textContent = `[ cd ~/${target === "top" ? "" : target} ]`;
    chip.addEventListener("click", () => {
      if (phone.matches) setOpen(false);
      pointTo(target);
    });
    bubble.append(chip);
    if (auto && !phone.matches) pointTo(target);
  }

  function message(role: Message["role"], bubble: HTMLElement) {
    const li = document.createElement("li");
    li.className = role === "user" ? "msg-user" : "msg-ai";
    if (role === "assistant") li.append(avatar.cloneNode(true));
    li.append(bubble);
    return li;
  }

  async function ask(question: string) {
    const text = question.trim();
    if (!text || request) return;
    // Only a visitor already typing gets the field back afterwards; tapping a quick reply never raises the keyboard.
    const refocus = document.activeElement === input || document.activeElement === send;
    suggestions.hidden = true;
    input.value = "";
    growInput();

    play("send");
    history.push({ role: "user", content: text });
    const reply = message("assistant", typingDots());
    log.append(message("user", paragraph("bubble", text)));
    // Sending always jumps to your own message, like chat apps do.
    stickToBottom = true;
    toBottom(true);

    request = new AbortController();
    const { signal } = request;
    const askedAt = performance.now();
    log.setAttribute("aria-busy", "true");
    syncButton();
    const showDots = setTimeout(() => {
      log.append(reply);
      if (stickToBottom) toBottom(true);
    }, TYPING_DOTS_DELAY);
    const bubble = () => reply.lastElementChild as HTMLElement;
    try {
      // The server accepts at most 12 messages. History alternates and ends with the visitor,
      // so the last 11 always start with a user turn.
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history.slice(-11) }),
        signal,
      });
      const data: { reply?: string; show?: string; error?: string } = await res.json().catch(() => ({}));
      if (!res.ok || !data.reply) throw new Error(data.error ?? "Chat's down right now. Try again later.");
      history.push({ role: "assistant", content: data.reply });
      await wait(MIN_REPLY_DELAY - (performance.now() - askedAt), signal);
      clearTimeout(showDots);
      if (!reply.isConnected) log.append(reply);
      const text = document.createElement("div");
      text.className = "bubble";
      bubble().replaceWith(text);
      await typeOut(text, data.reply, signal);
      if (data.show) showChip(text, data.show, !signal.aborted);
    } catch (error) {
      history.pop(); // keep history alternating so the next question is still valid
      clearTimeout(showDots);
      if (!reply.isConnected) log.append(reply);
      const stopped = error instanceof DOMException && error.name === "AbortError";
      bubble().replaceWith(
        paragraph("bubble text-muted", stopped ? "Stopped." : error instanceof Error ? error.message : "Something broke. Try again."),
      );
    } finally {
      request = null;
      log.removeAttribute("aria-busy");
      syncButton();
      if (refocus) input.focus();
    }
  }

  // Scrolling over the open sheet moves only the chat, never the page behind it.
  // Only the log and the composer scroll; at their ends (or anywhere else on the sheet) the gesture stops.
  function canScroll(target: EventTarget | null, deltaY: number) {
    const el = (target as Element | null)?.closest<HTMLElement>("[data-chat-log], textarea");
    if (!el) return false;
    return deltaY < 0 ? el.scrollTop > 0 : el.scrollTop + el.clientHeight < el.scrollHeight - 1;
  }
  let touchY = 0;
  sheet.addEventListener(
    "wheel",
    (e) => {
      if (!canScroll(e.target, e.deltaY)) e.preventDefault();
    },
    { passive: false },
  );
  sheet.addEventListener("touchstart", (e) => (touchY = e.touches[0].clientY), { passive: true });
  sheet.addEventListener(
    "touchmove",
    (e) => {
      const y = e.touches[0].clientY;
      if (!canScroll(e.target, touchY - y)) e.preventDefault();
      touchY = y;
    },
    { passive: false },
  );

  openers.forEach((b) => b.addEventListener("click", () => setOpen(!sheet.hasAttribute("data-open"))));
  sheet.querySelector("[data-chat-close]")!.addEventListener("click", () => setOpen(false));
  sheet.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });
  document.addEventListener("chat:open", () => setOpen(true));
  // Questions asked from elsewhere on the page (the hero prompt bar) open the chat and send.
  // Tuck the round button away while the hero prompt bar is visible. It starts tucked so it doesn't flash on load;
  // pages without the prompt bar show it right away.
  const heroAsk = document.querySelector("[data-hero-ask]");
  if (heroAsk) {
    new IntersectionObserver(([entry]) => {
      openers.forEach((b) => b.classList.toggle("is-tucked", entry.isIntersecting));
    }).observe(heroAsk);
  } else {
    openers.forEach((b) => b.classList.remove("is-tucked"));
  }
  document.addEventListener("chat:ask", (e) => {
    setOpen(true);
    ask((e as CustomEvent<string>).detail);
  });

  suggestions.querySelectorAll("button").forEach((b) => b.addEventListener("click", () => ask(b.textContent ?? "")));
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (request) request.abort();
    else ask(input.value);
  });
  input.addEventListener("input", () => {
    growInput();
    syncButton();
  });
  input.addEventListener("keydown", (e) => {
    // Enter sends, Shift+Enter is a new line. Not while an IME (Chinese, Japanese, Korean) is composing a word.
    if (e.key.length === 1 || e.key === "Backspace") play("key");
    if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      ask(input.value);
    }
  });
</script>
