---
import { faArrowTurnDown, faXmark } from "@fortawesome/free-solid-svg-icons";
import { assistant } from "../data/assistant";
import { site } from "../data/site";
import Icon from "./Icon.astro";
---

<!-- Floating round trigger (after guillaumemaarek.com) opening an editorial side sheet (after chat-sdk.dev, Mintlify).
     Messages are bubbles, mine on the left and the visitor's on the right. The composer follows ChatGPT. -->
<button
  type="button"
  data-chat-open
  aria-controls="chat"
  aria-expanded="false"
  aria-label="Chat with me"
  class="chat-fab is-tucked group fixed right-4 bottom-4 z-30 hidden size-14 rounded-full border-2 border-paper bg-ink shadow-[0_12px_30px_-10px_rgb(0_0_0/0.45)] place-items-center in-[.js]:grid sm:right-6 sm:bottom-6"
>
  {
    site.chatAvatar ? (
      <img src={site.chatAvatar} alt="" width="112" height="112" class="size-full rounded-full object-cover" />
    ) : (
      <span class="chat-logo mx-auto block size-8 bg-white" aria-hidden="true" />
    )
  }
  <span
    class="eyebrow pointer-events-none absolute right-full mr-3 rounded-[2px] border border-line bg-paper px-3 py-1.5 whitespace-nowrap text-ink opacity-0 transition-opacity group-hover:opacity-100 max-sm:hidden"
    aria-hidden="true">Ask me</span
  >
</button>

<aside id="chat" class="sheet" role="dialog" aria-labelledby="chat-title" tabindex="-1">
  <p id="chat-keys" class="sr-only">
    Enter to send, Shift and Enter for a new line, Up arrow for your earlier questions, Escape to close.
  </p>
  <!-- Laid out like Messenger's chat header: photo with an online dot, name, status underneath. -->
  <header class="flex items-center justify-between border-b border-line pb-4">
    <div class="flex items-center gap-3">
      <span class="relative shrink-0">
        {
          site.chatAvatar ? (
            <img src={site.chatAvatar} alt="" width="80" height="80" class="size-10 rounded-full object-cover" />
          ) : (
            <span class="grid size-10 place-items-center rounded-full bg-ink">
              <span class="chat-logo block size-5 bg-paper" />
            </span>
          )
        }
        <span class="online-badge" aria-hidden="true"></span>
      </span>
      <div>
        <h2 id="chat-title" class="text-heading leading-none">jerome</h2>
        <p class="mt-1 text-small text-muted">Online</p>
      </div>
    </div>
    <button type="button" data-chat-close class="-m-2 p-2 text-muted transition-colors hover:text-ink" aria-label="Close chat">
      <Icon icon={faXmark} class="text-[15px]" />
    </button>
  </header>

  <ol data-chat-log role="log" aria-live="polite" class="mb-3 flex flex-1 flex-col gap-4 overflow-y-auto py-6">
    <!-- Like Messenger, the thread opens with my profile, and it stays at the top of the conversation. -->
    <li class="flex flex-col items-center gap-1.5 pt-6 pb-4 text-center">
      {
        site.chatAvatar ? (
          <img src={site.chatAvatar} alt="" width="152" height="152" class="mb-2 size-[76px] rounded-full object-cover" />
        ) : (
          <span class="mb-2 grid size-[76px] place-items-center rounded-full bg-ink" aria-hidden="true">
            <span class="chat-logo block size-8 bg-paper" />
          </span>
        )
      }
      <p class="text-heading">{site.name.toLowerCase().replace(" ", "-")}</p>
      <p class="text-small text-muted">Online</p>
    </li>
    <!-- Quick replies (Messenger's icebreakers): outlined bubbles on the visitor's side. They sit at the bottom of the
         thread and scroll with it. -->
    <li data-chat-suggestions class="mt-auto">
      <ul class="flex flex-col items-end gap-2">
        {
          assistant.suggestions.map((s) => (
            <li>
              <button
                type="button"
                class="rounded-[2px] border border-ink px-3 py-1.5 text-small text-ink transition-colors duration-200 hover:bg-ink hover:text-paper"
              >
                {s}
              </button>
            </li>
          ))
        }
      </ul>
    </li>
  </ol>
  <!-- My avatar, copied next to each of my replies. -->
  <template data-avatar>
    {
      site.chatAvatar ? (
        <img src={site.chatAvatar} alt="" width="56" height="56" class="avatar object-cover" />
      ) : (
        <span class="avatar grid place-items-center bg-ink" aria-hidden="true">
          <span class="chat-logo block size-4 bg-paper" />
        </span>
      )
    }
  </template>

  <form data-chat-form class="composer flex items-end gap-2 rounded-[4px] border border-line py-2 pr-2 pl-4">
    <label for="chat-input" class="sr-only">Your message</label>
    <textarea
      id="chat-input"
      rows="1"
      maxlength="800"
      enterkeyhint="send"
      autocapitalize="sentences"
      aria-describedby="chat-keys"
      placeholder="Ask me something…"
      class="max-h-32 flex-1 resize-none self-center bg-transparent py-1.5 text-[16px] leading-[1.4] text-ink placeholder:text-muted focus:outline-none"
    ></textarea>
    <button
      type="submit"
      data-state="send"
      disabled
      aria-label="Send"
      class="send grid h-9 shrink-0 place-items-center px-1 transition-opacity duration-200 disabled:opacity-35"
    >
      <!-- A keycap like the hero prompt bar's: ↵ to send, "■ stop" while I'm replying. -->
      <kbd class="key">
        <Icon icon={faArrowTurnDown} class="send-icon rotate-90 text-[12px]" />
        <span class="stop-icon"><span class="stop-square"></span>stop</span>
      </kbd>
    </button>
  </form>
  <!-- Always one line: on narrow phones the size follows the screen width so it fits. -->
  <p class="mt-2.5 text-center text-small whitespace-nowrap text-muted max-sm:text-[clamp(10px,3.2vw,13px)]">Replies are AI-generated from my portfolio.</p>
</aside>

<style>
  /* The round chat button stays tucked away through the hero and the projects, and gently fades in after them. */
  .chat-fab {
    transition:
      opacity 0.5s var(--ease-out-soft),
      translate 0.5s var(--ease-out-soft),
      scale 0.3s var(--ease-out-soft);
  }
  .chat-fab:hover {
    scale: 1.05;
  }
  .chat-fab.is-tucked {
    opacity: 0;
    translate: 0 12px;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 0.5s var(--ease-out-soft),
      translate 0.5s var(--ease-out-soft),
      visibility 0s linear 0.5s;
  }
  /* Hidden while the chat is open (the sheet's close button takes over), fading out as the sheet slides in. */
  .chat-fab.is-covered {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s var(--ease-out-soft),
      visibility 0s linear 0.2s;
  }
  .online-badge {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 12px;
    height: 12px;
    border: 2px solid var(--color-paper);
    border-radius: 50%;
    background: var(--color-online);
  }
  .chat-logo {
    mask: url("/images/logo.png") center / contain no-repeat;
  }
  .sheet {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 45;
    display: flex;
    flex-direction: column;
    width: min(420px, 100%);
    padding: 28px;
    background: var(--color-paper);
    border-left: 1px solid var(--color-line);
    visibility: hidden;
    /* Slides in from the edge on the iOS sheet curve (as in Vaul): quick to start, long soft landing.
       Closing runs a little faster than opening. Only transform animates, so it stays on the GPU; the shadow is
       fixed and simply rides along off screen. */
    transform: translateX(100%);
    box-shadow: -24px 0 60px -30px rgb(0 0 0 / 0.25);
    transition:
      transform 0.38s var(--ease-sheet),
      visibility 0s linear 0.38s;
    will-change: transform;
    contain: layout style;
    --ease-sheet: cubic-bezier(0.32, 0.72, 0, 1);
  }
  /* With JS the sheet is `inert` while closed instead of hidden, so it stays painted off screen and the slide
     starts on its first frame with nothing left to draw. */
  :global(.js) .sheet {
    visibility: visible;
  }
  .sheet[data-open] {
    visibility: visible;
    transform: none;
    transition:
      transform 0.5s var(--ease-sheet),
      visibility 0s;
  }
  /* The contents settle in just behind the sheet, one after another. */
  @media (prefers-reduced-motion: no-preference) {
    .sheet > * {
      opacity: 0;
      translate: 0 8px;
      transition:
        opacity 0.15s ease,
        translate 0s linear 0.15s;
    }
    .sheet[data-open] > * {
      opacity: 1;
      translate: none;
      transition:
        opacity 0.45s var(--ease-sheet) var(--in, 0.1s),
        translate 0.45s var(--ease-sheet) var(--in, 0.1s);
    }
    .sheet[data-open] > [data-chat-log] {
      --in: 0.16s;
    }
    .sheet[data-open] > form,
    .sheet[data-open] > form + p {
      --in: 0.22s;
    }
  }
  /* The sheet itself takes focus on open (so phones don't raise the keyboard); it needs no ring. */
  .sheet:focus {
    outline: none;
  }
  [data-chat-log] {
    overscroll-behavior: contain;
  }
  /* Me on the left with my photo, the visitor on the right. */
  [data-chat-log] :global(.msg-ai) {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding-right: 36px;
  }
  [data-chat-log] :global(.msg-user) {
    display: flex;
    justify-content: flex-end;
    padding-left: 48px;
  }
  [data-chat-log] :global(.avatar) {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 999px;
  }
  [data-chat-log] :global(.bubble) {
    padding: 10px 14px;
    border-radius: 4px;
    font-size: 15px;
    line-height: 1.5;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  [data-chat-log] :global(.msg-ai .bubble) {
    background: var(--color-ph);
    border-bottom-left-radius: 4px;
    white-space: normal;
  }
  /* Rendered replies (src/scripts/markdown.ts): bold, italics, lists, tables, code. */
  [data-chat-log] :global(.msg-ai .bubble:not(.typing-dots) > * + *) {
    margin-top: 0.6em;
  }
  [data-chat-log] :global(.bubble strong),
  [data-chat-log] :global(.bubble .md-heading) {
    font-weight: 600;
  }
  [data-chat-log] :global(.bubble ul),
  [data-chat-log] :global(.bubble ol) {
    padding-left: 1.25em;
  }
  [data-chat-log] :global(.bubble ul) {
    list-style: disc;
  }
  [data-chat-log] :global(.bubble ol) {
    list-style: decimal;
  }
  [data-chat-log] :global(.bubble li + li) {
    margin-top: 0.25em;
  }
  [data-chat-log] :global(.bubble code),
  [data-chat-log] :global(.bubble pre) {
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    font-size: 0.9em;
  }
  [data-chat-log] :global(.bubble code) {
    padding: 0.1em 0.35em;
  }
  [data-chat-log] :global(.bubble pre) {
    padding: 8px 10px;
    overflow-x: auto;
    white-space: pre;
  }
  [data-chat-log] :global(.md-table) {
    overflow-x: auto;
  }
  [data-chat-log] :global(.bubble table) {
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.4;
  }
  [data-chat-log] :global(.bubble th),
  [data-chat-log] :global(.bubble td) {
    padding: 5px 8px;
    border: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
    /* Words stay whole in cells; a wide table scrolls sideways instead. */
    overflow-wrap: normal;
  }
  [data-chat-log] :global(.bubble th) {
    font-weight: 600;
  }
  [data-chat-log] :global(.show-chip) {
    height: 28px;
    margin-left: -8px;
    color: var(--color-accent);
  }
  /* The chip's accent text would otherwise win over tui-btn's inverted hover and turn unreadable. Only with a real
     mouse, like tui-btn itself: on phones a tap leaves :hover stuck, which turned the text white on a light bubble. */
  @media (hover: hover) {
    [data-chat-log] :global(.show-chip:hover) {
      color: var(--color-paper);
    }
  }
  [data-chat-log] :global(.show-chip:focus-visible) {
    color: var(--color-paper);
  }
  [data-chat-log] :global(.chip-hint) {
    display: none;
    color: var(--color-muted);
  }
  /* Phones: the hint goes on its own line under the path, and a long path wraps, so the chip never widens the
     bubble past the screen. */
  @media (max-width: 639px) {
    [data-chat-log] :global(.show-chip) {
      flex-direction: column;
      align-items: flex-start;
      height: auto;
      padding-block: 4px;
      white-space: normal;
      overflow-wrap: anywhere;
      text-align: left;
    }
    [data-chat-log] :global(.chip-hint) {
      display: block;
      font-size: 11px;
    }
  }
  [data-chat-log] :global(.md-link) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* My email: in the accent colour, bolder, and always on one line. It shrinks with the screen so it fits the bubble. */
  [data-chat-log] :global(.md-email) {
    color: var(--color-accent);
    font-weight: 600;
    font-size: min(1em, 3.6vw);
    white-space: nowrap;
    overflow-wrap: normal;
    transition: opacity 0.2s ease;
  }
  [data-chat-log] :global(.md-email:hover) {
    opacity: 0.75;
  }
  [data-chat-log] :global(.msg-user .bubble) {
    background: var(--color-ink);
    color: var(--color-paper);
    border-bottom-right-radius: 4px;
  }
  /* Same states as the hero ask bar: idle light border, hover darker, focused ink border with a soft ring. */
  .composer {
    background: color-mix(in srgb, var(--color-paper) 45%, white);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .composer:hover {
    border-color: var(--color-muted);
  }
  .composer:focus-within {
    border-color: var(--color-ink);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-ink) 8%, transparent);
  }
  .composer textarea:focus-visible {
    outline: none;
  }
  :global([data-theme="dark"]) .composer {
    background: color-mix(in srgb, var(--color-paper) 90%, white);
  }
  .send .key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 26px;
    padding-inline: 6px;
    border: 1px solid var(--color-line);
    border-radius: 5px;
    background: var(--color-paper);
    box-shadow: 0 1px 0 var(--color-line);
    color: var(--color-ink);
    font: 500 var(--text-label) / 1 var(--font-mono);
    transition: border-color 0.2s ease;
  }
  .send:not(:disabled):hover .key,
  .send[data-state="stop"] .key {
    border-color: var(--color-ink);
  }
  .stop-icon {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .stop-square {
    width: 8px;
    height: 8px;
    border-radius: 1.5px;
    background: currentColor;
  }
  [data-state="send"] :global(.stop-icon),
  [data-state="stop"] :global(.send-icon) {
    display: none;
  }
  /* "Typing" dots while the reply is on its way. */
  [data-chat-log] :global(.typing-dots) {
    display: flex;
    gap: 4px;
    padding-block: 16px;
  }
  [data-chat-log] :global(.typing-dots span) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-muted);
  }
  /* The reply fades in word by word as it streams in. */
  @media (prefers-reduced-motion: no-preference) {
    [data-chat-log] :global(.typing-dots span) {
      animation: typing-dot 1.2s ease-in-out infinite;
    }
    [data-chat-log] :global(.typing-dots span:nth-child(2)) {
      animation-delay: 0.15s;
    }
    [data-chat-log] :global(.typing-dots span:nth-child(3)) {
      animation-delay: 0.3s;
    }
    [data-chat-log] :global(.word) {
      animation: word-in 0.6s ease-out both;
    }
  }
  @keyframes typing-dot {
    0%,
    60%,
    100% {
      translate: 0 0;
      opacity: 0.4;
    }
    30% {
      translate: 0 -4px;
      opacity: 1;
    }
  }
  /* Opacity only: a blur filter per word made long replies stutter on phones. */
  @keyframes word-in {
    from {
      opacity: 0;
    }
  }
  @media (max-width: 639px) {
    .sheet {
      padding: 20px;
      border-left: 0;
      box-shadow: none;
      transform: translateY(100%);
    }
    /* More room for my replies, so an email address fits on one line. */
    [data-chat-log] :global(.msg-ai) {
      padding-right: 12px;
    }
    /* The sheet is full-screen here, so the page behind it must not scroll. */
    :global(html.chat-open),
    :global(html.chat-open body) {
      overflow: hidden;
    }
  }
</style>

<script>
  import { markdown } from "../scripts/markdown";
  import { findTarget, pointTo } from "../scripts/point";
  import { play } from "../scripts/sound";

  type Message = { role: "user" | "assistant"; content: string };

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  // A reply never starts sooner than 0.6s after sending, so it never feels canned, and the typing dots wait a
  // moment before they appear. The server's rate limit does the pacing.
  const MIN_REPLY_DELAY = 600; // ms
  const TYPING_DOTS_DELAY = 300; // ms

  // Resolves after `ms`, or straight away once the visitor presses stop.
  function wait(ms: number, signal: AbortSignal) {
    return new Promise<void>((resolve) => {
      if (ms <= 0 || signal.aborted) return resolve();
      const timer = setTimeout(resolve, ms);
      signal.addEventListener("abort", () => (clearTimeout(timer), resolve()), { once: true });
    });
  }

  const sheet = document.getElementById("chat")!;
  const log = sheet.querySelector<HTMLOListElement>("[data-chat-log]")!;
  const avatar = sheet.querySelector<HTMLTemplateElement>("template[data-avatar]")!.content.firstElementChild!;
  const suggestions = sheet.querySelector<HTMLElement>("[data-chat-suggestions]")!;
  const form = sheet.querySelector<HTMLFormElement>("[data-chat-form]")!;
  const input = sheet.querySelector<HTMLTextAreaElement>("#chat-input")!;
  const send = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
  const openers = document.querySelectorAll<HTMLButtonElement>("[data-chat-open]");
  const history: Message[] = [];
  let request: AbortController | null = null;
  let returnFocus: HTMLElement | null = null;

  // Resolves once the sheet has finished sliding (or after a short fallback, if the transition never fires).
  function settled() {
    return new Promise<void>((resolve) => {
      const done = () => (clearTimeout(timer), sheet.removeEventListener("transitionend", onEnd), resolve());
      const onEnd = (e: TransitionEvent) => e.target === sheet && e.propertyName === "transform" && done();
      const timer = setTimeout(done, 600);
      sheet.addEventListener("transitionend", onEnd);
    });
  }

  sheet.inert = true;
  function setOpen(open: boolean) {
    sheet.toggleAttribute("data-open", open);
    sheet.inert = !open;
    // Locking the page's scroll re-lays out the whole page, so on open it waits for the slide to land; on close it
    // lifts at once.
    if (open) settled().then(() => sheet.hasAttribute("data-open") && document.documentElement.classList.add("chat-open"));
    else document.documentElement.classList.remove("chat-open");
    openers.forEach((b) => {
      b.setAttribute("aria-expanded", String(open));
      b.classList.toggle("is-covered", open); // the sheet covers the corner; its own close button takes over
    });
    if (open) {
      // Laptops: straight into the text field, like ChatGPT and Intercom. Phones: the sheet, so the on-screen
      // keyboard only comes up once the visitor taps the field.
      returnFocus = document.activeElement as HTMLElement | null;
      if (phone.matches) sheet.focus({ preventScroll: true });
      else input.focus({ preventScroll: true });
    } else {
      returnFocus?.focus();
    }
    fitToViewport();
  }

  // "Stick to bottom", like ChatGPT and Messenger: the log follows new text only while the visitor is at the
  // bottom. Scrolling up to read turns that off, so it never fights them; scrolling back down turns it on.
  let stickToBottom = true;
  log.addEventListener(
    "scroll",
    () => (stickToBottom = log.scrollHeight - log.scrollTop - log.clientHeight < 40),
    { passive: true },
  );
  function toBottom(smooth = false) {
    log.scrollTo({ top: log.scrollHeight, behavior: smooth && !reduceMotion ? "smooth" : "auto" });
  }

  // Phones: the on-screen keyboard shrinks the visible area without resizing the page (iOS especially), so the
  // sheet is sized to the visible viewport, keeping the input just above the keyboard and the latest message
  // in view.
  const phone = matchMedia("(max-width: 639px)");
  const viewport = window.visualViewport;
  function fitToViewport() {
    if (!viewport || !phone.matches || !sheet.hasAttribute("data-open")) {
      sheet.style.removeProperty("height");
      sheet.style.removeProperty("top");
      return;
    }
    sheet.style.top = `${viewport.offsetTop}px`;
    sheet.style.height = `${viewport.height}px`;
    if (stickToBottom) toBottom();
  }
  let fitFrame = 0;
  const queueFit = () => (fitFrame ||= requestAnimationFrame(() => ((fitFrame = 0), fitToViewport())));
  viewport?.addEventListener("resize", queueFit);
  viewport?.addEventListener("scroll", queueFit);
  input.addEventListener("focus", () => {
    // Once the keyboard has slid up, bring the latest message back into view.
    setTimeout(() => {
      fitToViewport();
      if (stickToBottom) toBottom();
    }, 300);
  });

  function syncButton() {
    const busy = request !== null;
    send.dataset.state = busy ? "stop" : "send";
    send.setAttribute("aria-label", busy ? "Stop" : "Send");
    send.disabled = !busy && input.value.trim() === "";
  }

  function growInput() {
    input.style.height = "auto";
    input.style.height = `${input.scrollHeight}px`;
  }

  function paragraph(className: string, text: string) {
    const p = document.createElement("p");
    p.className = className;
    p.textContent = text; // text only — model output is never parsed as HTML
    return p;
  }

  function typingDots() {
    const bubble = document.createElement("div");
    bubble.className = "bubble typing-dots";
    bubble.setAttribute("aria-label", "Jerome is typing");
    bubble.append(...Array.from({ length: 3 }, () => document.createElement("span")));
    return bubble;
  }

  // Walks the words of the rendered reply in reading order. `delay(i)` returns the animation delay for word i while
  // it is still fading in, and null once it has landed; only fading words get a span, so a long reply stays a
  // handful of nodes instead of one per word.
  function wrapWords(root: Node, delay: (i: number) => string | null) {
    const texts: Text[] = [];
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    while (walker.nextNode()) texts.push(walker.currentNode as Text);
    let i = 0;
    for (const node of texts) {
      if (!node.data.trim()) continue;
      let wrapped = false;
      const parts = node.data.split(/(\s+)/).map((part) => {
        if (!part || /^\s+$/.test(part)) return part;
        const at = delay(i++);
        if (at === null) return part;
        wrapped = true;
        const word = Object.assign(document.createElement("span"), { className: "word", textContent: part });
        word.style.animationDelay = at;
        return word;
      });
      if (wrapped) node.replaceWith(...parts.filter(Boolean));
    }
  }

  // Shows the reply as it streams in. Each word fades in at least WORD_GAP after the one before, so a burst of text
  // still reads like typing. The bubble is re-rendered as text arrives (Markdown can change shape mid-reply), at most
  // every RENDER_GAP, since the eye can't follow faster and phones can't paint faster; every word keeps its own start
  // time, so one already fading in carries on, never restarts.
  const WORD_GAP = 18; // ms
  const WORD_FADE = 600; // ms, the length of the word-in animation
  const RENDER_GAP = phone.matches ? 90 : 50; // ms between re-renders of the bubble
  function streamInto(bubble: HTMLElement) {
    const born: number[] = [];
    let text = "";
    let frame = 0;
    let timer = 0;
    let lastRender = 0;
    const render = () => {
      frame = 0;
      timer = 0;
      lastRender = performance.now();
      bubble.replaceChildren(markdown(text));
      if (!reduceMotion) {
        const now = performance.now();
        wrapWords(bubble, (i) => {
          born[i] ??= Math.max(now, (born[i - 1] ?? 0) + WORD_GAP);
          const age = now - born[i];
          return age >= WORD_FADE ? null : `${-age}ms`;
        });
      }
      if (stickToBottom) toBottom();
    };
    const schedule = () => (frame ||= requestAnimationFrame(render));
    return {
      get text() {
        return text;
      },
      set(next: string) {
        text = next;
        if (frame || timer) return;
        const wait = lastRender + RENDER_GAP - performance.now();
        if (wait <= 0) schedule();
        else timer = window.setTimeout(() => ((timer = 0), schedule()), wait);
      },
      flush() {
        if (!frame && !timer) return;
        cancelAnimationFrame(frame);
        clearTimeout(timer);
        render();
      },
    };
  }

  type Line = { text?: string; replace?: string; show?: string };

  // The reply arrives as newline-separated JSON (see worker/index.ts).
  async function* lines(body: ReadableStream<Uint8Array<ArrayBuffer>>): AsyncGenerator<Line> {
    const reader = body.pipeThrough(new TextDecoderStream()).getReader();
    let buffer = "";
    for (;;) {
      const { value, done } = await reader.read();
      if (done) break;
      buffer += value;
      const parts = buffer.split("\n");
      buffer = parts.pop() ?? "";
      for (const part of parts) if (part.trim()) yield JSON.parse(part);
    }
  }

  // A reply that's about part of the page scrolls there (laptops and up, where the page shows beside the chat) and
  // gets a chip to go back to it. On phones the chat covers the page, so the chip closes it first.
  function showChip(bubble: HTMLElement, target: string, auto: boolean) {
    if (!findTarget(target)) return;
    const chip = document.createElement("button");
    chip.type = "button";
    chip.className = "show-chip tui-btn inline-flex";
    chip.textContent = `[ cd ~/${target === "top" ? "" : target} ]`;
    // Phones: the chat covers the page, so a short hint says the chip is how to see it.
    const hint = document.createElement("span");
    hint.className = "chip-hint";
    hint.textContent = "tap to view it on the page";
    chip.append(hint);
    chip.addEventListener("click", () => {
      if (phone.matches) setOpen(false);
      pointTo(target);
    });
    bubble.append(chip);
    if (auto && !phone.matches) pointTo(target);
  }

  function message(role: Message["role"], bubble: HTMLElement) {
    const li = document.createElement("li");
    li.className = role === "user" ? "msg-user" : "msg-ai";
    if (role === "assistant") li.append(avatar.cloneNode(true));
    li.append(bubble);
    return li;
  }

  async function ask(question: string) {
    const text = question.trim();
    if (!text || request) return;
    // Only a visitor already typing gets the field back afterwards; tapping a quick reply never raises the keyboard.
    // Laptops keep the cursor in the chat after every reply, like ChatGPT. Phones only give it back to someone
    // already typing, so tapping a quick reply never raises the keyboard.
    const refocus = phone.matches
      ? document.activeElement === input || document.activeElement === send
      : sheet.contains(document.activeElement);
    suggestions.hidden = true;
    input.value = "";
    growInput();

    play("send");
    history.push({ role: "user", content: text });
    const reply = message("assistant", typingDots());
    log.append(message("user", paragraph("bubble", text)));
    // Sending always jumps to your own message, like chat apps do.
    stickToBottom = true;
    toBottom(true);

    request = new AbortController();
    const { signal } = request;
    const askedAt = performance.now();
    log.setAttribute("aria-busy", "true");
    syncButton();
    const showDots = setTimeout(() => {
      log.append(reply);
      if (stickToBottom) toBottom(true);
    }, TYPING_DOTS_DELAY);
    const bubble = () => reply.lastElementChild as HTMLElement;
    try {
      // The server accepts at most 12 messages. History alternates and ends with the visitor,
      // so the last 11 always start with a user turn.
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history.slice(-11) }),
        signal,
      });
      const down = "Chat's down right now. Try again later.";
      if (!res.ok || !res.body) {
        const data: { error?: string } = await res.json().catch(() => ({}));
        throw new Error(data.error ?? down);
      }
      const text = document.createElement("div");
      text.className = "bubble";
      let out: ReturnType<typeof streamInto> | null = null;
      let show: string | undefined;
      try {
        for await (const line of lines(res.body)) {
          show = line.show ?? show;
          if (line.text === undefined && line.replace === undefined) continue;
          if (!out) {
            await wait(MIN_REPLY_DELAY - (performance.now() - askedAt), signal);
            clearTimeout(showDots);
            if (!reply.isConnected) log.append(reply);
            bubble().replaceWith(text);
            out = streamInto(text);
          }
          out.set(line.replace ?? out.text + line.text);
        }
      } catch (error) {
        // Stopping mid-reply keeps what's there so far.
        if (!signal.aborted || !out?.text) throw error;
      }
      if (!out?.text) throw new Error(down);
      out.flush();
      history.push({ role: "assistant", content: out.text });
      if (show) showChip(text, show, !signal.aborted);
    } catch (error) {
      history.pop(); // keep history alternating so the next question is still valid
      clearTimeout(showDots);
      if (!reply.isConnected) log.append(reply);
      const stopped = error instanceof DOMException && error.name === "AbortError";
      bubble().replaceWith(
        paragraph("bubble text-muted", stopped ? "Stopped." : error instanceof Error ? error.message : "Something broke. Try again."),
      );
    } finally {
      request = null;
      log.removeAttribute("aria-busy");
      syncButton();
      if (refocus) input.focus();
    }
    if (queued) {
      const next = queued;
      queued = "";
      ask(next);
    }
  }

  // Scrolling over the open sheet moves only the chat, never the page behind it.
  // Only the log and the composer scroll; at their ends (or anywhere else on the sheet) the gesture stops.
  function canScroll(target: EventTarget | null, deltaY: number) {
    const el = (target as Element | null)?.closest<HTMLElement>("[data-chat-log], textarea");
    if (!el) return false;
    return deltaY < 0 ? el.scrollTop > 0 : el.scrollTop + el.clientHeight < el.scrollHeight - 1;
  }
  let touchY = 0;
  sheet.addEventListener(
    "wheel",
    (e) => {
      if (!canScroll(e.target, e.deltaY)) e.preventDefault();
    },
    { passive: false },
  );
  sheet.addEventListener("touchstart", (e) => (touchY = e.touches[0].clientY), { passive: true });
  sheet.addEventListener(
    "touchmove",
    (e) => {
      const y = e.touches[0].clientY;
      if (!canScroll(e.target, touchY - y)) e.preventDefault();
      touchY = y;
    },
    { passive: false },
  );

  openers.forEach((b) => b.addEventListener("click", () => setOpen(!sheet.hasAttribute("data-open"))));
  sheet.querySelector("[data-chat-close]")!.addEventListener("click", () => setOpen(false));
  // Keyboard, after ChatGPT and Intercom and the usual chat-widget accessibility rules:
  // Escape closes (focus goes back where it was), Shift+Escape jumps to the text field, Tab stays inside the chat,
  // and typing a letter anywhere in the chat types it into the field.
  const focusables = () =>
    [...sheet.querySelectorAll<HTMLElement>("button, [href], textarea, input, [tabindex]:not([tabindex='-1'])")].filter(
      (el) => !el.hasAttribute("disabled") && el.getClientRects().length > 0,
    );
  sheet.addEventListener("keydown", (e) => {
    if (e.isComposing) return;
    if (e.key === "Escape") {
      e.preventDefault();
      if (e.shiftKey) input.focus();
      else setOpen(false);
      return;
    }
    if (e.key === "Tab") {
      const list = focusables();
      if (!list.length) return;
      const [first, last] = [list[0], list[list.length - 1]];
      const active = document.activeElement;
      if (e.shiftKey && (active === first || active === sheet)) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && (active === last || active === sheet)) {
        e.preventDefault();
        first.focus();
      }
      return;
    }
    const target = e.target as HTMLElement;
    if (e.key.length === 1 && e.key !== " " && !e.metaKey && !e.ctrlKey && !e.altKey && !target.closest("textarea, input")) {
      input.focus(); // the key's character lands in the field
    }
  });
  // Anywhere on the page while the chat is open: Shift+Escape focuses the field, Ctrl/Cmd+Shift+C copies my last reply.
  document.addEventListener("keydown", (e) => {
    if (!sheet.hasAttribute("data-open")) return;
    if (e.key === "Escape" && e.shiftKey && !sheet.contains(e.target as Node)) {
      e.preventDefault();
      input.focus();
    } else if ((e.metaKey || e.ctrlKey) && e.shiftKey && e.key.toLowerCase() === "c") {
      const last = history.findLast((m) => m.role === "assistant");
      if (!last) return;
      e.preventDefault();
      navigator.clipboard?.writeText(last.content).catch(() => {});
    }
  });
  document.addEventListener("chat:open", () => setOpen(true));
  // The round button stays tucked away through the hero and the projects (the hero's prompt bar already opens the
  // chat there) and fades in once the projects have scrolled past. Pages without a projects section show it at once.
  // "Past" once the projects' bottom edge is above the middle of the screen. Watching both the hero and the projects
  // catches long jumps too (links, the chat pointing somewhere), where a single watcher wouldn't fire.
  const tuckUntilPast = document.getElementById("projects");
  if (tuckUntilPast) {
    const sync = () => {
      const past = tuckUntilPast.getBoundingClientRect().bottom < innerHeight / 2;
      openers.forEach((b) => b.classList.toggle("is-tucked", !past));
    };
    // Watch a thin band across the middle of the screen, the same line `sync` checks, so crossing it either way
    // (scrolling down or back up) updates the button.
    const watcher = new IntersectionObserver(sync, { rootMargin: "-50% 0px -49% 0px" });
    watcher.observe(tuckUntilPast);
    const hero = document.getElementById("top");
    if (hero) watcher.observe(hero);
  } else {
    openers.forEach((b) => b.classList.remove("is-tucked"));
  }
  // Questions asked from elsewhere on the page (the hero prompt bar) open the chat and send.
  document.addEventListener("chat:ask", (e) => {
    setOpen(true);
    // The message goes in once the sheet has landed (at once with reduced motion), so the slide itself stays smooth.
    const question = (e as CustomEvent<string>).detail;
    if (reduceMotion) ask(question);
    else settled().then(() => ask(question));
  });

  suggestions.querySelectorAll("button").forEach((b) => b.addEventListener("click", () => ask(b.textContent ?? "")));
  // While a reply is streaming, Enter with a typed message queues it for right after the reply (it never cuts the
  // reply short); Enter or the button with an empty field stops the reply.
  let queued = "";
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!request) ask(input.value);
    else if (input.value.trim()) {
      queued = input.value;
      input.value = "";
      growInput();
    } else request.abort();
  });
  input.addEventListener("input", () => {
    growInput();
    syncButton();
  });
  // Up and Down in an empty field (or one showing an earlier question) step through the visitor's questions, like a
  // shell's history. Typing anything else leaves the history.
  let recall = -1;
  const asked = () => history.filter((m) => m.role === "user").map((m) => m.content);
  // On-screen keyboards (phones, tablets), after WhatsApp and Messenger: tapping send keeps the keyboard up, and
  // swiping the messages down puts it away. Enter sends everywhere (the keyboard's key shows "send").
  send.addEventListener("pointerdown", (e) => {
    if (document.activeElement === input) e.preventDefault(); // keeps focus, so the keyboard doesn't drop and pop back
  });
  let dragY = 0;
  log.addEventListener("touchstart", (e) => (dragY = e.touches[0].clientY), { passive: true });
  log.addEventListener(
    "touchmove",
    (e) => {
      if (document.activeElement === input && e.touches[0].clientY - dragY > 40) input.blur();
    },
    { passive: true },
  );

  input.addEventListener("keydown", (e) => {
    // Enter sends, Shift+Enter is a new line, on every device. Not while an IME (Chinese, Japanese, Korean) is
    // composing a word.
    if (e.key.length === 1 || e.key === "Backspace") play("key");
    if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
      e.preventDefault();
      recall = -1;
      ask(input.value);
      return;
    }
    const questions = asked();
    const browsing = input.value === "" || (recall >= 0 && input.value === questions[recall]);
    if ((e.key === "ArrowUp" || e.key === "ArrowDown") && browsing && questions.length && !e.shiftKey) {
      const start = recall < 0 ? questions.length : recall;
      const next = e.key === "ArrowUp" ? Math.max(0, start - 1) : start + 1;
      if (e.key === "ArrowDown" && recall < 0) return;
      e.preventDefault();
      recall = next >= questions.length ? -1 : next;
      input.value = recall < 0 ? "" : questions[recall];
      growInput();
      syncButton();
      input.setSelectionRange(input.value.length, input.value.length);
    }
  });
</script>
