---
import { projects } from "../data/projects";
import SectionHead from "./SectionHead.astro";
import Project from "./Project.astro";

// Bento grid (after kennethtegrado.com): three columns on laptops, the first project a tall featured card beside
// two stacked pairs. Tablets show two columns with the featured card across the top; phones, one.
function layout(i: number) {
  return i === 0 ? "md:col-span-2 lg:col-span-1 lg:row-span-2 min-h-[560px] md:min-h-[480px] lg:min-h-[640px]" : "min-h-[340px]";
}
---

<section id="projects" class="shell section" aria-labelledby="projects-title">
  <div class="pane" data-pane="projects">
  <SectionHead id="projects-title" title="Projects" />
  <div class="card-grid grid md:grid-cols-2 lg:grid-cols-[1.25fr_1fr_1fr]">
    {projects.map((project, i) => <Project project={project} class={layout(i)} />)}
  </div>
  </div>
</section>
