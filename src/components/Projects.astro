---
import { projects } from "../data/projects";
import SectionHead from "./SectionHead.astro";
import Project from "./Project.astro";

// Staggered editorial grid: projects pair up as wide + narrow, the second one set lower,
// and every other pair mirrors so the page zigzags.
function layout(i: number) {
  const second = i % 2 === 1;
  const mirrored = Math.floor(i / 2) % 2 === 1;
  const wide = second === mirrored;
  return [wide ? "md:col-span-7" : "md:col-span-5", second && "md:mt-[clamp(80px,12vw,180px)]"];
}
---

<section id="work" class="shell section" aria-labelledby="work-title">
  <div class="pane" data-pane="selected-work">
  <SectionHead id="work-title" title="Selected Work" />
  <div class="gallery grid items-start gap-y-[clamp(48px,6vw,88px)] md:grid-cols-12 md:gap-x-[clamp(24px,4vw,64px)]">
    {projects.map((project, i) => <Project project={project} index={i} class:list={layout(i)} />)}
  </div>
  </div>
</section>

<style>
  .gallery :global(.project > *) {
    transition: opacity 0.25s ease;
  }
  @media (hover: hover) {
    .gallery:has(:global(.project:hover)) :global(.project:not(:hover) > *) {
      opacity: 0.45;
    }
  }
</style>
