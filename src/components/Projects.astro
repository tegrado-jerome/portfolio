---
import { projects } from "../data/projects";
import Project from "./Project.astro";
import StackSection from "./StackSection.astro";
---

<StackSection id="projects" title="Projects" count={projects.length}>
  {
    projects.map((project, i) => (
      <li class="stack-item" style={`--i:${i}`}>
        <Project project={project} index={i} />
      </li>
    ))
  }
</StackSection>
