---
import { projects } from "../data/projects";
import SectionHead from "./SectionHead.astro";
import Project from "./Project.astro";
---

<!-- Sticky stack (after the stacking-cards demos on scroll-driven-animations.style and CodyHouse): the stack pins near
     the top, and each scroll of about a third of the screen slides the next project up from below onto it, while the
     ones behind sink back, tilt a touch and dim, a light fake 3D. Every card lands whole, and the scroll it takes is
     set by --per, not by the card's height, so it never drags. A "keep scrolling" pill counts the cards and leaves once
     the last one lands. Without JS, or with reduced motion, the projects are a plain list. -->
<section id="projects" class="shell section" aria-labelledby="projects-title">
  <div class="pane" data-pane="projects">
    <SectionHead id="projects-title" title="Projects" />
    <div class="stack" data-stack style={`--n:${projects.length}`}>
      <div class="stack-pin">
        <ol class="stack-list">
          {
            projects.map((project, i) => (
              <li class="stack-item" style={`--i:${i}`}>
                <Project project={project} index={i} />
              </li>
            ))
          }
        </ol>
      </div>
    </div>
    <p class="stack-hint" data-stack-hint aria-hidden="true">
      <span class="mouse"><span class="wheel"></span></span>
      <span><span data-stack-count class="tabular-nums">01/{String(projects.length).padStart(2, "0")}</span> · keep scrolling</span>
    </p>
  </div>
</section>

<style>
  .stack {
    --card-h: min(520px, calc(100svh - 190px));
    --top: 24px;
    --step: 14px;
    --per: 36svh; /* scroll it takes to bring in the next card */
  }
  @media (max-width: 767px) {
    .stack {
      --card-h: min(560px, calc(100svh - 170px));
      --top: 16px;
      --step: 10px;
      --per: 34svh;
    }
  }
  /* Plain list: no JS, or reduced motion. */
  .stack-list {
    display: grid;
    gap: 16px;
  }
  .stack-item {
    height: var(--card-h);
  }

  /* The stack (the script adds .is-live): the track is tall enough to scroll through every card, the pin holds the
     cards in place meanwhile, and each card waits below the screen until its turn. The track clips only its bottom
     edge, so a waiting card never shows over the next section. */
  .stack.is-live {
    height: calc(var(--card-h) + (var(--n) - 1) * (var(--step) + var(--per)));
    clip-path: inset(-60px -60px 0 -60px);
  }
  .is-live .stack-pin {
    position: sticky;
    top: var(--top);
    height: calc(var(--card-h) + (var(--n) - 1) * var(--step));
  }
  .is-live .stack-list {
    display: block;
    position: relative;
    height: 100%;
  }
  .is-live .stack-item {
    position: absolute;
    top: calc(var(--i) * var(--step));
    right: 0;
    left: 0;
    perspective: 1400px;
    will-change: transform;
  }
  .is-live .stack-item > :global(.stack-card) {
    transform-origin: 50% 0;
    will-change: transform;
  }

  /* The hint rides at the bottom of the screen while the stack is on it. Same pill on every screen. */
  .stack-hint {
    position: sticky;
    bottom: 16px;
    z-index: 5;
    display: flex;
    gap: 10px;
    align-items: center;
    width: max-content;
    margin: 24px auto 0;
    padding: 6px 12px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-muted);
    font-size: var(--text-small);
    transition: opacity 0.4s ease;
  }
  @media (min-width: 1024px) {
    .stack-hint {
      bottom: 56px; /* above the status bar */
    }
  }
  .stack-hint.is-done {
    opacity: 0;
  }
  .mouse {
    position: relative;
    display: block;
    width: 14px;
    height: 21px;
    border: 1.5px solid currentColor;
    border-radius: 7px;
  }
  .wheel {
    position: absolute;
    top: 4px;
    left: 50%;
    width: 2px;
    height: 5px;
    margin-left: -1px;
    border-radius: 1px;
    background: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wheel {
      animation: wheel 1.6s ease-in-out infinite;
    }
  }
  @keyframes wheel {
    0% {
      translate: 0 0;
      opacity: 1;
    }
    70% {
      translate: 0 7px;
      opacity: 0;
    }
    100% {
      translate: 0 0;
      opacity: 0;
    }
  }
</style>

<script>
  // Scroll through the track moves the cards: `arrived[i]` goes 0 → 1 as card i slides up from below the screen onto
  // the stack. A card's depth is how much of the cards after it have arrived; deeper cards shrink, tilt back and dim.
  // Only transforms and one small overlay's opacity change, and only when they differ from the last frame, once a
  // frame and only while the stack is on screen.
  const stack = document.querySelector<HTMLElement>("[data-stack]");
  const hint = document.querySelector<HTMLElement>("[data-stack-hint]");
  const count = document.querySelector<HTMLElement>("[data-stack-count]");
  if (stack && hint && count && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const items = [...stack.querySelectorAll<HTMLElement>(".stack-item")];
    const cards = items.map((li) => li.firstElementChild as HTMLElement);
    const dims = cards.map((card) => card.querySelector<HTMLElement>(".dim")!);
    // Last values written, so a frame only touches what changed.
    const last = items.map(() => ({ slide: "", card: "", dim: "" }));
    const set = (el: HTMLElement, key: "slide" | "card" | "dim", i: number, value: string) => {
      if (last[i][key] === value) return;
      last[i][key] = value;
      if (key === "dim") el.style.opacity = value;
      else el.style.transform = value;
    };
    const pin = stack.querySelector<HTMLElement>(".stack-pin")!;
    const total = String(items.length).padStart(2, "0");
    stack.classList.add("is-live");

    let frame = 0;
    // Sizes, measured again only when the screen size changes.
    let top = 0; // where the pin sticks
    let per = 1; // scroll per card
    let rise: number[] = []; // how far below its spot each card waits: just off the bottom of the screen
    const measure = () => {
      top = parseFloat(getComputedStyle(pin).top);
      per = Math.max(1, (stack.offsetHeight - pin.offsetHeight) / Math.max(1, items.length - 1));
      rise = items.map((li) => Math.max(0, innerHeight - top - li.offsetTop));
    };

    // The cards don't jump with each scroll step (a wheel notch is ~100px at once): they glide toward where the
    // scroll says they should be, closing about 63% of the gap every GLIDE ms, frame-rate independent. A small scroll
    // eases a little; a big one catches up fast, then slows as it lands. Only the cards glide; the page scrolls as
    // usual.
    const GLIDE = 150; // ms
    let shown = 0; // the progress on screen, in cards
    let lastTime = 0; // 0 while at rest
    let snap = true; // jump straight there (first paint, resize)

    function update(now: number) {
      frame = 0;
      const target = (top - stack!.getBoundingClientRect().top) / per;
      if (snap || !lastTime) {
        if (snap) shown = target;
        snap = false;
      } else {
        shown += (target - shown) * (1 - Math.exp(-Math.min(64, now - lastTime) / GLIDE));
      }
      if (Math.abs(target - shown) < 0.0005) shown = target;
      lastTime = shown === target ? 0 : now;
      if (lastTime) frame = requestAnimationFrame(update);

      const arrived = items.map((_, i) => (i === 0 ? 1 : Math.min(1, Math.max(0, shown - (i - 1)))));
      items.forEach((li, i) => {
        // The slide eases out, so each card settles softly onto the stack.
        const slide = 1 - (1 - arrived[i]) ** 2;
        set(li, "slide", i, i && slide < 1 ? `translateY(${((1 - slide) * rise[i]).toFixed(1)}px)` : "");
        let depth = 0;
        for (let j = i + 1; j < items.length; j++) depth += arrived[j];
        depth = Math.min(depth, 3);
        set(
          cards[i],
          "card",
          i,
          depth
            ? `translateY(${(-depth * 6).toFixed(1)}px) scale(${(1 - depth * 0.05).toFixed(4)}) rotateX(${(depth * 2.5).toFixed(2)}deg)`
            : "",
        );
        set(dims[i], "dim", i, (Math.min(depth, 2) * 0.1).toFixed(3));
      });
      const landed = arrived.filter((a) => a >= 0.5).length;
      count!.textContent = `${String(Math.max(1, landed)).padStart(2, "0")}/${total}`;
      hint!.classList.toggle("is-done", arrived[arrived.length - 1] >= 0.98);
    }
    const queue = () => (frame ||= requestAnimationFrame(update));
    const resized = () => {
      measure();
      snap = true;
      queue();
    };
    resized();

    let watching = false;
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting === watching) return;
      watching = entry.isIntersecting;
      if (watching) {
        addEventListener("scroll", queue, { passive: true });
        addEventListener("resize", resized, { passive: true });
        resized();
      } else {
        removeEventListener("scroll", queue);
        removeEventListener("resize", resized);
      }
    }).observe(stack);
  }
</script>
