---
// A credentials section (Awards, Certifications) as a row of the site's windows, one per entry (the photo on the left,
// the text on the right), that scrolls sideways a window at a time. The next window's edge peeks in on the right, so
// it reads as "swipe" without arrows (like Apple's product rows). A swipe, a mouse drag, the arrow keys, a click on
// the peeking window or a thumbnail in the dark status line moves along. A click on an entry opens it in full in the
// modal (with the link to proof). Without JS the row still scrolls.
import { isSet } from "../data/placeholders";
import { slug as toSlug } from "../data/slug";
import Detail from "./Detail.astro";

export interface Credential {
  title: string;
  year: string;
  /** Short name of who gave it (e.g. "TUP Manila"). */
  caption: string;
  /** Full name of who gave it, shown in the modal. */
  issuer: string;
  /** Extra lines for the modal (e.g. "GWA 1.36", "Credential ID: …"); the first one also shows in the window. */
  details?: string[];
  href?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  id: string;
  title: string;
  entries: Credential[];
  /** Label shown where an entry has no picture yet. */
  placeholder: string;
  /** Label for the modal's link to proof, e.g. "verify". */
  linkLabel: string;
}

const { id, title, entries, placeholder, linkLabel } = Astro.props;
const slug = toSlug(title);
const n = entries.length;
const pad = (i: number) => String(i).padStart(2, "0");
// The line under a title: its first detail, or the full issuer when that says more than the short caption.
const line = (e: Credential) => (e.details ?? []).find(isSet) ?? (e.issuer !== e.caption ? e.issuer : "");
const name = (e: Credential) => toSlug(e.title) || slug;
---

{
  n > 0 && (
    <section id={id} class="shell screen" aria-labelledby={`${id}-title`}>
      <div class="pane" data-pane={slug}>
        <h2 id={`${id}-title`} class="absolute inset-x-0 top-0 truncate text-small font-normal text-ink">
          <span class="sr-only">{title}</span>
          <span aria-hidden="true"><span class="text-accent">~/</span>{slug}</span>
        </h2>

        <ol class="row" data-spotlight data-reveal>
          {entries.map((e, i) => (
            <li class="card tile">
              <div class="tile-top">
                <span class="tile-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="tile-title"><strong>{name(e)}</strong></span>
                <span class="tile-badge">{e.year}</span>
              </div>
              <div class="slide relative">
                <div class="media photo">
                  {e.image ? (
                    <img src={e.image} alt={e.imageAlt ?? ""} loading="lazy" decoding="async" />
                  ) : (
                    <span class="eyebrow text-muted">[{placeholder}]</span>
                  )}
                </div>
                <div class="text">
                  <p class="eyebrow text-muted">{[e.caption, e.year].filter(isSet).join(" · ")}</p>
                  <h3 class="mt-2 text-heading font-normal">
                    <button type="button" data-detail-open class="cursor-pointer text-left after:absolute after:inset-0 after:z-[1] after:content-['']">
                      {e.title}
                    </button>
                  </h3>
                  {line(e) && <p class="mt-2 text-small text-ink-soft">{line(e)}</p>}
                </div>
              </div>
              {n > 1 && (
                <div class="tile-meta">
                  <span class="hidden gap-1.5 in-[.js]:flex">
                    {entries.map((t, k) => (
                      <button type="button" class="thumb" data-spot-thumb={k} aria-current={k === i ? "true" : undefined} aria-label={`Show ${t.title}`}>
                        {t.image && <img src={t.image} alt="" loading="lazy" decoding="async" />}
                      </button>
                    ))}
                  </span>
                  <span class="tabular-nums" aria-hidden="true">{pad(i + 1)} / {pad(n)}</span>
                </div>
              )}
              <Detail
                path={`${slug}/${name(e)}`}
                title={e.title}
                meta={[e.year, e.issuer]}
                image={e.image}
                imageAlt={e.imageAlt}
                placeholder={placeholder}
                text={(e.details ?? []).filter(isSet)}
                link={isSet(e.href) ? { href: e.href, label: linkLabel } : undefined}
              />
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  /* The row runs out through the shell's side padding to the page's edge, so the next window is cut there like a card
     sliding in. The end padding (that bleed plus the peek) makes each window the content width less the peek, and
     lets the last one line up on the left like the rest. */
  .row {
    --bleed: clamp(20px, 11vw, 200px);
    --peek: 56px;
    display: flex;
    gap: 12px;
    margin-right: calc(-1 * var(--bleed));
    padding-right: calc(var(--bleed) + var(--peek));
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
  }
  .row > .card {
    flex: none;
    width: 100%;
    scroll-snap-align: start;
  }
  /* While a mouse drags the row it follows the pointer exactly; the snap comes back on release. */
  .row.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
  }
  /* One entry: the photo pane on the left, the text on the right. */
  .slide {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
  }
  .photo {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 340px;
    overflow: hidden;
    border-right: 1px solid var(--color-line);
    background: var(--color-ph);
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text {
    min-width: 0;
    padding: 24px;
  }
  /* The thumbnails ride in the dark status line: each entry's own picture, small; the window's own one bright with a
     light edge, the rest dimmed. An entry without a picture yet shows a plain light block. */
  .thumb {
    position: relative;
    z-index: 2;
    width: 32px;
    height: 22px;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.18);
    opacity: 0.55;
    transition:
      opacity 0.2s ease,
      background-color 0.2s ease;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The picked one: full strength, with a light ring drawn inside its own edge (a ring outside it left a dark gap). */
  .thumb[aria-current="true"] {
    background: #e6e9ee;
    opacity: 1;
    box-shadow: inset 0 0 0 1px #e6e9ee;
  }
  .thumb[aria-current="true"] img {
    outline: 1px solid #e6e9ee;
    outline-offset: -1px;
  }
  @media (hover: hover) {
    .thumb:not([aria-current="true"]):hover {
      opacity: 0.85;
    }
  }
  @media (max-width: 767px) {
    .row {
      --peek: 36px;
    }
    .slide {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }
    .photo {
      min-height: 220px;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .text {
      padding: 16px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((row) => {
    const pane = row.closest<HTMLElement>(".pane")!;
    const cards = [...row.querySelectorAll<HTMLElement>(":scope > .card")];
    const at = (k: number) => cards[k].offsetLeft - cards[0].offsetLeft;
    // The window lined up on the left: the last one whose start the row has scrolled to.
    const indexAt = (left: number) => Math.max(0, cards.findLastIndex((_, k) => at(k) <= left + 1));
    // While a smooth scroll is on its way, the window it's heading to counts, so quick key presses add up.
    let goal = -1;
    const current = () => (goal >= 0 ? goal : indexAt(row.scrollLeft));
    for (const type of ["scrollend", "touchstart", "wheel"]) row.addEventListener(type, () => (goal = -1), { passive: true });

    function show(i: number) {
      const to = Math.min(cards.length - 1, Math.max(0, i));
      const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;
      goal = smooth && row.scrollLeft !== at(to) ? to : -1;
      row.scrollTo({ left: at(to), behavior: smooth ? "smooth" : "auto" });
    }

    row.querySelectorAll<HTMLButtonElement>("[data-spot-thumb]").forEach((t) =>
      t.addEventListener("click", () => show(Number(t.dataset.spotThumb))),
    );
    pane.addEventListener("keydown", (e) => {
      if ((e.target as HTMLElement).closest("input, textarea")) return;
      if (e.key === "ArrowRight") (e.preventDefault(), show(current() + 1));
      if (e.key === "ArrowLeft") (e.preventDefault(), show(current() - 1));
    });

    // Touch and trackpads scroll the row natively; a mouse drags it, then it settles on the next or previous window.
    let x0 = 0;
    let left0 = 0;
    let down = false;
    let moved = false;
    row.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse" || e.button !== 0) return;
      x0 = e.clientX;
      left0 = row.scrollLeft;
      down = true;
      moved = false;
    });
    // The pointer is only captured once it really moves, so a plain click still reaches the entry under it.
    row.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - x0;
      if (!moved && Math.abs(dx) < 6) return;
      if (!moved) row.setPointerCapture(e.pointerId);
      moved = true;
      row.classList.add("is-dragging");
      row.scrollLeft = left0 - dx;
    });
    const release = (e: PointerEvent) => {
      if (!down) return;
      down = false;
      if (!moved) return;
      const dx = e.clientX - x0;
      const from = indexAt(left0);
      row.classList.remove("is-dragging");
      show(Math.abs(dx) > 40 ? from + (dx < 0 ? 1 : -1) : from);
    };
    row.addEventListener("pointerup", release);
    row.addEventListener("pointercancel", release);
    // A drag never opens an entry, and a click on the peeking window brings it in instead of opening it.
    row.addEventListener(
      "click",
      (e) => {
        const card = (e.target as HTMLElement).closest<HTMLElement>(".card");
        const k = card ? cards.indexOf(card) : -1;
        const peeking = k >= 0 && k !== current() && !(e.target as HTMLElement).closest("[data-spot-thumb]");
        if (!moved && !peeking) return;
        e.stopPropagation();
        e.preventDefault();
        if (!moved) show(k);
        moved = false;
      },
      { capture: true },
    );

    // The chat or the hero's `cd` pointing at one entry (src/scripts/point.ts) brings it forward first.
    row.addEventListener("point", (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>(".card");
      if (card) show(cards.indexOf(card));
    });
  });
</script>
