---
// A credentials section (Awards, Certifications) as a deck: each entry is its own small window (title bar, photo,
// text), stacked straight, with the next two tucked behind it and peeking out on the right. A swipe or drag slides
// the top card straight off to the left and the next steps forward; a swipe the other way brings it back. The arrow
// keys do the same, and a pill under the deck shows how, leaving once the visitor has. A click on the top card opens
// it in full in the modal (with the link to proof). Without JS every entry shows, one under the other.
import { isSet } from "../data/placeholders";
import { slug as toSlug } from "../data/slug";
import Detail from "./Detail.astro";

export interface Credential {
  title: string;
  year: string;
  /** Short name of who gave it (e.g. "TUP Manila"). */
  caption: string;
  /** Full name of who gave it, shown in the modal. */
  issuer: string;
  /** Extra lines for the modal (e.g. "GWA 1.36", "Credential ID: …"); the first one also shows on the card. */
  details?: string[];
  href?: string;
  image?: string;
  imageAlt?: string;
  /** A certificate or letter: shown whole on a mat instead of filling (and cropping) the photo box. */
  document?: boolean;
}

interface Props {
  id: string;
  title: string;
  entries: Credential[];
  /** Label shown where an entry has no picture yet. */
  placeholder: string;
  /** Label for the modal's link to proof, e.g. "verify". */
  linkLabel: string;
}

const { id, title, entries, placeholder, linkLabel } = Astro.props;
const slug = toSlug(title);
const n = entries.length;
const pad = (i: number) => String(i).padStart(2, "0");
// A deck of certificates (all documents, all landscape) gets a landscape photo box so each one shows big.
const allDocs = entries.length > 0 && entries.every((e) => e.document);
// The line under a title: its first detail, or the full issuer when that says more than the short caption.
const line = (e: Credential) => (e.details ?? []).find(isSet) ?? (e.issuer !== e.caption ? e.issuer : "");
const name = (e: Credential) => toSlug(e.title) || slug;
---

{
  n > 0 && (
    <section id={id} class="shell screen" aria-labelledby={`${id}-title`}>
      <div class="pane" data-pane={slug}>
        <h2 id={`${id}-title`} class="absolute inset-x-0 top-0 truncate text-small font-normal text-ink">
          <span class="sr-only">{title}</span>
          <span aria-hidden="true"><span class="text-accent">~/</span>{slug}</span>
        </h2>

        <ol class:list={["deck", allDocs && "docs"]} data-deck data-reveal aria-live="polite">
          {entries.map((e, i) => (
            <li class="card tile deck-card relative" style={`--k:${i}`}>
              <div class="tile-top">
                <span class="tile-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="tile-title"><strong>{name(e)}</strong></span>
                <span class="tile-badge">{e.year}</span>
              </div>
              <div class:list={["photo", { doc: e.document }]}>
                {e.image ? (
                  <img src={e.image} alt={e.imageAlt ?? ""} loading="lazy" decoding="async" />
                ) : (
                  <span class="eyebrow text-muted">[{placeholder}]</span>
                )}
              </div>
              <div class="text">
                <p class="eyebrow text-muted">{[e.caption, e.year].filter(isSet).join(" · ")}</p>
                <h3 class="mt-2 text-heading font-normal">
                  <button type="button" data-detail-open class="cursor-pointer text-left after:absolute after:inset-0 after:z-[1] after:content-['']">
                    {e.title}
                  </button>
                </h3>
                {line(e) && <p class="mt-2 text-small text-ink-soft">{line(e)}</p>}
              </div>
              <span class="dim" aria-hidden="true"></span>
              <Detail
                path={`${slug}/${name(e)}`}
                title={e.title}
                meta={[e.year, e.issuer]}
                image={e.image}
                imageAlt={e.imageAlt}
                placeholder={placeholder}
                text={(e.details ?? []).filter(isSet)}
                link={isSet(e.href) ? { href: e.href, label: linkLabel } : undefined}
              />
            </li>
          ))}
        </ol>
        {n > 1 && (
          <p class="hint-pill mt-8" data-deck-hint data-pause-offscreen aria-hidden="true">
            <span class="hint-icon pad"><i></i></span>
            <span><span class="tabular-nums"><span data-deck-count>01</span>/{pad(n)}</span> · swipe</span>
          </p>
        )}
      </div>
    </section>
  )
}

<style>
  .deck {
    --w: 420px; /* card width */
    --step: 22px; /* how far each card behind peeks out */
    display: grid;
    gap: 16px;
    width: min(var(--w), 100%);
    margin-inline: auto;
  }
  @media (max-width: 767px) {
    .deck {
      --w: 290px;
      --step: 12px;
    }
  }
  .deck-card {
    background: color-mix(in srgb, var(--color-ink) 2.5%, var(--color-paper));
  }
  .photo {
    position: relative;
    display: grid;
    place-items: center;
    height: clamp(220px, 40svh, 360px);
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-ph);
  }
  .photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .doc img {
    position: static;
    width: auto;
    height: auto;
    max-width: calc(100% - 40px);
    max-height: calc(100% - 40px);
    border: 1px solid var(--color-line);
    box-shadow: 0 12px 32px -16px rgb(0 0 0 / 0.35);
  }
  @media (max-width: 767px) {
    .doc img {
      max-width: calc(100% - 20px);
    }
  }
  /* The photo box takes the pictures' shape, so they fill it: 4:3 for the award photos, 16:9 for certificates (most
     are about that wide; each still shows whole). */
  .photo {
    height: auto;
    aspect-ratio: 4 / 3;
  }
  .docs .photo {
    aspect-ratio: 16 / 9;
  }
  .docs .doc img {
    max-width: calc(100% - 16px);
    max-height: calc(100% - 16px);
  }
  .text {
    flex: 1;
    min-width: 0;
    padding: 18px 20px 20px;
  }
  /* Cards behind the top one fade toward the page, more the deeper they sit. */
  .dim {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: var(--color-paper);
    opacity: 0;
    pointer-events: none;
  }

  /* The deck (with JS): every card in the same spot, as tall as the tallest, the deck as wide as a card plus the
     two that peek out. The script sets each card's --k: 0 on top, 1 and 2 behind it, more hidden behind those, below
     0 already swiped off to the left. */
  :global(.js) .deck {
    width: min(calc(var(--w) + 2 * var(--step)), 100%);
    padding-right: calc(2 * var(--step));
    touch-action: pan-y;
    user-select: none;
  }
  :global(.js) .deck-card {
    --d: clamp(0, var(--k), 2);
    grid-area: 1 / 1;
    z-index: calc(10 - var(--k));
    transform: translateX(calc(var(--d) * var(--step) + var(--drag, 0px))) scale(calc(1 - var(--d) * 0.05));
    transform-origin: 100% 50%;
    box-shadow: 0 18px 40px -22px rgb(27 36 48 / 0.3);
    transition:
      transform 0.45s var(--ease-out-soft),
      opacity 0.45s var(--ease-out-soft),
      visibility 0.45s;
  }
  :global(.js) .deck-card .dim {
    opacity: calc(var(--d) * 0.2);
    transition: opacity 0.45s var(--ease-out-soft);
  }
  /* Deeper than two behind: waiting, out of sight. */
  :global(.js) .deck-card[data-hidden] {
    opacity: 0;
    visibility: hidden;
  }
  /* Swiped off: slid straight out to the left and gone. */
  :global(.js) .deck-card[data-gone] {
    transform: translateX(calc(-100% - 40px));
    opacity: 0;
    visibility: hidden;
  }
  /* While a finger or the mouse holds the top card, it follows without easing. */
  :global(.js) .deck.is-dragging .deck-card {
    transition: none;
  }
  @media (max-width: 767px) {
    .text {
      padding: 16px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-deck]").forEach((deck) => {
    const pane = deck.closest<HTMLElement>(".pane")!;
    const cards = [...deck.querySelectorAll<HTMLElement>(".deck-card")];
    const counts = pane.querySelectorAll<HTMLElement>("[data-deck-count]");
    const hint = pane.querySelector<HTMLElement>("[data-deck-hint]");
    const n = cards.length;
    let current = 0;

    // Each card's place in the deck; only the top one can be clicked or focused.
    function place() {
      cards.forEach((card, i) => {
        const k = i - current;
        card.style.setProperty("--k", String(k));
        card.toggleAttribute("data-gone", k < 0);
        card.toggleAttribute("data-hidden", k > 2);
        card.inert = k !== 0;
      });
      counts.forEach((c) => (c.textContent = String(current + 1).padStart(2, "0")));
    }

    function show(i: number) {
      const to = Math.min(n - 1, Math.max(0, i));
      if (to === current) return;
      current = to;
      place();
      hint?.classList.add("is-done");
    }
    place();

    pane.addEventListener("keydown", (e) => {
      if ((e.target as HTMLElement).closest("input, textarea")) return;
      if (e.key === "ArrowRight") (e.preventDefault(), show(current + 1));
      if (e.key === "ArrowLeft") (e.preventDefault(), show(current - 1));
    });

    // The top card follows a sideways drag and, let go far enough, slides off (left) or the last one comes back
    // (right); a short drag springs back. A tap still opens it.
    let x0 = 0;
    let y0 = 0;
    let dx = 0;
    let held = false;
    const top = () => cards[current];
    deck.addEventListener("pointerdown", (e) => {
      if (n < 2) return;
      held = true;
      x0 = e.clientX;
      y0 = e.clientY;
      dx = 0;
    });
    deck.addEventListener("pointermove", (e) => {
      if (!held) return;
      dx = e.clientX - x0;
      if (!deck.classList.contains("is-dragging")) {
        if (Math.abs(dx) < 8 || Math.abs(dx) < Math.abs(e.clientY - y0)) return;
        deck.classList.add("is-dragging");
        deck.setPointerCapture(e.pointerId);
      }
      // Past either end the card only gives a little.
      const end = (dx < 0 && current === n - 1) || (dx > 0 && current === 0);
      top().style.setProperty("--drag", `${end ? dx / 4 : Math.min(dx, 0)}px`);
    });
    const release = () => {
      if (!held) return;
      held = false;
      deck.classList.remove("is-dragging");
      top().style.removeProperty("--drag");
      if (dx < -60) show(current + 1);
      else if (dx > 60) show(current - 1);
    };
    deck.addEventListener("pointerup", release);
    deck.addEventListener("pointercancel", release);
    deck.addEventListener(
      "click",
      (e) => {
        if (Math.abs(dx) > 10) (e.stopPropagation(), e.preventDefault());
      },
      { capture: true },
    );

    // The chat or the hero's `cd` pointing at one entry (src/scripts/point.ts) brings it to the top first.
    deck.addEventListener("point", (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>(".deck-card");
      if (card) show(cards.indexOf(card));
    });
  });
</script>
