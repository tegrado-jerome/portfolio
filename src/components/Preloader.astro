---
// Full-screen boot screen in the page's own colours: the header as it will look, an empty page with "booting", and
// the status line at the bottom filling up as each part of the page really loads. The header and the status line sit
// exactly where the real ones are, so when it fades out the page appears around them without a jump. Follows the
// light and dark theme. Only shown when JS runs.
---

<div id="preloader" class="preloader" role="status" aria-label="Loading">
  <div class="boot-head" aria-hidden="true">
    <span class="logo size-8 bg-current text-ink"></span>
    <span class="hidden text-ink sm:inline"><span class="text-accent">~/</span>jerome-tegrado</span>
  </div>
  <p class="boot-mid text-muted" aria-hidden="true">booting<span class="caret"></span></p>
  <p class="boot-bar" aria-hidden="true">
    <span class="mode">tui</span>
    <span class="text-ink"><span class="text-accent">~/</span>booting</span>
    <span class="rail"><i id="preFill"></i></span>
    <span class="pct text-ink"><span id="preCount">0</span>%</span>
  </p>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var pre = document.getElementById("preloader");
    var countEl = document.getElementById("preCount");
    var fillEl = document.getElementById("preFill");
    if (!pre) return;

    function done() {
      root.classList.remove("is-preloading");
      document.dispatchEvent(new Event("preloader:done"));
    }

    // Every refresh is a fresh visit: the browser doesn't restore the old scroll spot, and a leftover #section
    // is dropped so the page opens on the hero again.
    if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    var nav = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
    if (nav && nav.type === "reload" && location.hash) {
      history.replaceState(null, "", location.pathname + location.search);
    }
    if (!location.hash) window.scrollTo(0, 0);

    // Plays on every load; skipped only when arriving on a section link (e.g. /#projects).
    if (location.hash && location.hash !== "#top") {
      pre.remove();
      return;
    }

    root.classList.add("is-preloading");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var duration = reduce ? 400 : 3500; // the shortest the boot runs
    var MAX = 10000; // on a very slow connection, open the site anyway after this
    var start = null;

    // The boot does real work: each part waits for its piece of the page to load, including the images further
    // down that would otherwise load lazily on scroll, so the site is ready once the screen lifts.
    // Order: the hero and projects (with the fonts), skills, awards (and the rest), the chat (then the full page).
    var groups = [
      { sel: "#top img, #projects img", waits: [document.fonts ? document.fonts.ready : null] },
      { sel: "#skills img" },
      { sel: "#awards img, #certifications img, #testimonials img" },
      {
        sel: "#chat img, [data-chat-open] img",
        waits: [new Promise(function (r) { addEventListener("load", r, { once: true }); })],
      },
    ];
    var collected = false;
    function track(promise, group) {
      group.total++;
      promise.then(function () {
        group.done++;
      });
    }
    function imageReady(img) {
      if (img.complete) return Promise.resolve();
      img.loading = "eager"; // start lazy images now
      return new Promise(function (r) {
        img.addEventListener("load", r, { once: true });
        img.addEventListener("error", r, { once: true });
      });
    }
    function collect() {
      groups.forEach(function (g) {
        g.total = 0;
        g.done = 0;
        (g.waits || []).forEach(function (p) { if (p) track(p, g); });
        if (g.sel) document.querySelectorAll(g.sel).forEach(function (img) { track(imageReady(img), g); });
      });
      collected = true;
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", collect, { once: true });
    else collect();

    function finish() {
      pre.classList.add("is-done");
      done();
      var remove = function () { pre.remove(); };
      pre.addEventListener("transitionend", remove, { once: true });
      setTimeout(remove, 1200);
    }

    // The parts fill one after another on an easing clock, and none runs ahead of what has really loaded. The bar
    // in the status line shows their sum.
    function tick(now) {
      if (start === null) start = now;
      var t = Math.min((now - start) / duration, 1);
      var eased = 1 - Math.pow(1 - t, 2);
      var timeout = now - start >= MAX;
      var sum = 0;
      for (var p = 0; p < groups.length; p++) {
        var g = groups[p];
        var real = timeout ? 1 : collected ? (g.total ? g.done / g.total : 1) : 0;
        sum += Math.min(Math.max(0, Math.min(1, eased * groups.length - p)), real);
      }
      var share = sum / groups.length;
      var pct = Math.round(share * 100);
      countEl.textContent = pct;
      fillEl.style.transform = "scaleX(" + share + ")";
      if (pct < 100) requestAnimationFrame(tick);
      else setTimeout(finish, reduce ? 60 : 320);
    }
    requestAnimationFrame(tick);
  })();
</script>

<style>
  .preloader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    flex-direction: column;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 1.6;
    transition: opacity 0.6s var(--ease-out-soft);
  }
  :global(.js) .preloader {
    display: flex;
  }
  /* It fades out, and the page underneath appears around the same header and status line. */
  .preloader.is-done {
    opacity: 0;
    pointer-events: none;
  }
  :global(.is-preloading) :global(body) {
    overflow: hidden;
  }

  /* The header as it will look (same size and spacing as Header.astro), without its buttons. */
  .boot-head {
    display: flex;
    flex: none;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-line);
  }
  @media (min-width: 640px) {
    .boot-head {
      padding: 20px clamp(20px, 10vw, 200px);
    }
  }
  .logo {
    display: block;
    mask: url("/images/logo.png") center / contain no-repeat;
  }

  .boot-mid {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    margin: 0;
  }

  /* The status line, sized like StatusBar.astro, with a thin bar that fills as the page loads. */
  .boot-bar {
    display: flex;
    flex: none;
    align-items: center;
    gap: 14px;
    height: 32px;
    margin: 0;
    padding: 0 20px env(safe-area-inset-bottom);
    border-top: 1px solid var(--color-line);
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .boot-bar {
      padding-inline: clamp(20px, 10vw, 200px);
    }
  }
  .mode {
    padding-inline: 8px;
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .rail {
    position: relative;
    width: clamp(80px, 14vw, 180px);
    height: 2px;
    overflow: hidden;
    background: var(--color-line);
  }
  .rail i {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .pct {
    min-width: 4ch;
    margin-left: auto;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 4px;
    vertical-align: -0.18em;
    background: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: caret-blink 1.1s steps(1) infinite;
    }
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .preloader {
      transition-duration: 0.2s;
    }
  }
</style>
