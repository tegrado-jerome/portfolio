---
// Full-screen boot screen (a TUI boot log, like terminal-style portfolios): boot lines tick off with [ ok ]
// over a text progress bar, then the screen slides up. Only shown when JS runs.
const steps = [
  "loading portfolio",
  "mounting ~/skills",
  "mounting ~/selected-work",
  "mounting ~/awards",
  "starting ai chat",
  "status: online",
];
const CELLS = 24;
---

<div id="preloader" class="preloader" role="status" aria-label="Loading">
  <div class="boot">
    <p class="boot-title"><span>~/</span>jerome-tegrado</p>
    <ol class="boot-log">
      {
        steps.map((step) => (
          <li>
            <span class="ok">[ ok ]</span> {step}
          </li>
        ))
      }
    </ol>
    <p class="boot-bar" aria-hidden="true">
      [<span id="preBar">{"░".repeat(CELLS)}</span>] <span id="preCount">0</span>%
    </p>
  </div>
</div>

<script is:inline define:vars={{ CELLS }}>
  (function () {
    var root = document.documentElement;
    var pre = document.getElementById("preloader");
    var countEl = document.getElementById("preCount");
    var barEl = document.getElementById("preBar");
    if (!pre) return;
    var lines = pre.querySelectorAll(".boot-log li");

    function done() {
      root.classList.remove("is-preloading");
      document.dispatchEvent(new Event("preloader:done"));
    }

    // Arriving on a section link (e.g. /#work): skip the intro and jump straight there.
    if (location.hash && location.hash !== "#top") {
      pre.remove();
      return;
    }

    root.classList.add("is-preloading");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var duration = reduce ? 500 : 2200;
    var start = null;

    function finish() {
      pre.classList.add("is-done");
      done();
      var remove = function () { pre.remove(); };
      pre.addEventListener("transitionend", remove, { once: true });
      setTimeout(remove, 1400);
    }

    function tick(now) {
      if (start === null) start = now;
      var t = Math.min((now - start) / duration, 1);
      var pct = Math.round((1 - Math.pow(1 - t, 3)) * 100); // easeOutCubic
      var filled = Math.round((pct / 100) * CELLS);
      countEl.textContent = pct;
      barEl.textContent = "█".repeat(filled) + "░".repeat(CELLS - filled);
      // Each boot line ticks off as the bar passes its share.
      for (var i = 0; i < lines.length; i++) {
        if (pct >= ((i + 1) / (lines.length + 1)) * 100) lines[i].classList.add("is-on");
      }
      if (t < 1) requestAnimationFrame(tick);
      else setTimeout(finish, reduce ? 60 : 320);
    }
    requestAnimationFrame(tick);
  })();
</script>

<style>
  .preloader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: var(--color-night);
    color: #e6e9ee;
    font-family: var(--font-mono);
    transition: transform 1s cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
  }
  :global(.js) .preloader {
    display: flex;
  }
  .preloader.is-done {
    transform: translateY(-100%);
  }
  :global(.is-preloading) :global(body) {
    overflow: hidden;
  }

  /* A pane like the site's, in the night palette: title on the top border. */
  /* Sized to its lines, so the log sits centred with even space on both sides. */
  .boot {
    position: relative;
    width: fit-content;
    max-width: 100%;
    padding: 28px 22px 20px;
    border: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 2px;
    font-size: var(--text-body);
    line-height: 1.9;
  }
  .boot-title {
    position: absolute;
    top: -0.8em;
    left: 12px;
    padding-inline: 8px;
    background: var(--color-night);
    font-size: var(--text-small);
    line-height: 1.6;
  }
  .boot-title span {
    color: #8fb0e0;
  }
  .boot-log li {
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .boot-log li.is-on {
    opacity: 1;
    transform: none;
  }
  .ok {
    color: #5cc493;
  }
  .boot-bar {
    margin-top: 10px;
    color: rgb(255 255 255 / 0.85);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader {
      transition-duration: 0.3s !important;
    }
  }
</style>
