---
// Full-screen boot screen in the page's own colours (it follows the light and dark theme): the JT mark in the middle,
// "booting" typing itself out under it like the hero's prompt, and one thin bar with the percentage, filling as each
// part of the page really loads. At 100% the word backspaces and types "ready", then the screen fades into the page.
// Only shown when JS runs.
---

<div id="preloader" class="preloader" role="status" aria-label="Loading">
  <div class="boot" aria-hidden="true">
    <span class="logo"></span>
    <p class="word"><span id="preWord"></span><span class="caret"></span></p>
    <div class="meter">
      <span class="rail"><i id="preFill"></i></span>
      <span class="pct"><span id="preCount">0</span>%</span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var pre = document.getElementById("preloader");
    var countEl = document.getElementById("preCount");
    var fillEl = document.getElementById("preFill");
    var wordEl = document.getElementById("preWord");
    if (!pre) return;

    function done() {
      root.classList.remove("is-preloading");
      document.dispatchEvent(new Event("preloader:done"));
    }

    // Every refresh is a fresh visit: the browser doesn't restore the old scroll spot, and a leftover #section
    // is dropped so the page opens on the hero again.
    if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    var nav = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
    if (nav && nav.type === "reload" && location.hash) {
      history.replaceState(null, "", location.pathname + location.search);
    }
    if (!location.hash) window.scrollTo(0, 0);

    // Plays on every load; skipped only when arriving on a section link (e.g. /#projects).
    if (location.hash && location.hash !== "#top") {
      pre.remove();
      return;
    }

    root.classList.add("is-preloading");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var duration = reduce ? 400 : 3500; // the shortest the boot runs
    var MAX = 10000; // on a very slow connection, open the site anyway after this
    var start = null;

    // The boot does real work: each part waits for its piece of the page to load, including the images further
    // down that would otherwise load lazily on scroll, so the site is ready once the screen lifts.
    // Order: the hero and projects (with the fonts), skills, awards (and the rest), the chat (then the full page).
    var groups = [
      { sel: "#top img, #projects img", waits: [document.fonts ? document.fonts.ready : null] },
      { sel: "#skills img" },
      { sel: "#awards img, #certifications img, #testimonials img" },
      {
        sel: "#chat img, [data-chat-open] img",
        waits: [new Promise(function (r) { addEventListener("load", r, { once: true }); })],
      },
    ];
    var collected = false;
    function track(promise, group) {
      group.total++;
      promise.then(function () {
        group.done++;
      });
    }
    function imageReady(img) {
      if (img.complete) return Promise.resolve();
      img.loading = "eager"; // start lazy images now
      return new Promise(function (r) {
        img.addEventListener("load", r, { once: true });
        img.addEventListener("error", r, { once: true });
      });
    }
    function collect() {
      groups.forEach(function (g) {
        g.total = 0;
        g.done = 0;
        (g.waits || []).forEach(function (p) { if (p) track(p, g); });
        if (g.sel) document.querySelectorAll(g.sel).forEach(function (img) { track(imageReady(img), g); });
      });
      collected = true;
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", collect, { once: true });
    else collect();

    function finish() {
      pre.classList.add("is-done");
      done();
      var remove = function () { pre.remove(); };
      pre.addEventListener("transitionend", remove, { once: true });
      setTimeout(remove, 1200);
    }

    // The word types itself out at the hero prompt's pace (115ms a letter, 55ms to delete). While a letter is going
    // in, the cursor holds still; between, it blinks.
    var word = wordEl.parentNode;
    var typed = Promise.resolve();
    function later(ms) {
      return new Promise(function (r) { setTimeout(r, ms); });
    }
    function type(text) {
      if (reduce) {
        wordEl.textContent = text;
        return Promise.resolve();
      }
      word.classList.add("is-typing");
      var i = 0;
      function next() {
        if (i === text.length) {
          word.classList.remove("is-typing");
          return Promise.resolve();
        }
        wordEl.textContent = text.slice(0, ++i);
        return later(115).then(next);
      }
      return next();
    }
    function erase() {
      if (reduce) return Promise.resolve();
      word.classList.add("is-typing");
      function next() {
        var t = wordEl.textContent;
        if (!t) return Promise.resolve();
        wordEl.textContent = t.slice(0, -1);
        return later(55).then(next);
      }
      return next();
    }
    typed = later(reduce ? 0 : 250).then(function () { return type("booting"); });
    // At 100%: once "booting" has finished typing, it backspaces, types "ready", and the screen fades out.
    function arrive() {
      typed
        .then(erase)
        .then(function () { return type("ready"); })
        .then(function () { return later(reduce ? 60 : 350); })
        .then(finish);
    }

    // The parts fill one after another on an easing clock, and none runs ahead of what has really loaded. The bar
    // shows their sum.
    function tick(now) {
      if (start === null) start = now;
      var t = Math.min((now - start) / duration, 1);
      var eased = 1 - Math.pow(1 - t, 2);
      var timeout = now - start >= MAX;
      var sum = 0;
      for (var p = 0; p < groups.length; p++) {
        var g = groups[p];
        var real = timeout ? 1 : collected ? (g.total ? g.done / g.total : 1) : 0;
        sum += Math.min(Math.max(0, Math.min(1, eased * groups.length - p)), real);
      }
      var share = sum / groups.length;
      var pct = Math.round(share * 100);
      countEl.textContent = pct;
      fillEl.style.transform = "scaleX(" + share + ")";
      if (pct < 100) requestAnimationFrame(tick);
      else arrive();
    }
    requestAnimationFrame(tick);
  })();
</script>

<style>
  .preloader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    flex-direction: column;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 1.6;
    transition: opacity 0.6s var(--ease-out-soft);
  }
  :global(.js) .preloader {
    display: flex;
  }
  /* It fades out into the page underneath. */
  .preloader.is-done {
    opacity: 0;
    pointer-events: none;
  }
  :global(.is-preloading) :global(body) {
    overflow: hidden;
  }

  /* The mark, the word and the bar, centred. */
  .boot {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .logo {
    display: block;
    width: 40px;
    height: 40px;
    background: var(--color-ink);
    mask: url("/images/logo.png") center / contain no-repeat;
  }
  .word {
    min-width: 9ch;
    margin: 16px 0 0;
    color: var(--color-muted);
    text-align: center;
    white-space: nowrap;
  }
  .meter {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
  }
  .rail {
    position: relative;
    width: clamp(160px, 24vw, 240px);
    height: 2px;
    overflow: hidden;
    background: var(--color-line);
  }
  .rail i {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .pct {
    min-width: 4ch;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.18em;
    background: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: caret-blink 1.1s steps(1) infinite;
    }
    .is-typing .caret {
      animation: none;
    }
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .preloader {
      transition-duration: 0.2s;
    }
  }
</style>
