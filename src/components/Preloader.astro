---
// Full-screen boot log (a Linux boot / Hyper-style terminal): timestamped lines tick off with "ok" at the top left,
// the path and a block progress bar sit on the bottom line, then the screen slides up. Only shown when JS runs.
const steps = [
  "loading portfolio",
  "mounting ~/selected-work",
  "mounting ~/skills",
  "mounting ~/awards",
  "starting ai chat",
  "status: online",
];
const CELLS = 12;
---

<div id="preloader" class="preloader" role="status" aria-label="Loading">
  <ol class="boot-log">
    {
      steps.map((step) => (
        <li>
          <span class="time">[0.0s]</span> <span class="ok">ok</span> {step}
        </li>
      ))
    }
  </ol>
  <p class="boot-foot">
    <span><span class="path">~/</span>jerome-tegrado</span>
    <span class="progress" aria-hidden="true">
      <span id="preBar" class="blocks">{Array.from({ length: CELLS }, () => <i />)}</span>
      <span class="pct"><span id="preCount">0</span>%</span>
    </span>
  </p>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var pre = document.getElementById("preloader");
    var countEl = document.getElementById("preCount");
    if (!pre) return;
    var lines = pre.querySelectorAll(".boot-log li");
    var cells = pre.querySelectorAll("#preBar i");

    function done() {
      root.classList.remove("is-preloading");
      document.dispatchEvent(new Event("preloader:done"));
    }

    // Every refresh is a fresh visit: the browser doesn't restore the old scroll spot, and a leftover #section
    // is dropped so the page opens on the hero again.
    if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    var nav = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
    if (nav && nav.type === "reload" && location.hash) {
      history.replaceState(null, "", location.pathname + location.search);
    }
    if (!location.hash) window.scrollTo(0, 0);

    // Plays on every load; skipped only when arriving on a section link (e.g. /#work).
    if (location.hash && location.hash !== "#top") {
      pre.remove();
      return;
    }

    root.classList.add("is-preloading");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var duration = reduce ? 400 : 3500; // the shortest the boot runs
    var MAX = 10000; // on a very slow connection, open the site anyway after this
    var start = null;
    var shown = 0;
    var lastStamp = 0;

    // The boot does real work: each line waits for its part of the page to load, including the images further
    // down that would otherwise load lazily on scroll, so the site is ready once the screen lifts.
    // Line order matches the steps: hero + fonts, work, skills, awards (and the rest), chat, then the full page.
    var groups = [
      { sel: "#top img", waits: [document.fonts ? document.fonts.ready : null] },
      { sel: "#work img" },
      { sel: "#skills img" },
      { sel: "#awards img, #certifications img, #testimonials img" },
      { sel: "#chat img, [data-chat-open] img" },
      { sel: "", waits: [new Promise(function (r) { addEventListener("load", r, { once: true }); })] },
    ];
    var total = 0;
    var loaded = 0;
    var collected = false;
    function track(promise, group) {
      total++;
      group.pending++;
      promise.then(function () {
        loaded++;
        group.pending--;
      });
    }
    function imageReady(img) {
      if (img.complete) return Promise.resolve();
      img.loading = "eager"; // start lazy images now
      return new Promise(function (r) {
        img.addEventListener("load", r, { once: true });
        img.addEventListener("error", r, { once: true });
      });
    }
    function collect() {
      groups.forEach(function (g) {
        g.pending = 0;
        (g.waits || []).forEach(function (p) { if (p) track(p, g); });
        if (g.sel) document.querySelectorAll(g.sel).forEach(function (img) { track(imageReady(img), g); });
      });
      collected = true;
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", collect, { once: true });
    else collect();

    function finish() {
      pre.classList.add("is-done");
      done();
      var remove = function () { pre.remove(); };
      pre.addEventListener("transitionend", remove, { once: true });
      setTimeout(remove, 1400);
    }

    function tick(now) {
      if (start === null) start = now;
      var t = Math.min((now - start) / duration, 1);
      var timeout = now - start >= MAX;
      // The bar never runs ahead of what has really loaded.
      var real = collected && total ? loaded / total : 0;
      var pct = Math.round(Math.min(1 - Math.pow(1 - t, 2), timeout ? 1 : real) * 100);
      var filled = Math.round((pct / 100) * cells.length);
      countEl.textContent = pct;
      for (var c = 0; c < cells.length; c++) cells[c].className = c < filled ? "on" : "";
      // A line appears once its time comes and its part of the page has loaded. The cursor sits at the end of the
      // newest line.
      while (
        shown < lines.length &&
        t >= (shown + 1) / (lines.length + 1) &&
        (timeout || (collected && groups[shown].pending === 0))
      ) {
        if (shown > 0) lines[shown - 1].classList.remove("is-last");
        // Stamped in half-second steps (0.5s, 1.0s…): the real time rounded to the nearest step, always counting up.
        lastStamp = Math.max(lastStamp + 0.5, Math.round(((now - start) / 1000) * 2) / 2);
        lines[shown].querySelector(".time").textContent = "[" + lastStamp.toFixed(1) + "s]";
        lines[shown].classList.add("is-on", "is-last");
        shown++;
      }
      if (pct < 100 || shown < lines.length) requestAnimationFrame(tick);
      else setTimeout(finish, reduce ? 60 : 320);
    }
    requestAnimationFrame(tick);
  })();
</script>

<style>
  .preloader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(22px, 4vw, 48px);
    background: var(--color-night);
    color: #e6e9ee;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 1.95;
    transition: transform 1s cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
  }
  :global(.js) .preloader {
    display: flex;
  }
  .preloader.is-done {
    transform: translateY(-100%);
  }
  :global(.is-preloading) :global(body) {
    overflow: hidden;
  }

  .boot-log li {
    opacity: 0;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .boot-log li.is-on {
    opacity: 1;
  }
  .time,
  .pct {
    color: rgb(230 233 238 / 0.45);
    font-variant-numeric: tabular-nums;
  }
  .ok {
    color: #5cc493;
  }
  .path {
    color: #8fb0e0;
  }
  /* A block cursor after the newest line. */
  .boot-log li.is-last::after {
    content: "";
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.18em;
    background: currentColor;
  }

  /* The bottom line: the path on the left, the block bar and % on the right. The blocks are drawn in CSS since
     the web font has no block glyphs. */
  .boot-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    white-space: nowrap;
  }
  .progress {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .blocks {
    display: inline-flex;
    gap: 2px;
  }
  .blocks i {
    /* A touch narrower on the smallest phones, so the bottom line stays on one line. */
    width: clamp(4px, 1.6vw, 6px);
    height: 12px;
    background: rgb(230 233 238 / 0.14);
  }
  .blocks i.on {
    background: #e6e9ee;
  }
  .pct {
    min-width: 4ch;
    text-align: right;
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader {
      transition-duration: 0.3s !important;
    }
  }
</style>
