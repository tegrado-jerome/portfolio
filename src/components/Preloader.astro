---
// Full-screen boot log (a Linux boot / Hyper-style terminal): timestamped lines tick off with "ok" at the top left,
// the path and a block progress bar sit on the bottom line, then the screen slides up. Only shown when JS runs.
const steps = [
  "loading portfolio",
  "mounting ~/selected-work",
  "mounting ~/skills",
  "mounting ~/awards",
  "starting ai chat",
  "status: online",
];
const CELLS = 12;
---

<div id="preloader" class="preloader" role="status" aria-label="Loading">
  <ol class="boot-log">
    {
      steps.map((step) => (
        <li>
          <span class="time">[0.000]</span> <span class="ok">ok</span> {step}
        </li>
      ))
    }
  </ol>
  <p class="boot-foot">
    <span><span class="path">~/</span>jerome-tegrado</span>
    <span class="progress" aria-hidden="true">
      <span id="preBar" class="blocks">{Array.from({ length: CELLS }, () => <i />)}</span>
      <span class="pct"><span id="preCount">0</span>%</span>
    </span>
  </p>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var pre = document.getElementById("preloader");
    var countEl = document.getElementById("preCount");
    if (!pre) return;
    var lines = pre.querySelectorAll(".boot-log li");
    var cells = pre.querySelectorAll("#preBar i");

    function done() {
      root.classList.remove("is-preloading");
      document.dispatchEvent(new Event("preloader:done"));
    }

    // Every refresh is a fresh visit: the browser doesn't restore the old scroll spot, and a leftover #section
    // is dropped so the page opens on the hero again.
    if ("scrollRestoration" in history) history.scrollRestoration = "manual";
    var nav = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
    if (nav && nav.type === "reload" && location.hash) {
      history.replaceState(null, "", location.pathname + location.search);
    }
    if (!location.hash) window.scrollTo(0, 0);

    // Plays on every load; skipped only when arriving on a section link (e.g. /#work).
    if (location.hash && location.hash !== "#top") {
      pre.remove();
      return;
    }

    root.classList.add("is-preloading");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var duration = reduce ? 400 : 3500;
    var start = null;
    var shown = 0;

    function finish() {
      pre.classList.add("is-done");
      done();
      var remove = function () { pre.remove(); };
      pre.addEventListener("transitionend", remove, { once: true });
      setTimeout(remove, 1400);
    }

    function tick(now) {
      if (start === null) start = now;
      var t = Math.min((now - start) / duration, 1);
      var pct = Math.round((1 - Math.pow(1 - t, 2)) * 100); // easeOutQuad: steady, slowing a little at the end
      var filled = Math.round((pct / 100) * cells.length);
      countEl.textContent = pct;
      for (var c = 0; c < cells.length; c++) cells[c].className = c < filled ? "on" : "";
      // The lines appear at even times across the boot, stamped with the real time since it began.
      // The cursor sits at the end of the newest line.
      while (shown < lines.length && t >= (shown + 1) / (lines.length + 1)) {
        if (shown > 0) lines[shown - 1].classList.remove("is-last");
        lines[shown].querySelector(".time").textContent = "[" + ((now - start) / 1000).toFixed(3) + "]";
        lines[shown].classList.add("is-on", "is-last");
        shown++;
      }
      if (t < 1) requestAnimationFrame(tick);
      else setTimeout(finish, reduce ? 60 : 320);
    }
    requestAnimationFrame(tick);
  })();
</script>

<style>
  .preloader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(22px, 4vw, 48px);
    background: var(--color-night);
    color: #e6e9ee;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: 1.95;
    transition: transform 1s cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
  }
  :global(.js) .preloader {
    display: flex;
  }
  .preloader.is-done {
    transform: translateY(-100%);
  }
  :global(.is-preloading) :global(body) {
    overflow: hidden;
  }

  .boot-log li {
    opacity: 0;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .boot-log li.is-on {
    opacity: 1;
  }
  .time,
  .pct {
    color: rgb(230 233 238 / 0.45);
    font-variant-numeric: tabular-nums;
  }
  .ok {
    color: #5cc493;
  }
  .path {
    color: #8fb0e0;
  }
  /* A block cursor after the newest line. */
  .boot-log li.is-last::after {
    content: "";
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.18em;
    background: currentColor;
  }

  /* The bottom line: the path on the left, the block bar and % on the right. The blocks are drawn in CSS since
     the web font has no block glyphs. */
  .boot-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    white-space: nowrap;
  }
  .progress {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .blocks {
    display: inline-flex;
    gap: 2px;
  }
  .blocks i {
    /* A touch narrower on the smallest phones, so the bottom line stays on one line. */
    width: clamp(4px, 1.6vw, 6px);
    height: 12px;
    background: rgb(230 233 238 / 0.14);
  }
  .blocks i.on {
    background: #e6e9ee;
  }
  .pct {
    min-width: 4ch;
    text-align: right;
  }

  @media (prefers-reduced-motion: reduce) {
    .preloader {
      transition-duration: 0.3s !important;
    }
  }
</style>
