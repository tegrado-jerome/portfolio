---
import { faArrowRight } from "@fortawesome/free-solid-svg-icons";
import { site } from "../data/site";
import Icon from "./Icon.astro";

const { archive } = site;
// Back to front: right card, middle card, left card.
const cards = ["right", "middle", "left"] as const;
---

{
  archive.show && (
    <section id="archive" class="shell pt-[clamp(30px,5vw,60px)] pb-[clamp(60px,8vw,110px)]" aria-labelledby="archive-title">
      <div class="mb-[clamp(50px,8vw,100px)] h-px bg-line" aria-hidden="true" />
      <div class="archive-grid grid items-center gap-[clamp(24px,5vw,60px)] max-md:justify-items-start">
        <h2 id="archive-title" data-reveal class="font-serif text-[clamp(42px,5vw,72px)] leading-none font-normal">
          {archive.title}
        </h2>

        <div data-reveal style="--i:1">
        <a href={archive.href} class="folder" aria-label={`${archive.title} — open the folder`}>
          <span class="folder__back" />
          {cards.map((pos, i) => (
            <span class:list={["folder__card", `folder__card--${pos}`]}>
              {archive.images[i] ? (
                <img src={archive.images[i]} alt="" loading="lazy" />
              ) : (
                <span class="folder__ph" data-tone={i}>
                  [IMAGE]
                </span>
              )}
            </span>
          ))}
          <span class="folder__front" aria-hidden="true">
            <Icon icon={faArrowRight} class="folder__arrow" />
          </span>
        </a>
        </div>

        <p data-reveal style="--i:2" class="max-w-[260px] text-[13px] leading-[1.5] text-muted md:justify-self-end md:text-right">
          <em class="font-serif text-[15px] text-ink-soft">noun</em> / {archive.description}
        </p>
      </div>
    </section>
  )
}

<style>
  @media (min-width: 768px) {
    .archive-grid {
      grid-template-columns: 1fr auto 1fr;
    }
  }

  .folder {
    --folder-scale: 0.74;
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: 366px;
    height: 300px;
    transform: scale(var(--folder-scale));
    transform-origin: center;
    /* reclaim the space freed by scaling */
    margin: calc((var(--folder-scale) - 1) * 150px) calc((var(--folder-scale) - 1) * 183px);
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 767px) {
    .folder {
      --folder-scale: 0.58;
    }
  }
  .folder > :global(*) {
    position: absolute;
  }

  .folder__back {
    left: 26px;
    top: 22px;
    width: 313px;
    height: 278px;
    background: var(--color-night);
    border-radius: 22px;
    box-shadow: 0 0 22px 4px rgb(0 0 0 / 0.15);
  }

  .folder__card {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.45s cubic-bezier(0.2, 0.75, 0.2, 1);
  }
  .folder__card img,
  .folder__ph {
    display: block;
    width: 157px;
    height: 222px;
    object-fit: cover;
    border-radius: 7px;
    box-shadow: 0 0 9px rgb(0 0 0 / 0.08);
  }
  .folder__ph {
    display: grid;
    place-items: center;
    font-size: 10px;
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--color-muted);
    background: var(--color-ph);
  }
  .folder__ph[data-tone="1"] {
    background: color-mix(in srgb, var(--color-ph), var(--color-ink) 8%);
  }
  .folder__ph[data-tone="2"] {
    background: color-mix(in srgb, var(--color-ph), var(--color-paper) 60%);
  }

  .folder__card--right {
    left: 140px;
    top: 43px;
    width: 184px;
    height: 241px;
  }
  .folder__card--right > :global(*) {
    transform: rotate(7.28deg);
  }
  .folder__card--middle {
    left: 102px;
    top: 29px;
    width: 172px;
    height: 233px;
  }
  .folder__card--middle > :global(*) {
    transform: rotate(-3.84deg);
  }
  .folder__card--left {
    left: 40px;
    top: 0;
    width: 210px;
    height: 256px;
  }
  .folder__card--left > :global(*) {
    transform: rotate(-15.13deg);
  }

  .folder__front {
    left: 3px;
    top: 84px;
    width: 360px;
    height: 216px;
    display: grid;
    place-items: center;
    clip-path: path(
      "M22.2569 1.1123H171.943C176.98 1.11239 181.852 2.91136 185.681 6.18457L221.192 36.5439C225.424 40.1618 230.809 42.1504 236.376 42.1504H337.339C350.268 42.1506 360.168 53.6533 358.243 66.4385L338.625 196.752C337.068 207.095 328.18 214.745 317.72 214.745H43.1485C32.4626 214.745 23.4575 206.77 22.1641 196.163L1.27151 24.8125C-0.264428 12.2154 9.56644 1.1123 22.2569 1.1123Z"
    );
    background: linear-gradient(180deg, rgb(170 170 170 / 0.5), rgb(116 116 116 / 0.55));
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }
  .folder__front :global(.folder__arrow) {
    font-size: 30px;
    color: #fff;
    opacity: 0;
    transform: translate(-4px, 26px);
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.2, 0.75, 0.2, 1);
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.35));
  }

  .folder:is(:hover, :focus-visible) .folder__card--left {
    transform: translate(-6px, -30px);
  }
  .folder:is(:hover, :focus-visible) .folder__card--middle {
    transform: translate(8px, -26px);
  }
  .folder:is(:hover, :focus-visible) .folder__card--right {
    transform: translate(20px, -20px);
  }
  .folder:is(:hover, :focus-visible) :global(.folder__arrow) {
    opacity: 1;
    transform: translate(6px, 26px);
  }
</style>
