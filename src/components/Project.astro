---
import { faLock } from "@fortawesome/free-solid-svg-icons";
import type { Project } from "../data/projects";
import { isSet } from "../data/placeholders";
import { slug as toSlug } from "../data/slug";
import Detail from "./Detail.astro";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
  index: number;
  class?: string;
}

const { project, index, class: className } = Astro.props;
const slug = toSlug(project.title) || "project";
const href = !project.locked && isSet(project.href) ? project.href : undefined;
const number = String(index + 1).padStart(2, "0");
---

<!-- A bento tile: number, title, badge and visit on top, one line, then the cover running to the edge. An optional
     ticket stub closes it, tinted from the cover. The whole card opens the full project in a modal. -->
<article data-reveal class:list={["card tile relative", className]}>
  <div class="tile-top">
    <span class="tile-icon" aria-hidden="true">{number}</span>
    <h3 class="tile-title">
      <button type="button" data-detail-open class="cursor-pointer text-left after:absolute after:inset-0 after:z-[1] after:content-['']">
        {project.title}
      </button>
    </h3>
    {project.locked && <span class="tile-badge">nda</span>}
    {/* Every project shows visit. Until its real link is set it's a quiet stand-in, so the cards line up already. */}
    {
      !project.locked &&
        (href ? (
          <a href={href} target="_blank" rel="noopener noreferrer" class="tile-action tui-btn inline-flex h-7">
            [ visit ]
          </a>
        ) : (
          <span class="tile-action tui-btn pointer-events-none inline-flex h-7 opacity-60" aria-hidden="true">
            [ visit ]
          </span>
        ))
    }
  </div>
  <p class="tile-desc">{project.description}</p>

  <div class="tile-media">
    {
      project.image ? (
        <img src={project.image} alt={project.imageAlt ?? ""} loading="lazy" decoding="async" class="card-img" />
      ) : (
        <span class="eyebrow text-muted">[PROJECT IMAGE]</span>
      )
    }
    {
      project.locked && (
        <span class="lock absolute inset-0 flex flex-col items-center justify-center gap-2.5 bg-[rgb(18_18_18/0.5)] opacity-0 backdrop-blur-[2px] transition-opacity duration-[250ms]">
          <span class="inline-flex items-center gap-1.5 rounded-[2px] bg-white/95 px-3 py-1.5 eyebrow text-night">
            <Icon icon={faLock} class="text-[11px]" />
            Classified
          </span>
          {project.lockedNote && <span class="text-small text-white/90">{project.lockedNote}</span>}
        </span>
      )
    }
  </div>

  {
    project.stub && (
      <div class="stub" data-stub>
        <p class="stub-eyebrow">{project.stub.eyebrow}</p>
        <p class="stub-title">{project.stub.title}</p>
        <p class="stub-foot">
          <span>{project.stub.code}</span>
          <span>{project.year}</span>
        </p>
      </div>
    )
  }

  <Detail
    path={`projects/${slug}`}
    title={project.title}
    meta={[project.category, project.year]}
    image={project.image}
    imageAlt={project.imageAlt}
    placeholder="PROJECT IMAGE"
    text={[project.description]}
    tags={project.technologies.filter(Boolean)}
    locked={project.locked}
    lockedNote={project.lockedNote}
    link={href ? { href, label: "visit" } : undefined}
  />
</article>

<style>
  .card:hover .lock {
    opacity: 1;
  }
  /* The ticket stub: a tinted band with a perforated line and punched notches, like a receipt's tear-off.
     --tint comes from the cover image (see the script below); without one it's the accent. */
  .stub {
    --tint: var(--color-accent);
    position: relative;
    padding: 18px 18px 14px;
    background: linear-gradient(135deg, var(--tint), color-mix(in srgb, var(--tint) 70%, black));
    color: #fff;
    transition: background 0.4s ease;
  }
  .stub-eyebrow {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .stub-title {
    margin-top: 4px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.35;
    text-wrap: balance;
  }
  .stub-foot {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px dashed rgb(255 255 255 / 0.5);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .stub-foot span:last-child {
    font-weight: 600;
  }
  /* Punched notches at both ends of the perforation, in the card's own background so they look cut out. */
  .stub-foot::before,
  .stub-foot::after {
    content: "";
    position: absolute;
    top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-paper);
  }
  .stub-foot::before {
    left: -24px;
  }
  .stub-foot::after {
    right: -24px;
  }
</style>

<script>
  // Tints each ticket stub with its cover's main colour: the image is shrunk to a few pixels and averaged, then
  // darkened until white text on it stays readable (4.5:1).
  function tint(img: HTMLImageElement, stub: HTMLElement) {
    try {
      const canvas = document.createElement("canvas");
      canvas.width = canvas.height = 8;
      const ctx = canvas.getContext("2d", { willReadFrequently: true })!;
      ctx.drawImage(img, 0, 0, 8, 8);
      const data = ctx.getImageData(0, 0, 8, 8).data;
      let [r, g, b] = [0, 0, 0];
      for (let i = 0; i < data.length; i += 4) {
        r += data[i];
        g += data[i + 1];
        b += data[i + 2];
      }
      const n = data.length / 4;
      [r, g, b] = [r / n, g / n, b / n];
      const lum = (v: number) => {
        const c = v / 255;
        return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
      };
      for (let k = 0; k < 20 && 1.05 / (0.2126 * lum(r) + 0.7152 * lum(g) + 0.0722 * lum(b) + 0.05) < 4.5; k++) {
        [r, g, b] = [r * 0.88, g * 0.88, b * 0.88];
      }
      stub.style.setProperty("--tint", `rgb(${Math.round(r)} ${Math.round(g)} ${Math.round(b)})`);
    } catch {
      // A cross-origin image can't be read; the stub keeps the accent colour.
    }
  }
  document.querySelectorAll<HTMLElement>("[data-stub]").forEach((stub) => {
    const img = stub.closest(".card")?.querySelector<HTMLImageElement>(".tile-media img");
    if (!img) return;
    if (img.complete && img.naturalWidth) tint(img, stub);
    else img.addEventListener("load", () => tint(img, stub), { once: true });
  });
</script>
