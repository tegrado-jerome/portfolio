---
import { faLock } from "@fortawesome/free-solid-svg-icons";
import type { Project } from "../data/projects";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
  index: number;
  class?: string;
}

const { project, index, class: className } = Astro.props;
const number = String(index + 1).padStart(2, "0");
const isExternal = !!project.href && /^https?:\/\//.test(project.href);
const linkAttrs = isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {};
const href = project.locked ? "" : project.href;
const MediaTag = href ? "a" : "div";
---

<!-- Reference-style card: cover, title and one line. Other project data feeds structured data. -->
<article data-reveal class:list={["project flex flex-col", className]}>
  <MediaTag
    href={href || undefined}
    {...href && linkAttrs}
    aria-label={href ? project.title : undefined}
    tabindex={href ? -1 : undefined}
    class="media relative block aspect-[5/4] w-full overflow-hidden rounded-[2px] bg-ph transition-opacity duration-200 hover:opacity-90"
    data-locked={project.locked ? "" : undefined}
  >
    {
      project.image ? (
        <img src={project.image} alt={project.imageAlt ?? ""} loading="lazy" decoding="async" class="size-full object-cover" />
      ) : (
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-3">
          <span class="font-serif text-display text-ink/15" aria-hidden="true">
            {number}
          </span>
          <span class="eyebrow text-muted">[PROJECT IMAGE]</span>
        </div>
      )
    }
    {
      project.locked && (
        <span class="lock absolute inset-0 flex flex-col items-center justify-center gap-2.5 bg-[rgb(18_18_18/0.5)] opacity-0 backdrop-blur-[2px] transition-opacity duration-[250ms]">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/95 px-4 py-2 eyebrow text-night">
            <Icon icon={faLock} class="text-[11px]" />
            Classified
          </span>
          {project.lockedNote && <span class="text-small text-white/90">{project.lockedNote}</span>}
        </span>
      )
    }
  </MediaTag>

  <div class="pt-[18px]">
    <h3 class="mb-1 font-serif text-heading font-normal">
      {href ? <a href={href} {...linkAttrs} class="link-strong">{project.title}</a> : project.title}
    </h3>
    <p class="text-body text-ink-soft">{project.description}</p>
  </div>
</article>

<style>
  .media[data-locked]:hover .lock {
    opacity: 1;
  }

  /* Covers unveil upward with a slight zoom-out as they scroll in (gianlucagradogna.com, olhalazarieva.com). */
  :global(.js) .media {
    clip-path: inset(100% 0 0 0);
    transition:
      clip-path 1.2s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 0.2s ease;
  }
  :global(.js) .media > :not(.lock) {
    transform: scale(1.12);
    transition: transform 1.2s cubic-bezier(0.19, 1, 0.22, 1);
  }
  :global(.js) .project:global(.is-visible) .media {
    clip-path: inset(0);
  }
  :global(.js) .project:global(.is-visible) .media > :not(.lock) {
    transform: none;
  }
</style>
