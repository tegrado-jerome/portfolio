---
import { faLock } from "@fortawesome/free-solid-svg-icons";
import type { Project } from "../data/projects";
import { isSet } from "../data/placeholders";
import Detail from "./Detail.astro";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
  class?: string;
}

const { project, class: className } = Astro.props;
const slug = project.title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "project";
const href = !project.locked && isSet(project.href) ? project.href : undefined;
---

<!-- Reference-style card: cover, title and one line. The whole card opens the full project in a modal. -->
<article data-reveal class:list={["card relative flex flex-col", className]}>
  <div class="media relative block aspect-[5/4] w-full overflow-hidden rounded-[2px] bg-ph">
    {
      project.image ? (
        <img src={project.image} alt={project.imageAlt ?? ""} loading="lazy" decoding="async" class="card-img size-full object-cover" />
      ) : (
        <span class="eyebrow absolute inset-0 grid place-items-center text-muted">[PROJECT IMAGE]</span>
      )
    }
    {
      project.locked && (
        <span class="lock absolute inset-0 flex flex-col items-center justify-center gap-2.5 bg-[rgb(18_18_18/0.5)] opacity-0 backdrop-blur-[2px] transition-opacity duration-[250ms]">
          <span class="inline-flex items-center gap-1.5 rounded-[2px] bg-white/95 px-3 py-1.5 eyebrow text-night">
            <Icon icon={faLock} class="text-[11px]" />
            Classified
          </span>
          {project.lockedNote && <span class="text-small text-white/90">{project.lockedNote}</span>}
        </span>
      )
    }
  </div>

  <!-- The same order as every card on the site: title, the muted meta line, then the text. -->
  <div class="pt-4">
    <h3 class="text-heading font-normal">
      <button type="button" data-detail-open class="link-strong cursor-pointer text-left after:absolute after:inset-0 after:content-['']">
        {project.title}
      </button>
    </h3>
    <p class="text-small text-muted tabular-nums">{project.category} · {project.year}</p>
    <p class="mt-2 text-body text-ink-soft">{project.description}</p>
  </div>

  <Detail
    path={`projects/${slug}`}
    title={project.title}
    meta={[project.category, project.year]}
    image={project.image}
    imageAlt={project.imageAlt}
    placeholder="PROJECT IMAGE"
    text={[project.description]}
    tags={project.technologies.filter(Boolean)}
    locked={project.locked}
    lockedNote={project.lockedNote}
    link={href ? { href, label: "visit" } : undefined}
  />
</article>

<style>
  .card:hover .lock {
    opacity: 1;
  }
</style>
