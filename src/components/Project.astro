---
import { faLock } from "@fortawesome/free-solid-svg-icons";
import type { Project } from "../data/projects";
import { isSet } from "../data/placeholders";
import { slug as toSlug } from "../data/slug";
import Detail from "./Detail.astro";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
  index: number;
  /** The section it's in, for the modal's ~/path. */
  section?: string;
  /** Show the [ visit ] link (or its stand-in). */
  visit?: boolean;
}

const { project, index, section = "projects", visit = true } = Astro.props;
const gallery = project.gallery ?? [];
const slug = toSlug(project.title) || "project";
const href = !project.locked && isSet(project.href) ? project.href : undefined;
const number = String(index + 1).padStart(2, "0");
// The visit link names the site it opens; a long workers.dev address just says "site".
const host = href ? new URL(href).hostname.replace(/^www./, "") : "";
const visitLabel = host && !host.endsWith(".workers.dev") ? host : "site";
---

<!-- One card of the sticky stack (see Projects.astro): the story on the left (number and year, name, one line, stack,
     visit), the screenshot in a browser frame on the right; on phones the screenshot sits on top. NDA projects show
     "nda" and a private cover instead of visit. The whole card opens the full project in a modal. -->
<article class="card stack-card relative">
  <!-- The same terminal window as every other card: a title bar with three dots across the top. -->
  <div class="card-bar" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="info">
    <p class="text-small text-muted tabular-nums">{[number, project.year].filter(isSet).join(" · ")}</p>
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="name">
        <button type="button" data-detail-open class="cursor-pointer text-left after:absolute after:inset-0 after:z-[1] after:content-['']">
          {project.title}
        </button>
      </h3>
      {project.locked && <span class="nda">nda</span>}
    </div>
    <p class="text-small text-muted">{project.description}</p>
    <ul class="tags">
      {project.technologies.filter(Boolean).map((t) => <li>{t}</li>)}
    </ul>
    {/* Until a project's real link is set, visit is a quiet stand-in so every card reads the same. */}
    {
      visit && !project.locked &&
        (href ? (
          <a href={href} target="_blank" rel="noopener noreferrer" class="visit is-live tui-btn inline-flex">
            <span class="draw">visit {visitLabel}</span><span class="arr" aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="visit tui-btn pointer-events-none inline-flex opacity-60" aria-hidden="true">
            [ visit ]
          </span>
        ))
    }
  </div>

  <div class="shot">
    <div class="shot-view">
      {
        gallery.length > 1 ? (
          <div class="gallery" data-gallery style={`--n:${gallery.length}`}>
            {gallery.map((g, k) => (
              <picture class:list={["gallery-shot", !g.imageMobile && "is-wide"]} style={`--k:${k}`}>
                {g.imageMobile && <source media="(max-width: 767px)" srcset={g.imageMobile} />}
                <img src={g.image} alt={g.name} loading="lazy" decoding="async" class="card-img" />
                <span class="gallery-name" aria-hidden="true">{g.name}</span>
              </picture>
            ))}
            <div class="thumbs" role="group" aria-label="Screenshots">
              {gallery.map((g, k) => (
                <button type="button" class="thumb" aria-pressed={k === 0 ? "true" : "false"} data-thumb={k}>
                  {g.name}
                </button>
              ))}
            </div>
            <button type="button" class="fan-next" data-fan-next aria-label="Next screenshot"></button>
          </div>
        ) : project.image ? (
          <picture>
            {project.imageMobile && <source media="(max-width: 767px)" srcset={project.imageMobile} />}
            <img src={project.image} alt={project.imageAlt ?? ""} loading="lazy" decoding="async" class="card-img" />
          </picture>
        ) : (
          <span class="eyebrow text-muted">[PROJECT IMAGE]</span>
        )
      }
      {
        project.locked && (
          <span class="private">
            <Icon icon={faLock} class="text-[11px]" />
            private
          </span>
        )
      }
    </div>
  </div>

  <span class="dim" aria-hidden="true"></span>

  <Detail
    path={`${section}/${slug}`}
    title={project.title}
    meta={[project.category, project.year ?? ""]}
    image={project.image}
    imageAlt={project.imageAlt}
    placeholder="PROJECT IMAGE"
    text={[project.description]}
    tags={project.technologies.filter(Boolean)}
    locked={project.locked}
    lockedNote={project.lockedNote}
    link={href ? { href, label: "visit" } : undefined}
  />
</article>

<style>
  /* The site's one window (.tile in global.css): paper tint, hairline, 6px corners, no shadow; the story on the left
     and the screenshot as the right pane. */
  .stack-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    grid-template-rows: auto minmax(0, 1fr);
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-ink) 2.5%, var(--color-paper));
  }
  .card-bar {
    grid-column: 1 / -1;
    display: flex;
    gap: 5px;
    align-items: center;
    height: 40px;
    padding-inline: 12px;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-ink) 6%, var(--color-paper));
  }
  .card-bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-ink) 18%, var(--color-paper));
  }
  /* Darkens the card as later ones stack over it (its opacity is set in Projects.astro). A real element, so a change
     restyles only it, not the whole card. */
  .dim {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    background: #000;
    opacity: 0;
    pointer-events: none;
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    padding: clamp(16px, 2vw, 22px);
  }
  .name {
    font-size: var(--text-heading);
    font-weight: 400;
    line-height: 1.2;
  }
  .nda {
    flex: none;
    padding: 0 6px;
    border: 1px solid var(--color-muted);
    border-radius: 2px;
    color: var(--color-muted);
    font-size: 11px;
    line-height: 1.6;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    padding: 1px 7px;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    color: var(--color-ink-soft);
    font-size: 11px;
  }
  .visit {
    position: relative;
    z-index: 2;
    align-self: flex-start;
    margin-left: -8px;
    color: var(--color-ink);
  }
  /* A live link: an underline draws under it, rests, and draws again, and the arrow nudges toward the site, so it
     reads as clickable at a glance. Still under reduced motion: a plain underline. */
  .visit.is-live {
    gap: 4px;
  }
  .draw {
    padding-bottom: 2px;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
  }
  .arr {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .draw {
      animation: draw 3.2s ease-in-out infinite;
    }
    .arr {
      animation: nudge 3.2s ease-in-out infinite;
    }
  }
  @keyframes draw {
    0% {
      background-size: 0 1px;
      background-position: 0 100%;
    }
    40%,
    60% {
      background-size: 100% 1px;
      background-position: 0 100%;
    }
    61% {
      background-position: 100% 100%;
    }
    100% {
      background-size: 0 1px;
      background-position: 100% 100%;
    }
  }
  @keyframes nudge {
    0%,
    70%,
    100% {
      translate: 0 0;
    }
    80% {
      translate: 3px -3px;
    }
    90% {
      translate: 0 0;
    }
  }
  /* Its ink colour would otherwise beat the tui-btn hover and vanish on the inverted block. */
  .visit:hover,
  .visit:focus-visible {
    color: var(--color-paper);
  }
  /* The screenshot: the window's right pane. */
  .shot {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    border-left: 1px solid var(--color-line);
    background: var(--color-ph);
  }
  .shot-view {
    position: relative;
    display: grid;
    flex: 1;
    place-items: center;
    overflow: hidden;
    container-type: size;
    background: color-mix(in srgb, var(--color-ink) 5%, var(--color-paper));
  }
  /* The screenshot sits whole inside the pane as its own window, running off the right edge (or, on phones, centred and
     running off the bottom), so the pane's shape never crops away a site's headline. */
  .shot-view img {
    position: absolute;
    /* Centred top to bottom when the pane is tall enough (the 16:10 image is 62.5% of the pane's width tall). */
    top: max(9cqh, 50cqh - 31.25cqw);
    left: 7%;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    box-shadow: 0 18px 50px -20px rgb(0 0 0 / 0.35);
  }
  /* Several screenshots: on wide screens one shows at a time and the tabs at the bottom switch them. */
  .gallery {
    position: absolute;
    inset: 0;
  }
  .gallery-shot {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .gallery-shot[data-on] {
    opacity: 1;
  }
  .gallery-name {
    display: none;
  }
  .thumbs {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    z-index: 2;
    display: flex;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    background: var(--color-paper);
  }
  .thumb {
    flex: 1;
    padding: 6px 4px;
    color: var(--color-muted);
    font-size: 11px;
    white-space: nowrap;
    cursor: pointer;
  }
  .thumb:hover {
    color: var(--color-ink);
  }
  .thumb[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .fan-next {
    display: none;
  }
  .private {
    position: absolute;
    inset: 0;
    display: flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    background: rgb(27 36 48 / 0.55);
    color: #fff;
    font-size: var(--text-small);
  }
  /* Phones: screenshot on top, the story under it. */
  @media (max-width: 767px) {
    .stack-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr) auto;
    }
    .shot {
      order: -1;
      border-left: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .card-bar {
      order: -2;
    }
    .shot-view img {
      top: 20px;
      left: 50%;
      width: 80%;
      border-radius: 14px;
      transform: translateX(-50%);
    }
    /* Phones: the screenshots fan out like a hand of cards, the front one upright; a tap brings the next to the front. */
    .thumbs {
      display: none;
    }
    .gallery-shot {
      position: absolute;
      inset: 18px 0 0;
      z-index: calc(var(--n) - var(--k));
      opacity: 1;
      transform: translateX(calc(var(--k) * 9%)) rotate(calc(var(--k) * 4deg)) scale(calc(1 - var(--k) * 0.05));
      transform-origin: 50% 110%;
      transition: transform 0.45s var(--ease-out-soft);
    }
    .gallery .gallery-shot img {
      top: 0;
      width: 62%;
      border-radius: 14px;
    }
    /* A landscape photo (no phone-sized screenshot) fans out wider, so it doesn't shrink to a sliver. */
    .gallery .gallery-shot.is-wide img {
      top: 12%;
      width: 84%;
      border-radius: 6px;
    }
    .gallery-name {
      position: absolute;
      top: 10px;
      left: calc(19% + 10px);
      display: block;
      padding: 1px 6px;
      border-radius: 2px;
      background: rgb(0 0 0 / 0.6);
      color: #fff;
      font-size: 10px;
      opacity: 0;
    }
    .gallery-shot[data-on] .gallery-name {
      opacity: 1;
    }
    .fan-next {
      position: absolute;
      inset: 0;
      z-index: 20;
      display: block;
      cursor: pointer;
    }
  }
</style>

<script>
  // A card with several screenshots: the tabs (wide screens) or a tap on the fan (phones) pick which one is in front.
  // --k is each screenshot's place behind the front one, which the fan uses for its spread.
  for (const gallery of document.querySelectorAll<HTMLElement>("[data-gallery]")) {
    const shots = [...gallery.querySelectorAll<HTMLElement>(".gallery-shot")];
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>("[data-thumb]")];
    let on = 0;
    const show = (i: number) => {
      on = (i + shots.length) % shots.length;
      shots.forEach((s, k) => {
        s.style.setProperty("--k", String((k - on + shots.length) % shots.length));
        s.toggleAttribute("data-on", k === on);
      });
      thumbs.forEach((t, k) => t.setAttribute("aria-pressed", String(k === on)));
    };
    thumbs.forEach((t, k) => t.addEventListener("click", () => show(k)));
    gallery.querySelector("[data-fan-next]")?.addEventListener("click", () => show(on + 1));
    show(0);
  }
</script>
