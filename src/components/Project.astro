---
import { faArrowRight, faArrowUpRightFromSquare, faLock } from "@fortawesome/free-solid-svg-icons";
import { faGithub } from "@fortawesome/free-brands-svg-icons";
import type { Project } from "../data/projects";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
  index: number;
  featured?: boolean;
}

const { project, index, featured = false } = Astro.props;
const number = String(index + 1).padStart(2, "0");
const isExternal = (url?: string) => !!url && /^https?:\/\//.test(url);
const linkAttrs = (url?: string) => (isExternal(url) ? { target: "_blank", rel: "noopener noreferrer" } : {});
const href = project.locked ? "" : project.href;
const MediaTag = href ? "a" : "div";
---

<article data-reveal class:list={["project group flex flex-col", featured && "md:col-span-2"]}>
  <MediaTag
    href={href || undefined}
    {...linkAttrs(href)}
    aria-label={href ? `${project.title} — view project` : undefined}
    tabindex={href ? -1 : undefined}
    class:list={[
      "media relative block w-full overflow-hidden rounded-[2px] bg-ph transition-opacity duration-200 hover:opacity-90",
      featured ? "aspect-[5/4] md:aspect-[16/7]" : "aspect-[5/4]",
    ]}
    data-locked={project.locked ? "" : undefined}
  >
    {
      project.image ? (
        <img
          src={project.image}
          alt={project.imageAlt ?? ""}
          loading="lazy"
          decoding="async"
          class="size-full object-cover transition-transform duration-700 ease-out-soft group-hover:scale-[1.02]"
        />
      ) : (
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 transition-transform duration-700 ease-out-soft group-hover:scale-[1.02]">
          <span class="font-serif text-[clamp(64px,9vw,140px)] leading-none text-ink/15" aria-hidden="true">
            {number}
          </span>
          <span class="eyebrow text-[11px] text-muted">[PROJECT IMAGE]</span>
        </div>
      )
    }
    {
      project.locked && (
        <span class="lock absolute inset-0 flex flex-col items-center justify-center gap-2.5 bg-[rgb(18_18_18/0.5)] opacity-0 backdrop-blur-[2px] transition-opacity duration-[250ms]">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/95 px-4 py-2 text-[12px] font-semibold tracking-[0.16em] text-ink uppercase">
            <Icon icon={faLock} class="text-[11px]" />
            Classified
          </span>
          {project.lockedNote && <span class="text-[12px] tracking-[0.02em] text-white/90">{project.lockedNote}</span>}
        </span>
      )
    }
  </MediaTag>

  <div class:list={["pt-[18px]", featured && "md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-[clamp(24px,4vw,64px)]"]}>
    <div>
      <p class="eyebrow mb-3 flex items-center gap-3 text-[11px] text-muted">
        <span class="tabular-nums text-ink">{number}</span>
        <span class="h-px w-6 bg-line" aria-hidden="true"></span>
        <span>{project.category}</span>
        <span class="ml-auto tabular-nums">{project.year}</span>
      </p>
      <h3 class:list={["mb-1 font-medium tracking-[-0.01em]", featured ? "text-[clamp(20px,2vw,24px)]" : "text-[18px]"]}>
        {
          href ? (
            <a href={href} {...linkAttrs(href)} class="inline-flex items-baseline gap-2">
              {project.title}
              <Icon
                icon={faArrowRight}
                class="-rotate-45 text-[0.7em] text-muted transition-[transform,color] duration-300 ease-out-soft group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
              />
            </a>
          ) : (
            project.title
          )
        }
      </h3>
      <p class="max-w-[52ch] text-[14px] leading-[1.65] text-muted">{project.description}</p>
    </div>

    <div class:list={["mt-4 flex flex-col gap-4", featured && "md:mt-9"]}>
      <ul class="flex flex-wrap gap-x-2 gap-y-1 text-[13px] text-ink-soft" aria-label="Technologies">
        {
          project.technologies.map((tech, i) => (
            <li>
              {i > 0 && (
                <span class="mr-2 text-line" aria-hidden="true">
                  /
                </span>
              )}
              {tech}
            </li>
          ))
        }
      </ul>
      {
        (href || project.github) && (
          <div class="flex gap-6">
            {href && (
              <a href={href} {...linkAttrs(href)} class="eyebrow brush relative inline-flex items-center gap-1.5 text-[11px] after:absolute after:-inset-3">
                <Icon icon={faArrowUpRightFromSquare} class="text-[10px]" />
                Visit<span class="sr-only"> {project.title}</span>
              </a>
            )}
            {project.github && (
              <a href={project.github} {...linkAttrs(project.github)} class="eyebrow brush relative inline-flex items-center gap-1.5 text-[11px] after:absolute after:-inset-3">
                <Icon icon={faGithub} class="text-[12px]" />
                GitHub<span class="sr-only"> repository for {project.title}</span>
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  .media[data-locked]:hover .lock {
    opacity: 1;
  }
</style>
