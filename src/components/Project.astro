---
import { faLock } from "@fortawesome/free-solid-svg-icons";
import type { Project } from "../data/projects";
import { isSet } from "../data/placeholders";
import { slug as toSlug } from "../data/slug";
import Detail from "./Detail.astro";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const slug = toSlug(project.title) || "project";
const href = !project.locked && isSet(project.href) ? project.href : undefined;
const number = String(index + 1).padStart(2, "0");
---

<!-- One card of the sticky stack (see Projects.astro): the story on the left (number and year, name, one line, stack,
     visit), the screenshot in a browser frame on the right; on phones the screenshot sits on top. NDA projects show
     "nda" and a private cover instead of visit. The whole card opens the full project in a modal. -->
<article class="card stack-card relative">
  <div class="info">
    <p class="text-small text-muted tabular-nums">{number} · {project.year}</p>
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="name">
        <button type="button" data-detail-open class="cursor-pointer text-left after:absolute after:inset-0 after:z-[1] after:content-['']">
          {project.title}
        </button>
      </h3>
      {project.locked && <span class="nda">nda</span>}
    </div>
    <p class="text-small text-muted">{project.description}</p>
    <ul class="tags">
      {project.technologies.filter(Boolean).map((t) => <li>{t}</li>)}
    </ul>
    {/* Until a project's real link is set, visit is a quiet stand-in so every card reads the same. */}
    {
      !project.locked &&
        (href ? (
          <a href={href} target="_blank" rel="noopener noreferrer" class="visit tui-btn inline-flex">
            [ visit ]
          </a>
        ) : (
          <span class="visit tui-btn pointer-events-none inline-flex opacity-60" aria-hidden="true">
            [ visit ]
          </span>
        ))
    }
  </div>

  <div class="shot">
    <div class="shot-bar" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="shot-view">
      {
        project.image ? (
          <img src={project.image} alt={project.imageAlt ?? ""} loading="lazy" decoding="async" class="card-img" />
        ) : (
          <span class="eyebrow text-muted">[PROJECT IMAGE]</span>
        )
      }
      {
        project.locked && (
          <span class="private">
            <Icon icon={faLock} class="text-[11px]" />
            private
          </span>
        )
      }
    </div>
  </div>

  <Detail
    path={`projects/${slug}`}
    title={project.title}
    meta={[project.category, project.year]}
    image={project.image}
    imageAlt={project.imageAlt}
    placeholder="PROJECT IMAGE"
    text={[project.description]}
    tags={project.technologies.filter(Boolean)}
    locked={project.locked}
    lockedNote={project.lockedNote}
    link={href ? { href, label: "visit" } : undefined}
  />
</article>

<style>
  .stack-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(20px, 3vw, 36px);
    height: 100%;
    padding: clamp(16px, 2vw, 24px);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-paper) 40%, white);
    box-shadow: 0 -12px 34px -20px rgb(0 0 0 / 0.35);
  }
  /* Darkens the card as later ones stack over it (--dim, set in Projects.astro). */
  .stack-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    background: #000;
    opacity: var(--dim, 0);
    pointer-events: none;
  }
  :global([data-theme="dark"]) .stack-card {
    background: color-mix(in srgb, var(--color-paper) 92%, white);
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .name {
    font-size: clamp(20px, 2.2vw, 26px);
    font-weight: 400;
    line-height: 1.2;
  }
  .nda {
    flex: none;
    padding: 0 6px;
    border: 1px solid var(--color-muted);
    border-radius: 2px;
    color: var(--color-muted);
    font-size: 11px;
    line-height: 1.6;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    padding: 1px 7px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-ink) 6%, transparent);
    color: var(--color-ink-soft);
    font-size: 11px;
  }
  .visit {
    position: relative;
    z-index: 2;
    align-self: flex-start;
    margin-left: -8px;
    color: var(--color-ink);
  }
  /* The screenshot in a small browser frame. */
  .shot {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-ph);
  }
  .shot-bar {
    display: flex;
    flex: none;
    gap: 5px;
    align-items: center;
    height: 22px;
    padding-inline: 9px;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-ink) 4%, var(--color-paper));
  }
  .shot-bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-ink) 18%, var(--color-paper));
  }
  .shot-view {
    position: relative;
    display: grid;
    flex: 1;
    place-items: center;
    overflow: hidden;
  }
  .shot-view img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .private {
    position: absolute;
    inset: 0;
    display: flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    background: rgb(27 36 48 / 0.55);
    color: #fff;
    font-size: var(--text-small);
  }
  /* Phones: screenshot on top, the story under it. */
  @media (max-width: 767px) {
    .stack-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
    }
    .shot {
      order: -1;
    }
  }
</style>
