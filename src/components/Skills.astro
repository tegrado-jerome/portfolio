---
// Skills by category: one tab per category, each with its own turning wheel of logos.
import { skillGroups } from "../data/skills";
import SectionHead from "./SectionHead.astro";
import SkillWheel from "./SkillWheel.astro";

const groups = skillGroups.filter((g) => g.skills.length > 0);
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

{
  groups.length > 0 && (
    <section id="skills" class="shell section" aria-labelledby="skills-title">
      <SectionHead id="skills-title" title="Skills" />

      <!-- Segmented control styled as a radio's band switch, to pair with the tuning dial: a hairline track
           and an ink tile (the dial's needle colour) that slides onto the picked category. -->
      <div data-reveal class="mb-[clamp(28px,4vw,48px)]">
        <div role="tablist" aria-label="Skill categories" class="seg relative inline-flex flex-wrap gap-0.5 rounded-[10px] border border-line p-1">
          <span class="thumb" aria-hidden="true"></span>
          {groups.map((g, i) => (
            <button
              type="button"
              role="tab"
              id={`skills-tab-${slug(g.name)}`}
              aria-controls={`skills-${slug(g.name)}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="eyebrow relative z-[1] rounded-[7px] px-3.5 py-2.5 text-muted transition-colors duration-200 hover:text-ink aria-selected:text-paper"
            >
              {g.name}
            </button>
          ))}
        </div>
      </div>

      {groups.map((g, i) => (
        <div
          id={`skills-${slug(g.name)}`}
          role="tabpanel"
          aria-labelledby={`skills-tab-${slug(g.name)}`}
          hidden={i !== 0}
          data-reveal
        >
          <ul class="sr-only">
            {g.skills.map((s) => (
              <li>{s.name}</li>
            ))}
          </ul>
          <SkillWheel skills={g.skills} />
        </div>
      ))}

      <p class="eyebrow mt-5 flex items-center justify-center gap-2.5 text-muted" aria-hidden="true">
        <span class="orbit" />
        <span class="hint-mouse">Drag in a circle to spin, or click a slot</span>
        <span class="hint-touch">Swipe in a circle to spin, or tap a slot</span>
      </p>
    </section>
  )
}

<style>
  /* The ink tile. JS moves it onto the picked tab (it can slide between rows when the tabs wrap on phones). */
  .seg {
    --tile: var(--color-ink);
  }
  .thumb {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 7px;
    background: var(--tile);
    transition:
      translate 0.3s var(--ease-out-soft),
      width 0.3s var(--ease-out-soft),
      height 0.3s var(--ease-out-soft);
  }
  /* Without JS there's no sliding tile, so the picked tab paints its own. */
  :global(html:not(.js)) .seg [aria-selected="true"] {
    background: var(--tile);
  }
  /* The guide's gesture: a dot circling a small ring, the motion that spins the wheel. */
  .orbit {
    position: relative;
    width: 16px;
    height: 16px;
    border: 1px dashed currentColor;
    border-radius: 50%;
  }
  .orbit::after {
    content: "";
    position: absolute;
    top: -3px;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--color-ink);
    transform-origin: 2.5px 10px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .orbit::after {
      animation: orbit 1.8s linear infinite;
    }
  }
  @keyframes orbit {
    to {
      rotate: 360deg;
    }
  }
  /* The guide's words match the device. */
  .hint-mouse,
  .hint-touch {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .hint-mouse {
      display: inline;
    }
  }
  @media not ((hover: hover) and (pointer: fine)) {
    .hint-touch {
      display: inline;
    }
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("#skills [role=tab]")];

  const thumb = document.querySelector<HTMLElement>("#skills .thumb");

  // Sit the raised tile exactly on the picked tab.
  function moveThumb() {
    const tab = tabs.find((t) => t.getAttribute("aria-selected") === "true");
    if (!thumb || !tab) return;
    thumb.style.translate = `${tab.offsetLeft}px ${tab.offsetTop}px`;
    thumb.style.width = `${tab.offsetWidth}px`;
    thumb.style.height = `${tab.offsetHeight}px`;
  }

  function select(tab: HTMLButtonElement) {
    for (const t of tabs) {
      const selected = t === tab;
      t.setAttribute("aria-selected", String(selected));
      t.tabIndex = selected ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !selected;
    }
    moveThumb();
  }

  // Tabs can rewrap when the width changes, so re-place the tile then (without sliding it).
  if (thumb) {
    new ResizeObserver(() => {
      thumb.style.transition = "none";
      moveThumb();
      requestAnimationFrame(() => (thumb.style.transition = ""));
    }).observe(thumb.parentElement!);
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (e) => {
      const d = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (!d) return;
      const next = tabs[(i + d + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });
</script>
