---
// Skills by category: a TUI list of categories, each with its own turning wheel of logos.
import { faHandPointer } from "@fortawesome/free-solid-svg-icons";
import { skillGroups } from "../data/skills";
import Icon from "./Icon.astro";
import SectionHead from "./SectionHead.astro";
import SkillWheel from "./SkillWheel.astro";

const groups = skillGroups.filter((g) => g.skills.length > 0);
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

{
  groups.length > 0 && (
    <section id="skills" class="shell section" aria-labelledby="skills-title">
      <div class="pane" data-pane="skills">
      <SectionHead id="skills-title" title="Skills" />

      <!-- TUI layout (lazygit / btop): a category list with an ink selection bar on the left, the dial on the right. -->
      <div class="grid gap-[clamp(40px,6vw,96px)] md:grid-cols-[minmax(200px,260px)_minmax(0,1fr)] md:items-center">
        <div data-reveal>
          <div role="tablist" aria-label="Skill categories" aria-orientation="vertical" class="seg relative flex flex-col">
            <span class="thumb" aria-hidden="true"></span>
            {groups.map((g, i) => (
              <button
                type="button"
                role="tab"
                id={`skills-tab-${slug(g.name)}`}
                aria-controls={`skills-${slug(g.name)}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class="relative z-[1] flex items-center justify-between gap-3 px-3 py-3 text-left text-body text-muted transition-colors duration-200 hover:text-ink aria-selected:text-paper"
              >
                <span><span class="caret-mark" aria-hidden="true">▸ </span>{slug(g.name)}</span>              </button>
            ))}
          </div>
        </div>

        <div>
          {groups.map((g, i) => (
            <div
              id={`skills-${slug(g.name)}`}
              role="tabpanel"
              aria-labelledby={`skills-tab-${slug(g.name)}`}
              hidden={i !== 0}
              data-reveal
            >
              <ul class="sr-only">
                {g.skills.map((s) => (
                  <li>{s.name}</li>
                ))}
              </ul>
              <SkillWheel skills={g.skills} />
            </div>
          ))}

          <p class="eyebrow mt-8 flex items-center justify-center gap-2 text-muted" aria-hidden="true">
            <span class="gesture">
              <svg class="trail" viewBox="0 0 26 26" aria-hidden="true">
                <mask id="gesture-reveal"><circle class="reveal" cx="12" cy="10" r="7" pathLength="100" /></mask>
                <g mask="url(#gesture-reveal)">
                  <circle class="dots" cx="12" cy="10" r="7" pathLength="100" />
                </g>
              </svg>
              <span class="hand"><Icon icon={faHandPointer} class="block text-[15px]" /></span>
            </span>
            <span class="hint-mouse">Drag in a circle to spin</span>
            <span class="hint-touch">Swipe in a circle to spin</span>
          </p>
        </div>
      </div>
      </div>
    </section>
  )
}

<style>
  /* The ink selection bar. JS moves it onto the picked category, sliding up and down the list. */
  .seg {
    --tile: var(--color-ink);
  }
  .thumb {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 2px;
    background: var(--tile);
    transition:
      translate 0.3s var(--ease-out-soft),
      width 0.3s var(--ease-out-soft),
      height 0.3s var(--ease-out-soft);
  }
  .caret-mark {
    visibility: hidden;
  }
  [aria-selected="true"] .caret-mark {
    visibility: visible;
  }
  /* Without JS there's no sliding bar, so the picked tab paints its own. */
  :global(html:not(.js)) .seg [aria-selected="true"] {
    background: var(--tile);
  }
  /* The guide's gesture, like touch-gesture hints in apps: a pointing finger draws a dotted circle with its tip,
     the circle fades, and it starts again. That's the motion that spins the wheel. */
  .gesture {
    position: relative;
    display: inline-block;
    /* Sized to the circle (centred at 12px, 10px), so the circle lines up with the middle of the text beside it;
       the hand hangs below it. */
    width: 24px; /* even space on both sides of the circle */
    height: 20px;
    color: var(--color-ink);
  }
  .trail {
    position: absolute;
    inset: 0;
    overflow: visible;
  }
  /* A dotted circle, starting at the top and running clockwise like the finger; a mask reveals it behind the
     fingertip. */
  .trail circle {
    fill: none;
    transform: rotate(-90deg);
    transform-origin: 12px 10px;
  }
  .dots {
    stroke: var(--color-muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 0 6;
  }
  .reveal {
    stroke: #fff;
    stroke-width: 7;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }
  /* The fingertip rests at the circle's centre (its transform-origin); it's moved out to the edge and around,
     while the hand stays upright. */
  .hand {
    position: absolute;
    top: 9px;
    left: 8.25px;
    transform-origin: 3.75px 1px;
    transform: translateY(-7px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hand {
      animation: trace 2.8s linear infinite;
    }
    .reveal {
      animation: draw 2.8s linear infinite;
    }
    .trail {
      animation: fade 2.8s linear infinite;
    }
  }
  /* The finger draws one full lap in the first 70%, then lifts away so the finished circle shows, and comes back
     for the next lap. */
  @keyframes trace {
    0% {
      transform: rotate(0deg) translateY(-7px) rotate(0deg);
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    70% {
      transform: rotate(360deg) translateY(-7px) rotate(-360deg);
      opacity: 1;
    }
    78%,
    100% {
      transform: rotate(360deg) translateY(-7px) rotate(-360deg);
      opacity: 0;
    }
  }
  @keyframes draw {
    0% {
      stroke-dashoffset: 100;
    }
    70%,
    100% {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade {
    0%,
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  /* The guide's words match the device. */
  .hint-mouse,
  .hint-touch {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .hint-mouse {
      display: inline;
    }
  }
  @media not ((hover: hover) and (pointer: fine)) {
    .hint-touch {
      display: inline;
    }
  }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("#skills [role=tab]")];

  const thumb = document.querySelector<HTMLElement>("#skills .thumb");

  // Sit the raised tile exactly on the picked tab.
  function moveThumb() {
    const tab = tabs.find((t) => t.getAttribute("aria-selected") === "true");
    if (!thumb || !tab) return;
    thumb.style.translate = `${tab.offsetLeft}px ${tab.offsetTop}px`;
    thumb.style.width = `${tab.offsetWidth}px`;
    thumb.style.height = `${tab.offsetHeight}px`;
  }

  function select(tab: HTMLButtonElement) {
    for (const t of tabs) {
      const selected = t === tab;
      t.setAttribute("aria-selected", String(selected));
      t.tabIndex = selected ? 0 : -1;
      document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !selected;
    }
    moveThumb();
  }

  // Tabs can rewrap when the width changes, so re-place the tile then (without sliding it).
  if (thumb) {
    new ResizeObserver(() => {
      thumb.style.transition = "none";
      moveThumb();
      requestAnimationFrame(() => (thumb.style.transition = ""));
    }).observe(thumb.parentElement!);
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (e) => {
      const d = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : e.key === "ArrowLeft" || e.key === "ArrowUp" ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      const next = tabs[(i + d + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });
</script>
