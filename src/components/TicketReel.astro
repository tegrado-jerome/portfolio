---
// A credentials section (Awards, Certifications) as a ticket book: the entries are ticket stubs stacked like a book,
// the top one in front, two more peeking out behind it. ← → (top right, beside the count, where Apple, Airbnb,
// Linear and Stripe put theirs), a swipe on the stack or the arrow keys turn to the next stub; the text beside the
// book follows. A click on the front stub opens the full entry in the modal. Without JS the stubs are a plain list.
import { isSet } from "../data/placeholders";
import { slug as toSlug } from "../data/slug";
import Detail from "./Detail.astro";

export interface Credential {
  title: string;
  year: string;
  /** Short name of who gave it, for the stub (e.g. "TUP Manila"). */
  caption: string;
  /** Full name of who gave it, shown in the modal. */
  issuer: string;
  /** Extra lines for the modal (e.g. "GWA 1.36", "Credential ID: …"); the first one also shows on the stub. */
  details?: string[];
  href?: string;
  image?: string;
  imageAlt?: string;
}

interface Props {
  id: string;
  title: string;
  entries: Credential[];
  /** Label shown in stubs that don't have a picture yet. */
  placeholder: string;
  /** Label for the modal's link to proof, e.g. "verify". */
  linkLabel: string;
}

const { id, title, entries, placeholder, linkLabel } = Astro.props;
const slug = toSlug(title);
const n = entries.length;
const pad = (i: number) => String(i).padStart(2, "0");
const first = entries[0];
// The line under a title: its first detail, or the full issuer when that says more than the short caption.
const line = (e: Credential) => (e.details ?? []).find(isSet) ?? (e.issuer !== e.caption ? e.issuer : "");
---

{
  n > 0 && (
    <section id={id} class="shell section" aria-labelledby={`${id}-title`}>
      <div class="pane" data-pane={slug}>
        <div class="absolute inset-x-0 top-0 flex items-center justify-between gap-3 text-small">
          <h2 id={`${id}-title`} class="min-w-0 truncate font-normal text-ink">
            <span class="sr-only">{title}</span>
            <span aria-hidden="true"><span class="text-accent">~/</span>{slug}</span>
          </h2>
          {n > 1 && (
            <div class="reel-ctl hidden shrink-0 items-center gap-1 whitespace-nowrap in-[.js]:flex">
              <span class="mr-1 text-muted tabular-nums max-sm:hidden" aria-hidden="true"><span data-reel-count>01</span> / {pad(n)}</span>
              <button type="button" data-reel-prev class="tui-btn inline-flex" aria-label={`Previous ${slug.replace(/s$/, "")}`}>[ ← ]</button>
              <button type="button" data-reel-next class="tui-btn inline-flex text-ink" aria-label={`Next ${slug.replace(/s$/, "")}`}>[ → ]</button>
            </div>
          )}
        </div>

        <div class="book" data-reel data-reveal>
          <ol class="deck" data-deck style={`--n:${n}`}>
            {entries.map((e, i) => {
              const entrySlug = toSlug(e.title) || slug;
              return (
                <li class="deck-item" style={`--k:${i}`} data-title={e.title} data-meta={[e.caption, e.year].filter(isSet).join(" · ")} data-detail={line(e)}>
                  <article class="card stub relative">
                    <div class="stub-main">
                      <p class="eyebrow text-muted">{e.caption}</p>
                      <h3 class="stub-title">
                        <button type="button" data-detail-open class="cursor-pointer text-left after:absolute after:inset-0 after:z-[1] after:content-['']">
                          {e.title}
                        </button>
                      </h3>
                      {line(e) && <p class="stub-line truncate text-small text-muted">{line(e)}</p>}
                      <div class="media stub-photo">
                        {e.image ? (
                          <img src={e.image} alt={e.imageAlt ?? ""} loading="lazy" decoding="async" class="card-img" />
                        ) : (
                          <span class="eyebrow text-muted">[{placeholder}]</span>
                        )}
                      </div>
                    </div>
                    <div class="stub-tear" aria-hidden="true" />
                    <div class="stub-end">
                      <p class="eyebrow">No. {pad(i + 1)}</p>
                      <p class="stub-year">{e.year}</p>
                      <span class="eyebrow stub-tag max-md:hidden">{slug}</span>
                    </div>
                    <Detail
                      path={`${slug}/${entrySlug}`}
                      title={e.title}
                      meta={[e.year, e.issuer]}
                      image={e.image}
                      imageAlt={e.imageAlt}
                      placeholder={placeholder}
                      text={(e.details ?? []).filter(isSet)}
                      link={isSet(e.href) ? { href: e.href, label: linkLabel } : undefined}
                    />
                  </article>
                </li>
              );
            })}
          </ol>
          <!-- The front stub's story, beside the book. Hidden without JS: every stub then shows its own. -->
          <div class="book-side hidden in-[.js]:block" aria-live="polite">
            <p class="eyebrow text-muted" data-reel-meta>{[first.caption, first.year].filter(isSet).join(" · ")}</p>
            <p class="book-title" data-reel-title>{first.title}</p>
            <p class="mt-3 text-small text-ink-soft" data-reel-detail>{line(first)}</p>
            {n > 1 && (
              <ul class="pips" aria-hidden="true">
                {entries.map((_, i) => (
                  <li class:list={{ "is-on": i === 0 }} />
                ))}
              </ul>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  /* The stub: the ticket body on the left, a perforated tear, and the dark end with its number and year. */
  .stub {
    display: flex;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-ink) 2.5%, var(--color-paper));
    transition: border-color 0.2s ease;
  }
  @media (hover: hover) {
    .stub:hover {
      border-color: var(--color-muted);
    }
  }
  .stub-main {
    flex: 1;
    min-width: 0;
    padding: 16px 18px;
  }
  .stub-title {
    margin-top: 4px;
    font-size: var(--text-heading);
    font-weight: 400;
    line-height: 1.25;
  }
  .stub-line {
    margin-top: 4px;
  }
  .stub-photo {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 7;
    margin-top: 12px;
    overflow: hidden;
    border-radius: 2px;
    background: var(--color-ph);
  }
  .stub-photo > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .stub-tear {
    position: relative;
    width: 0;
    border-left: 1px dashed var(--color-muted);
  }
  .stub-tear::before,
  .stub-tear::after {
    content: "";
    position: absolute;
    left: -7px;
    width: 14px;
    height: 14px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-paper);
  }
  .stub-tear::before {
    top: -8px;
  }
  .stub-tear::after {
    bottom: -8px;
  }
  .stub-end {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    width: 92px;
    padding: 14px 10px;
    background: var(--color-night);
    color: #e6e9ee;
  }
  .stub-year {
    font-size: 22px;
    font-weight: 500;
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-variant-numeric: tabular-nums;
  }
  .stub-tag {
    opacity: 0.6;
  }

  /* Without JS: a plain list of stubs. */
  .deck {
    display: grid;
    gap: 16px;
  }

  /* With JS: the book. Every stub sits in the same grid cell; --k is its place in the pile (0 = front), and moves
     it a step down and to the right, a touch smaller and dimmer. Only the front three show. */
  :global(.js) .book {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 40px;
    align-items: center;
  }
  :global(.js) .deck {
    display: grid;
    gap: 0;
    padding: 0 28px 28px 0;
  }
  :global(.js) .deck-item {
    grid-area: 1 / 1;
    z-index: calc(var(--n) - var(--k));
    transform: translate(calc(var(--k) * 14px), calc(var(--k) * 14px));
    opacity: calc(1 - var(--k) * 0.22);
    visibility: hidden;
    transition:
      transform 0.5s var(--ease-out-soft),
      opacity 0.5s var(--ease-out-soft),
      visibility 0s linear 0.5s;
    pointer-events: none;
  }
  :global(.js) .deck-item.is-shown {
    visibility: visible;
    transition:
      transform 0.5s var(--ease-out-soft),
      opacity 0.5s var(--ease-out-soft),
      visibility 0s;
  }
  :global(.js) .deck-item.is-front {
    pointer-events: auto;
  }
  /* The stub just turned: it lifts off to the left, fades, and settles at the back of the pile. */
  :global(.js) .deck-item.is-leaving {
    animation: turn 0.5s var(--ease-out-soft);
  }
  @keyframes turn {
    0% {
      translate: 0 0;
      opacity: 1;
    }
    45% {
      translate: -36px 0;
      opacity: 0;
    }
    100% {
      translate: 0 0;
    }
  }
  .book-title {
    margin-top: 8px;
    font-size: clamp(24px, 2.6vw, 36px);
    line-height: 1.1;
    text-wrap: balance;
  }
  .book-side > * {
    transition: opacity 0.2s ease;
  }
  .book-side.is-turning > * {
    opacity: 0;
    transition: opacity 0.12s ease;
  }
  .pips {
    display: flex;
    gap: 6px;
    margin-top: 24px;
  }
  .pips li {
    width: 22px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-line);
    transition: background-color 0.3s ease;
  }
  .pips li.is-on {
    background: var(--color-ink);
  }
  /* The stack swipes sideways; up and down still scroll the page. */
  :global(.js) .deck {
    touch-action: pan-y;
    user-select: none;
  }
  @media (max-width: 767px) {
    :global(.js) .book {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .stub-end {
      width: 76px;
    }
    .book-title {
      font-size: 24px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-reel]").forEach((book) => {
    const items = [...book.querySelectorAll<HTMLElement>(".deck-item")];
    const n = items.length;
    const deck = book.querySelector<HTMLElement>("[data-deck]")!;
    const side = book.querySelector<HTMLElement>(".book-side")!;
    const pane = book.closest<HTMLElement>(".pane")!;
    const count = pane.querySelector<HTMLElement>("[data-reel-count]");
    const pips = [...side.querySelectorAll<HTMLElement>(".pips li")];
    const fields = {
      meta: side.querySelector<HTMLElement>("[data-reel-meta]")!,
      title: side.querySelector<HTMLElement>("[data-reel-title]")!,
      detail: side.querySelector<HTMLElement>("[data-reel-detail]")!,
    };
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const SHOWN = 3; // stubs visible in the pile
    let current = 0;
    let sideTimer = 0;

    function place() {
      items.forEach((li, i) => {
        const k = (i - current + n) % n;
        li.style.setProperty("--k", String(k));
        li.classList.toggle("is-shown", k < SHOWN);
        li.classList.toggle("is-front", k === 0);
      });
      pips.forEach((p, i) => p.classList.toggle("is-on", i === current));
      if (count) count.textContent = String(current + 1).padStart(2, "0");
    }

    function tell() {
      const li = items[current];
      const swap = () => {
        fields.meta.textContent = li.dataset.meta ?? "";
        fields.title.textContent = li.dataset.title ?? "";
        fields.detail.textContent = li.dataset.detail ?? "";
        side.classList.remove("is-turning");
      };
      clearTimeout(sideTimer);
      if (reduceMotion) return swap();
      side.classList.add("is-turning");
      sideTimer = window.setTimeout(swap, 130);
    }

    function go(to: number, direction = 1) {
      const next = ((to % n) + n) % n;
      if (next === current) return;
      const leaving = items[current];
      current = next;
      // Turning forward lifts the front stub off and tucks it behind; going back just brings one forward.
      if (direction > 0 && !reduceMotion) {
        leaving.classList.remove("is-leaving");
        void leaving.offsetWidth; // restart the animation if it's still running
        leaving.classList.add("is-leaving");
        leaving.addEventListener("animationend", () => leaving.classList.remove("is-leaving"), { once: true });
      }
      place();
      tell();
    }

    pane.querySelector("[data-reel-prev]")?.addEventListener("click", () => go(current - 1, -1));
    pane.querySelector("[data-reel-next]")?.addEventListener("click", () => go(current + 1, 1));

    // Arrow keys while the pointer or focus is on the section.
    pane.addEventListener("keydown", (e) => {
      if ((e.target as HTMLElement).closest("input, textarea")) return;
      if (e.key === "ArrowRight") (e.preventDefault(), go(current + 1, 1));
      if (e.key === "ArrowLeft") (e.preventDefault(), go(current - 1, -1));
    });

    // A sideways swipe or drag on the pile turns it. A short tap still opens the front stub.
    let startX = 0;
    let startY = 0;
    let tracking = false;
    deck.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      tracking = true;
      startX = e.clientX;
      startY = e.clientY;
    });
    deck.addEventListener("pointermove", (e) => {
      if (!tracking) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        tracking = false;
        go(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
      }
    });
    deck.addEventListener("pointerup", () => (tracking = false));
    deck.addEventListener("pointercancel", () => (tracking = false));
    // Dragging shouldn't be read as a click on the front stub.
    deck.addEventListener(
      "click",
      (e) => {
        if (Math.abs(e.clientX - startX) > 10 || Math.abs(e.clientY - startY) > 10) e.stopPropagation(), e.preventDefault();
      },
      { capture: true },
    );

    // The chat or the hero's `cd` pointing at one stub (src/scripts/point.ts) brings it to the front first.
    deck.addEventListener("point", (e) => {
      const li = (e.target as HTMLElement).closest<HTMLElement>(".deck-item");
      if (li) go(items.indexOf(li), 1);
    });

    place();
  });
</script>
