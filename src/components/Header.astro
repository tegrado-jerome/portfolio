---
import { faCircleHalfStroke } from "@fortawesome/free-solid-svg-icons";
import { site } from "../data/site";
import Icon from "./Icon.astro";

const cta = "Let's Talk";
---

<header
  id="site-header"
  class="sticky top-0 z-40 bg-paper/45 backdrop-blur-lg backdrop-saturate-150 transition-[transform,box-shadow] duration-[350ms] ease-[cubic-bezier(.4,0,.2,1)] [&.is-hidden]:-translate-y-full [&.is-scrolled]:shadow-[0_1px_0_var(--color-line)]"
>
  <div class="flex items-center justify-between px-5 py-4 sm:px-[clamp(20px,10vw,200px)] sm:py-5">
    <a href="/" data-to-top class="group flex items-center gap-3" aria-label={`${site.name}, home`}>
      <span class="logo size-11 bg-current text-ink transition-colors duration-300 group-hover:text-accent" aria-hidden="true"></span>
      <span class="eyebrow hidden sm:inline">{site.name}</span>
    </a>

    <nav aria-label="Primary" class="ml-auto flex items-center gap-5">
      {
        site.resume && (
          <a href={site.resume} target="_blank" rel="noopener" class="eyebrow text-muted transition-colors hover:text-ink max-sm:hidden">
            Resume
          </a>
        )
      }
      <a
        href="#contact"
        aria-label={cta}
        class="roll eyebrow rounded-full border border-ink px-4 py-2 text-[11px] text-ink transition-colors duration-200 hover:bg-ink hover:text-paper"
      >
        <span class="roll-word" aria-hidden="true">
          {[...cta].map((char, i) => (
            <span style={`--i:${i}`}>{char}</span>
          ))}
        </span>
      </a>
    </nav>

    <!-- JS-only controls stay hidden without scripting. -->
    <div class="ml-5 hidden items-center gap-1 in-[.js]:flex sm:ml-7">
      <button
        type="button"
        data-theme-toggle
        class="eyebrow -my-2 inline-flex items-center gap-2 px-2 py-3 text-muted transition-colors hover:text-ink"
      >
        <Icon icon={faCircleHalfStroke} class="text-[13px]" />
        <span data-theme-label class="hidden lg:inline">Light</span>
      </button>
      <button
        type="button"
        data-palette-open
        class="eyebrow -my-2 hidden items-center rounded-[3px] border border-line px-2 py-1 text-[11px] text-muted transition-colors hover:border-ink hover:text-ink lg:inline-flex"
        aria-label="Open command menu"
      >
        <kbd data-shortcut class="font-sans">Ctrl K</kbd>
      </button>
    </div>
  </div>
</header>

<style>
  /* The logo image is used as a mask, so it takes the current text colour in both themes. */
  .logo {
    display: block;
    mask: url("/logo.png") center / contain no-repeat;
  }

  /* Letters roll up to a copy of themselves on hover (bleibtgleich.dev, art-yakushev.com). */
  .roll-word {
    display: inline-flex;
    overflow: hidden;
    line-height: 1.2;
  }
  .roll-word > span {
    display: inline-block;
    white-space: pre;
    text-shadow: 0 1.2em currentColor;
    transition: transform 0.5s cubic-bezier(0.76, 0, 0.24, 1) calc(var(--i) * 15ms);
  }
  @media (hover: hover) {
    .roll:hover .roll-word > span {
      transform: translateY(-1.2em);
    }
  }
</style>

<script>
  import { currentTheme, nextTheme, setTheme } from "../scripts/theme";

  const header = document.getElementById("site-header")!;

  const toggle = header.querySelector<HTMLButtonElement>("[data-theme-toggle]")!;
  const toggleLabel = toggle.querySelector("[data-theme-label]")!;
  const title = (theme: string) => theme[0].toUpperCase() + theme.slice(1);
  const syncToggle = () => {
    toggleLabel.textContent = title(currentTheme());
    toggle.setAttribute("aria-label", `Theme: ${title(currentTheme())}. Switch to ${title(nextTheme())}`);
  };
  toggle.addEventListener("click", () => setTheme(nextTheme()));
  document.addEventListener("themechange", syncToggle);
  syncToggle();

  if (/Mac|iPhone|iPad/.test(navigator.userAgent)) header.querySelector("[data-shortcut]")!.textContent = "⌘K";

  let last = window.scrollY;
  let ticking = false;
  const update = () => {
    const y = window.scrollY;
    if (Math.abs(y - last) > 6) {
      header.classList.toggle("is-hidden", y > last && y > 80);
      last = y;
    }
    header.classList.toggle("is-scrolled", y > 8);
    ticking = false;
  };
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    },
    { passive: true },
  );
  // Keep the header visible while keyboard users tab through it.
  header.addEventListener("focusin", () => header.classList.remove("is-hidden"));
</script>
