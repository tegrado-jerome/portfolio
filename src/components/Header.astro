---
// TUI title bar (lazygit / btop): the logo and app name on the left, bracketed commands on the right.
import { faCircleHalfStroke, faAt } from "@fortawesome/free-solid-svg-icons";
import { contactHref, site } from "../data/site";
import Icon from "./Icon.astro";
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-line bg-paper transition-transform duration-[350ms] ease-[cubic-bezier(.4,0,.2,1)] [&.is-hidden]:-translate-y-full"
>
  <div class="flex items-center justify-between gap-3 px-5 py-4 sm:px-[clamp(20px,10vw,200px)] sm:py-5">
    <a href="/" data-to-top class="group flex items-center gap-3 text-small">
      <span class="logo size-8 bg-current text-ink transition-colors duration-200 group-hover:text-accent" aria-hidden="true"></span>
      <span class="hidden text-ink sm:inline"><span class="text-accent" aria-hidden="true">~/</span>jerome-tegrado</span>
      <span class="sr-only">{site.name}, home</span>
    </a>

    <!-- Bracketed commands, the main action last. The theme button needs JS, so it stays hidden without it.
         The command menu opens from the status bar and with ⌘K / Ctrl K. -->
    <nav aria-label="Primary" class="ml-auto flex items-center gap-2">
      <button type="button" data-theme-toggle class="theme-btn tui-btn hidden in-[.js]:inline-flex">
        [ <Icon icon={faCircleHalfStroke} class="text-[12px]" /> theme ]
      </button>
      <a href={contactHref} target="_blank" rel="noopener noreferrer" aria-label="Let's talk (email me in Gmail)" class="group tui-btn tui-btn--primary">
        [ <Icon icon={faAt} class="text-[11px]" /> let's talk ]
      </a>
    </nav>
  </div>
</header>

<style>
  /* The logo image is used as a mask, so it takes the current text colour in both themes. */
  .logo {
    display: block;
    mask: url("/images/logo.png") center / contain no-repeat;
  }
  /* The theme button gets a soft hover (a faint box, text turns ink), so "let's talk" stays the one obvious button.
     Hover only with a mouse, so a tap on a phone doesn't leave it stuck; a press shows the same box briefly. */
  .theme-btn {
    -webkit-tap-highlight-color: transparent;
  }
  .theme-btn:hover,
  .theme-btn:focus-visible {
    background: transparent;
    color: var(--color-muted);
  }
  @media (hover: hover) {
    .theme-btn:hover {
      background: color-mix(in srgb, var(--color-ink) 7%, transparent);
      color: var(--color-ink);
    }
  }
  .theme-btn:active,
  .theme-btn:focus-visible {
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    color: var(--color-ink);
  }
  .tui-btn--primary {
    display: inline-flex;
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .tui-btn--primary:hover {
    background: var(--color-accent);
  }
</style>

<script>
  import { currentTheme, nextTheme, setTheme } from "../scripts/theme";

  const header = document.getElementById("site-header")!;

  const toggle = header.querySelector<HTMLButtonElement>("[data-theme-toggle]")!;
  const title = (theme: string) => theme[0].toUpperCase() + theme.slice(1);
  const syncToggle = () => {
    const label = `Theme: ${title(currentTheme())}. Switch to ${title(nextTheme())}`;
    toggle.setAttribute("aria-label", label);
    toggle.title = label;
  };
  toggle.addEventListener("click", () => setTheme(nextTheme()));
  document.addEventListener("themechange", syncToggle);
  syncToggle();

  // Hide on the way down, show on the way up, but only after a real stretch in one direction: quick up-and-down
  // flicks (trackpads, thumbs) no longer toggle the header, and a toggle runs its full slide before the next one.
  const HIDE_AFTER = 24; // px scrolled down
  const SHOW_AFTER = 64; // px scrolled up
  const SLIDE_MS = 350;
  let last = window.scrollY;
  let turnedAt = last;
  let direction = 0;
  let settledAt = 0;
  let ticking = false;
  const update = () => {
    ticking = false;
    const y = window.scrollY;
    const moved = Math.sign(y - last);
    if (moved && moved !== direction) {
      direction = moved;
      turnedAt = last;
    }
    last = y;
    const hidden = header.classList.contains("is-hidden");
    if (y <= 80) {
      if (hidden) header.classList.remove("is-hidden");
      return;
    }
    if (performance.now() < settledAt) return;
    const travelled = Math.abs(y - turnedAt);
    const hide = direction > 0 && travelled > HIDE_AFTER;
    const show = direction < 0 && travelled > SHOW_AFTER;
    if ((hide && !hidden) || (show && hidden)) {
      header.classList.toggle("is-hidden", hide);
      settledAt = performance.now() + SLIDE_MS;
    }
  };
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    },
    { passive: true },
  );
  // Keep the header visible while keyboard users tab through it.
  header.addEventListener("focusin", () => header.classList.remove("is-hidden"));
</script>
