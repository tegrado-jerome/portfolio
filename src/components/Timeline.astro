---
import { experience } from "../data/experience";
import Icon from "./Icon.astro";
---

<section class="shell pt-[clamp(64px,9vw,120px)] pb-[clamp(40px,6vw,80px)]" aria-labelledby="journey-title">
  <h2 id="journey-title" class="sr-only">Journey</h2>

  <!--
    Desktop: a horizontal row — year, title, and a rule running to the next step.
    Mobile: a vertical track with a dot for each step.
  -->
  <ol
    class="timeline relative grid gap-y-9 border-l border-line pl-7 lg:grid-cols-5 lg:gap-x-[clamp(20px,2.6vw,48px)] lg:border-0 lg:pl-0"
  >
    {
      experience.map((item, i) => (
        <li data-reveal style={`--i:${i}`} class="timeline-item group relative min-w-0">
          <span
            class="absolute top-[7px] -left-[33px] size-[9px] rounded-full border border-ink bg-paper transition-colors duration-300 group-last:bg-accent group-last:border-accent group-hover:bg-ink lg:hidden"
            aria-hidden="true"
          />
          <span class="mb-1 block text-[14px] tabular-nums text-muted">{item.year}</span>
          <div class="mb-1.5 flex items-center gap-5">
            <h3 class="shrink-0 text-[16px] font-medium uppercase tracking-[0.01em] whitespace-nowrap max-lg:whitespace-normal">
              {item.title}
            </h3>
            <span
              class="timeline-line hidden h-px flex-1 origin-left bg-ink group-last:hidden lg:block"
              aria-hidden="true"
            />
          </div>
          <p class="font-serif text-[15px] leading-[1.4] text-ink-soft italic">
            {item.icon && <Icon icon={item.icon} class="mr-1.5 text-[12px] text-accent not-italic" />}
            {item.description}
          </p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  :global(.js) .timeline-line {
    transform: scaleX(0);
    transition: transform 1.1s var(--ease-out-soft) 0.25s;
  }
  :global(.js) .is-visible .timeline-line {
    transform: scaleX(1);
  }

  .timeline-item > * {
    transition: opacity 0.3s ease;
  }
  @media (hover: hover) {
    .timeline:hover .timeline-item:not(:hover) > * {
      opacity: 0.35;
    }
  }
</style>
