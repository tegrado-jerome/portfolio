---
// A compact journey line at the bottom of the hero.
import { experience } from "../data/experience";
import Icon from "./Icon.astro";
---

<div class="mt-[clamp(48px,7vw,96px)]" role="group" aria-labelledby="journey-title">
  <h2 id="journey-title" class="sr-only">Journey</h2>

  <!--
    Desktop: one continuous line with a dot per step, year above and details below.
    Mobile: a vertical track with the same dots.
  -->
  <div class="timeline relative">
    <span class="timeline-rule absolute inset-x-0 top-[28px] hidden h-px origin-left bg-line lg:block" aria-hidden="true"></span>
    <ol class="relative grid gap-y-6 border-l border-line pl-6 lg:grid-cols-5 lg:gap-x-[clamp(16px,2vw,36px)] lg:border-0 lg:pl-0">
      {
        experience.map((item, i) => (
          <li data-reveal style={`--i:${i}`} class="timeline-item group relative min-w-0 lg:flex lg:flex-col">
            <span class="eyebrow mb-0.5 block leading-4 text-muted tabular-nums lg:mb-2">{item.year}</span>
            <span
              class="absolute top-[4px] -left-[28.5px] size-[9px] rounded-full border border-muted bg-paper transition-colors duration-300 group-last:border-accent group-last:bg-accent group-hover:bg-ink lg:static lg:mb-3 lg:block"
              aria-hidden="true"
            />
            <h3 class="eyebrow mb-1 text-ink">{item.title}</h3>
            <p class="text-small text-muted">
              {item.icon && <Icon icon={item.icon} class="mr-1.5 text-[11px] text-accent" />}
              {item.description}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  :global(.js) .timeline-rule {
    transform: scaleX(0);
    transition: transform 1.4s var(--ease-out-soft) 0.2s;
  }
  :global(.js) .timeline:has(:global(.is-visible)) .timeline-rule {
    transform: scaleX(1);
  }

  .timeline-item > * {
    transition: opacity 0.3s ease;
  }
  @media (hover: hover) {
    .timeline:hover .timeline-item:not(:hover) > * {
      opacity: 0.35;
    }
  }
</style>
