---
// A minimal game-style skill wheel (after the GTA V weapon wheel the user picked): a ring of slots
// around a centre that shows the picked skill. Point at a slot (or tap / drag around it on touch)
// to pick it; left alone, it steps through the skills. Empty slots stay dashed until filled.
import type { Skill } from "../data/skills";
import SkillLogo from "./SkillLogo.astro";

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;
const N = Math.max(8, skills.length);
const S = 460; // viewBox size; the wheel scales to fit
const C = S / 2;
const INNER = 128;
const OUTER = 214;
const GAP = 1.2; // degrees trimmed off each side of a slot
const step = 360 / N;

const point = (r: number, deg: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [C + r * Math.cos(a), C + r * Math.sin(a)];
};
function slotPath(i: number) {
  const a0 = i * step - step / 2 + GAP;
  const a1 = i * step + step / 2 - GAP;
  const [x0, y0] = point(OUTER, a0);
  const [x1, y1] = point(OUTER, a1);
  const [x2, y2] = point(INNER, a1);
  const [x3, y3] = point(INNER, a0);
  return `M${x0} ${y0}A${OUTER} ${OUTER} 0 0 1 ${x1} ${y1}L${x2} ${y2}A${INNER} ${INNER} 0 0 0 ${x3} ${y3}Z`;
}
const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="gw" data-skill-wheel data-slots={N} aria-hidden="true">
  <svg viewBox={`0 0 ${S} ${S}`} class="block size-full overflow-visible">
    {
      Array.from({ length: N }, (_, i) => (
        <path d={slotPath(i)} class="slot" data-filled={i < skills.length ? "" : undefined} data-active={i === 0 ? "" : undefined} />
      ))
    }
  </svg>
  {
    skills.map((s, i) => {
      const [x, y] = point((INNER + OUTER) / 2, i * step);
      return (
        <span class="slot-logo" data-active={i === 0 ? "" : undefined} style={`left:${(x / S) * 100}%;top:${(y / S) * 100}%`}>
          <SkillLogo skill={s} class="size-[58%] text-[clamp(16px,4.5vw,24px)]" />
        </span>
      );
    })
  }
  <div class="hub">
    {
      skills.map((s, i) => (
        <div class="hub-item" data-active={i === 0 ? "" : undefined}>
          <SkillLogo skill={s} class="size-[clamp(36px,9vw,52px)] text-[clamp(32px,8vw,48px)]" />
          <p class="mt-2 font-serif text-[clamp(20px,5vw,30px)] leading-[1.05]">{s.name}</p>
          <p class="eyebrow mt-2 text-[9px] text-muted">
            {pad(i + 1)} / {pad(skills.length)}
          </p>
        </div>
      ))
    }
  </div>
</div>

<script>
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const AUTO_EVERY = 2400; // ms between automatic steps
  const IDLE_AFTER_USE = 5000; // ms to wait after the visitor picks before stepping again

  document.querySelectorAll<HTMLElement>("[data-skill-wheel]").forEach((wheel) => {
    const total = Number(wheel.dataset.slots);
    const slots = [...wheel.querySelectorAll<SVGPathElement>(".slot")];
    const logos = [...wheel.querySelectorAll<HTMLElement>(".slot-logo")];
    const hubItems = [...wheel.querySelectorAll<HTMLElement>(".hub-item")];
    const filled = logos.length;
    let current = 0;
    let lastUse = 0;
    let pressed = false;
    let hovered = false;

    function select(i: number) {
      if (i === current) return;
      current = i;
      slots.forEach((s, j) => s.toggleAttribute("data-active", j === i));
      logos.forEach((l, j) => l.toggleAttribute("data-active", j === i));
      hubItems.forEach((h, j) => h.toggleAttribute("data-active", j === i));
    }

    // The slot in the pointer's direction from the centre, like aiming a game wheel's stick.
    // Ignored near the centre (the direction jumps around there) and on empty slots.
    function slotAt(e: PointerEvent) {
      const r = wheel.getBoundingClientRect();
      const x = e.clientX - (r.left + r.width / 2);
      const y = e.clientY - (r.top + r.height / 2);
      if (Math.hypot(x, y) < r.width * 0.14) return -1;
      const deg = ((Math.atan2(x, -y) * 180) / Math.PI + 360) % 360;
      const i = Math.round(deg / (360 / total)) % total;
      return i < filled ? i : -1;
    }
    function pick(e: PointerEvent) {
      const i = slotAt(e);
      if (i < 0) return;
      lastUse = performance.now();
      select(i);
    }

    wheel.addEventListener("pointerenter", (e) => (hovered = e.pointerType === "mouse"));
    wheel.addEventListener("pointerleave", () => {
      hovered = false;
      pressed = false;
    });
    wheel.addEventListener("pointerdown", (e) => {
      pressed = true;
      pick(e);
    });
    wheel.addEventListener("pointermove", (e) => {
      if (hovered || pressed) pick(e);
    });
    wheel.addEventListener("pointerup", () => (pressed = false));
    wheel.addEventListener("pointercancel", () => (pressed = false));

    if (reduceMotion || filled < 2) return;
    let visible = false;
    // Also false while this wheel's tab is hidden.
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(wheel);
    setInterval(() => {
      const idle = performance.now() - lastUse > IDLE_AFTER_USE;
      if (visible && idle && !hovered && !pressed && !document.hidden) select((current + 1) % filled);
    }, AUTO_EVERY);
  });
</script>

<style>
  .gw {
    --slot-bg: color-mix(in srgb, var(--color-paper) 45%, white);
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1;
    margin-inline: auto;
    user-select: none;
    /* Vertical swipes still scroll the page. */
    touch-action: pan-y;
  }
  :global([data-theme="dark"]) .gw {
    --slot-bg: color-mix(in srgb, var(--color-paper) 90%, white);
  }
  .slot {
    fill: transparent;
    stroke: var(--color-line);
    stroke-dasharray: 3 4;
    transition:
      fill 0.2s ease,
      stroke 0.2s ease;
  }
  .slot[data-filled] {
    fill: var(--slot-bg);
    stroke-dasharray: none;
    cursor: pointer;
  }
  .slot[data-active] {
    fill: var(--color-ink);
    stroke: var(--color-ink);
  }
  .slot-logo {
    position: absolute;
    display: grid;
    place-items: center;
    width: 11%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    pointer-events: none;
    transition: background-color 0.2s ease;
  }
  .slot-logo[data-active] {
    background: var(--color-paper);
  }
  .slot-logo :global(img) {
    -webkit-user-drag: none;
  }
  .hub {
    position: absolute;
    inset: 30%;
    pointer-events: none;
  }
  .hub-item {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity 0.2s ease,
      translate 0.35s var(--ease-out-soft);
  }
  .hub-item[data-active] {
    opacity: 1;
    translate: none;
  }
</style>
