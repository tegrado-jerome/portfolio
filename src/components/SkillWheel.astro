---
// The skill wheel as a radio tuning dial (after the Braun dials by Dieter Rams, picked by the user
// to match the site's hairline look): a ring of fine ticks with logos outside it turns under a fixed
// needle. Drag in a circle to spin it; the logo that stops under the needle is the pick, shown in
// colour and in the centre. A tap or click turns a logo to the needle; left alone, it steps round.
import type { Skill } from "../data/skills";
import SkillLogo from "./SkillLogo.astro";

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;
// Every position holds a logo: short lists repeat round the dial so it never looks empty.
const N = Math.max(8, skills.length);
const slotSkills = Array.from({ length: N }, (_, i) => skills[i % skills.length]);
const S = 460; // viewBox size; the dial scales to fit
const C = S / 2;
const TICKS = N * 8;
const TICK_OUTER = 163;
const LOGO_RADIUS = 200;
const step = 360 / N;

const point = (r: number, deg: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [C + r * Math.cos(a), C + r * Math.sin(a)];
};
const ticks = Array.from({ length: TICKS }, (_, t) => {
  const deg = (t * 360) / TICKS;
  const major = t % 8 === 0; // one long tick per logo
  const [x1, y1] = point(major ? 146 : 153, deg);
  const [x2, y2] = point(TICK_OUTER, deg);
  return { x1, y1, x2, y2, major };
});
const [needleX, needleY] = point(170, 0);
const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="dial-wrap" data-skill-wheel aria-hidden="true">
  <div class="dial">
    <svg viewBox={`0 0 ${S} ${S}`} class="block size-full overflow-visible">
      {ticks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class:list={["tick", t.major && "major"]} />)}
    </svg>
    {
      slotSkills.map((s, i) => {
        const [x, y] = point(LOGO_RADIUS, i * step);
        return (
          <span class="dial-logo" data-active={i === 0 ? "" : undefined} style={`left:${(x / S) * 100}%;top:${(y / S) * 100}%`}>
            <SkillLogo skill={s} class="size-full text-[clamp(18px,4.5vw,28px)]" />
          </span>
        );
      })
    }
  </div>

  <svg viewBox={`0 0 ${S} ${S}`} class="needle">
    <line x1={C} y1={C - 88} x2={needleX} y2={needleY} />
    <circle cx={needleX} cy={needleY} r="3.5" />
  </svg>

  <div class="hub">
    {
      skills.map((s, i) => (
        <div class="hub-item" data-active={i === 0 ? "" : undefined}>
          <SkillLogo skill={s} class="size-[clamp(34px,8vw,48px)] text-[clamp(30px,7vw,44px)]" />
          <p class="mt-2 text-heading">{s.name}</p>
          <p class="eyebrow mt-2 text-muted">
            {pad(i + 1)} / {pad(skills.length)}
          </p>
        </div>
      ))
    }
  </div>
</div>

<script>
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const AUTO_EVERY = 4500; // ms between automatic steps: slow and calm
  const IDLE_AFTER_USE = 5000; // ms to wait after the visitor spins or picks before stepping again
  const TAP_SLOP = 6; // px of movement that still counts as a tap

  document.querySelectorAll<HTMLElement>("[data-skill-wheel]").forEach((wheel) => {
    const logos = [...wheel.querySelectorAll<HTMLElement>(".dial-logo")];
    const hubItems = [...wheel.querySelectorAll<HTMLElement>(".hub-item")];
    const total = logos.length;
    const step = 360 / total;
    const mod = (a: number, n: number) => ((a % n) + n) % n;
    const snap = (deg: number) => Math.round(deg / step) * step;

    // The dial's rotation in degrees. Logo i sits at i * step, so the one under the needle is -angle / step.
    let angle = 0;
    let target = 0;
    let active = 0;
    let raf = 0;

    function render() {
      wheel.style.setProperty("--turn", `${angle}deg`);
      const top = mod(Math.round(-angle / step), total);
      if (top === active) return;
      active = top;
      logos.forEach((l, i) => l.toggleAttribute("data-active", i === top));
      hubItems.forEach((h, i) => h.toggleAttribute("data-active", i === top % hubItems.length));
    }
    // Ease towards the target every frame; the same loop handles snapping, coasting and auto-steps.
    function tick() {
      const diff = target - angle;
      if (reduceMotion || Math.abs(diff) < 0.02) {
        angle = target;
        render();
        raf = 0;
        return;
      }
      angle += diff * 0.09; // a slow, calm settle
      render();
      raf = requestAnimationFrame(tick);
    }
    function moveTo(deg: number) {
      target = deg;
      if (!raf) raf = requestAnimationFrame(tick);
    }

    // The pointer's angle around the centre, clockwise from the top, and its distance from it.
    function polar(e: PointerEvent) {
      const r = wheel.getBoundingClientRect();
      const x = e.clientX - (r.left + r.width / 2);
      const y = e.clientY - (r.top + r.height / 2);
      return { deg: (Math.atan2(x, -y) * 180) / Math.PI, dist: Math.hypot(x, y), size: r.width };
    }

    let lastUse = 0;
    let dragging = false;
    let hovered = false;
    let startX = 0, startY = 0, lastDeg = 0, lastT = 0, velocity = 0, moved = 0;

    wheel.addEventListener("pointerdown", (e) => {
      const p = polar(e);
      // Grab only the dial's rim; the centre is left for scrolling the page on touch screens.
      if (e.button !== 0 || p.dist < p.size * 0.26) return;
      dragging = true;
      moved = 0;
      velocity = 0;
      startX = e.clientX;
      startY = e.clientY;
      lastDeg = p.deg;
      lastT = e.timeStamp;
      target = angle; // stop any coasting where it is
      wheel.setPointerCapture(e.pointerId);
      wheel.classList.add("is-dragging");
    });
    wheel.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const p = polar(e);
      // unwrap across the -180/180 seam so a full circle keeps turning the same way
      const delta = ((p.deg - lastDeg + 540) % 360) - 180;
      const dt = Math.max(1, e.timeStamp - lastT);
      moved = Math.max(moved, Math.hypot(e.clientX - startX, e.clientY - startY));
      velocity = 0.8 * (delta / dt) + 0.2 * velocity; // deg per ms, smoothed
      angle += delta;
      target = angle;
      lastDeg = p.deg;
      lastT = e.timeStamp;
      render();
    });
    function release(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      wheel.classList.remove("is-dragging");
      lastUse = performance.now();
      if (moved < TAP_SLOP) {
        // A tap: turn the tapped logo to the needle the short way round.
        const tapped = mod(Math.round((polar(e).deg - angle) / step), total);
        let d = mod(tapped + snap(angle) / step, total); // steps clockwise from the needle
        if (d > total / 2) d -= total;
        moveTo(snap(angle) - d * step);
        return;
      }
      // Coast with the release speed, then settle a logo under the needle.
      moveTo(snap(angle + velocity * 260));
    }
    wheel.addEventListener("pointerup", release);
    wheel.addEventListener("pointercancel", release);
    wheel.addEventListener("pointerenter", (e) => (hovered = e.pointerType === "mouse"));
    wheel.addEventListener("pointerleave", () => (hovered = false));

    if (reduceMotion) return;
    let visible = false;
    // Also false while this dial's tab is hidden.
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(wheel);
    setInterval(() => {
      const idle = performance.now() - lastUse > IDLE_AFTER_USE;
      if (visible && idle && !hovered && !dragging && !document.hidden) moveTo(snap(target) - step);
    }, AUTO_EVERY);
  });
</script>

<style>
  .dial-wrap {
    --turn: 0deg;
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1;
    margin-inline: auto;
    user-select: none;
    /* The rim spins under a finger instead of scrolling the page; the centre still scrolls. */
    touch-action: none;
    cursor: grab;
  }
  /* On phones it fills the column, so a touch smaller there leaves it some air. */
  @media (max-width: 767px) {
    .dial-wrap {
      width: min(88%, 420px);
    }
  }
  .dial-wrap.is-dragging {
    cursor: grabbing;
  }
  .dial {
    position: absolute;
    inset: 0;
    rotate: var(--turn);
  }
  .tick {
    stroke: var(--color-line);
    stroke-width: 1;
  }
  .tick.major {
    stroke: var(--color-muted);
  }
  .dial-logo {
    position: absolute;
    width: 7.5%;
    aspect-ratio: 1;
    translate: -50% -50%;
    /* Stays upright while the dial turns. */
    rotate: calc(var(--turn) * -1);
    filter: grayscale(1);
    opacity: 0.45;
    transition:
      filter 0.25s ease,
      opacity 0.25s ease,
      scale 0.25s ease;
    pointer-events: none;
  }
  /* The logo under the needle shows its brand colour, like the big one in the hub; the rest of the dial stays grey. */
  .dial-logo[data-active] {
    filter: none;
    opacity: 1;
    scale: 1.2;
  }
  .dial-logo :global(img) {
    -webkit-user-drag: none;
  }
  .needle {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
    stroke: var(--color-ink);
    stroke-width: 1.5;
    fill: var(--color-ink);
  }
  .hub {
    position: absolute;
    inset: 30%;
    top: 34%;
    border-radius: 50%;
    touch-action: pan-y;
  }
  .hub-item {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity 0.2s ease,
      translate 0.35s var(--ease-out-soft);
  }
  .hub-item[data-active] {
    opacity: 1;
    translate: none;
  }
</style>
