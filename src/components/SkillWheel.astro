---
// A minimal game-style skill wheel (after the GTA V weapon wheel the user picked) that turns like a
// real dial: drag in a circle to spin the ring, and whichever slot stops under the marker at the top
// is picked and shown in the centre. A tap or click turns a slot to the top; left alone, it steps round.
import type { Skill } from "../data/skills";
import SkillLogo from "./SkillLogo.astro";

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;
// Every slot holds a logo: short lists repeat round the ring so it never looks empty.
const N = Math.max(8, skills.length);
const slotSkills = Array.from({ length: N }, (_, i) => skills[i % skills.length]);
const S = 460; // viewBox size; the wheel scales to fit
const C = S / 2;
const INNER = 128;
const OUTER = 214;
const GAP = 1.2; // degrees trimmed off each side of a slot
const step = 360 / N;

const point = (r: number, deg: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [C + r * Math.cos(a), C + r * Math.sin(a)];
};
function slotPath(i: number) {
  const a0 = i * step - step / 2 + GAP;
  const a1 = i * step + step / 2 - GAP;
  const [x0, y0] = point(OUTER, a0);
  const [x1, y1] = point(OUTER, a1);
  const [x2, y2] = point(INNER, a1);
  const [x3, y3] = point(INNER, a0);
  return `M${x0} ${y0}A${OUTER} ${OUTER} 0 0 1 ${x1} ${y1}L${x2} ${y2}A${INNER} ${INNER} 0 0 0 ${x3} ${y3}Z`;
}
const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="gw" data-skill-wheel aria-hidden="true">
  <div class="dial">
    <svg viewBox={`0 0 ${S} ${S}`} class="block size-full overflow-visible">
      {
        Array.from({ length: N }, (_, i) => (
          <path d={slotPath(i)} class="slot" data-index={i} data-active={i === 0 ? "" : undefined} />
        ))
      }
    </svg>
    {
      slotSkills.map((s, i) => {
        const [x, y] = point((INNER + OUTER) / 2, i * step);
        return (
          <span class="slot-logo" data-active={i === 0 ? "" : undefined} style={`left:${(x / S) * 100}%;top:${(y / S) * 100}%`}>
            <SkillLogo skill={s} class="size-[58%] text-[clamp(16px,4.5vw,24px)]" />
          </span>
        );
      })
    }
  </div>
  <span class="marker"></span>
  <div class="hub">
    {
      skills.map((s, i) => (
        <div class="hub-item" data-active={i === 0 ? "" : undefined}>
          <SkillLogo skill={s} class="size-[clamp(36px,9vw,52px)] text-[clamp(32px,8vw,48px)]" />
          <p class="mt-2 font-serif text-[clamp(20px,5vw,30px)] leading-[1.05]">{s.name}</p>
          <p class="eyebrow mt-2 text-[9px] text-muted">
            {pad(i + 1)} / {pad(skills.length)}
          </p>
        </div>
      ))
    }
  </div>
</div>

<script>
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const AUTO_EVERY = 2400; // ms between automatic steps
  const IDLE_AFTER_USE = 5000; // ms to wait after the visitor spins or picks before stepping again
  const TAP_SLOP = 6; // px of movement that still counts as a tap

  document.querySelectorAll<HTMLElement>("[data-skill-wheel]").forEach((wheel) => {
    const dial = wheel.querySelector<HTMLElement>(".dial")!;
    const slots = [...dial.querySelectorAll<SVGPathElement>(".slot")];
    const logos = [...dial.querySelectorAll<HTMLElement>(".slot-logo")];
    const hubItems = [...wheel.querySelectorAll<HTMLElement>(".hub-item")];
    const total = slots.length;
    const step = 360 / total;
    const mod = (a: number, n: number) => ((a % n) + n) % n;
    const snap = (deg: number) => Math.round(deg / step) * step;

    // The dial's rotation in degrees. Slot i sits at i * step, so the slot under the marker is -angle / step.
    let angle = 0;
    let target = 0;
    let active = 0;
    let raf = 0;

    function render() {
      wheel.style.setProperty("--turn", `${angle}deg`);
      const top = mod(Math.round(-angle / step), total);
      if (top === active) return;
      active = top;
      slots.forEach((s, i) => s.toggleAttribute("data-active", i === top));
      logos.forEach((l, i) => l.toggleAttribute("data-active", i === top));
      hubItems.forEach((h, i) => h.toggleAttribute("data-active", i === top % hubItems.length));
    }
    // Ease towards the target every frame; the same loop handles snapping, coasting and auto-steps.
    function tick() {
      const diff = target - angle;
      if (reduceMotion || Math.abs(diff) < 0.02) {
        angle = target;
        render();
        raf = 0;
        return;
      }
      angle += diff * 0.16;
      render();
      raf = requestAnimationFrame(tick);
    }
    function moveTo(deg: number) {
      target = deg;
      if (!raf) raf = requestAnimationFrame(tick);
    }

    // The pointer's angle around the centre, clockwise from the top, and its distance from it.
    function polar(e: PointerEvent) {
      const r = wheel.getBoundingClientRect();
      const x = e.clientX - (r.left + r.width / 2);
      const y = e.clientY - (r.top + r.height / 2);
      return { deg: (Math.atan2(x, -y) * 180) / Math.PI, dist: Math.hypot(x, y), size: r.width };
    }

    let lastUse = 0;
    let dragging = false;
    let hovered = false;
    let startX = 0, startY = 0, lastDeg = 0, lastT = 0, velocity = 0, moved = 0;

    wheel.addEventListener("pointerdown", (e) => {
      const p = polar(e);
      // Grab only the ring; the centre is left for scrolling the page on touch screens.
      if (e.button !== 0 || p.dist < p.size * 0.26) return;
      dragging = true;
      moved = 0;
      velocity = 0;
      startX = e.clientX;
      startY = e.clientY;
      lastDeg = p.deg;
      lastT = e.timeStamp;
      target = angle; // stop any coasting where it is
      wheel.setPointerCapture(e.pointerId);
      wheel.classList.add("is-dragging");
    });
    wheel.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const p = polar(e);
      // unwrap across the -180/180 seam so a full circle keeps turning the same way
      const delta = ((p.deg - lastDeg + 540) % 360) - 180;
      const dt = Math.max(1, e.timeStamp - lastT);
      moved = Math.max(moved, Math.hypot(e.clientX - startX, e.clientY - startY));
      velocity = 0.8 * (delta / dt) + 0.2 * velocity; // deg per ms, smoothed
      angle += delta;
      target = angle;
      lastDeg = p.deg;
      lastT = e.timeStamp;
      render();
    });
    function release(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      wheel.classList.remove("is-dragging");
      lastUse = performance.now();
      if (moved < TAP_SLOP) {
        // A tap: turn the tapped slot to the top the short way round.
        const tapped = mod(Math.round((polar(e).deg - angle) / step), total);
        let d = mod(tapped + snap(angle) / step, total); // steps clockwise from the marker
        if (d > total / 2) d -= total;
        moveTo(snap(angle) - d * step);
        return;
      }
      // Coast with the release speed, then settle a slot under the marker.
      moveTo(snap(angle + velocity * 260));
    }
    wheel.addEventListener("pointerup", release);
    wheel.addEventListener("pointercancel", release);
    wheel.addEventListener("pointerenter", (e) => (hovered = e.pointerType === "mouse"));
    wheel.addEventListener("pointerleave", () => (hovered = false));

    if (reduceMotion) return;
    let visible = false;
    // Also false while this wheel's tab is hidden.
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(wheel);
    setInterval(() => {
      const idle = performance.now() - lastUse > IDLE_AFTER_USE;
      if (visible && idle && !hovered && !dragging && !document.hidden) moveTo(snap(target) - step);
    }, AUTO_EVERY);
  });
</script>

<style>
  .gw {
    --slot-bg: color-mix(in srgb, var(--color-paper) 45%, white);
    --turn: 0deg;
    position: relative;
    width: min(100%, 460px);
    aspect-ratio: 1;
    margin-inline: auto;
    user-select: none;
    /* The ring spins under a finger instead of scrolling the page; the centre still scrolls. */
    touch-action: none;
    cursor: grab;
  }
  .gw.is-dragging {
    cursor: grabbing;
  }
  :global([data-theme="dark"]) .gw {
    --slot-bg: color-mix(in srgb, var(--color-paper) 90%, white);
  }
  .dial {
    position: absolute;
    inset: 0;
    rotate: var(--turn);
  }
  .slot {
    fill: var(--slot-bg);
    stroke: var(--color-line);
    transition:
      fill 0.2s ease,
      stroke 0.2s ease;
  }
  .slot:hover {
    stroke: var(--color-ink);
  }
  .slot[data-active] {
    fill: var(--color-ink);
    stroke: var(--color-ink);
  }
  .slot-logo {
    position: absolute;
    display: grid;
    place-items: center;
    width: 11%;
    aspect-ratio: 1;
    translate: -50% -50%;
    /* Stays upright while the dial turns. */
    rotate: calc(var(--turn) * -1);
    border-radius: 50%;
    pointer-events: none;
    transition: background-color 0.2s ease;
  }
  .slot-logo[data-active] {
    background: var(--color-paper);
  }
  .slot-logo :global(img) {
    -webkit-user-drag: none;
  }
  /* The selector: a small notch above the ring pointing at the picked slot. */
  .marker {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% -60%;
    width: 0;
    height: 0;
    border-inline: 7px solid transparent;
    border-top: 9px solid var(--color-ink);
    pointer-events: none;
  }
  .hub {
    position: absolute;
    inset: 30%;
    border-radius: 50%;
    touch-action: pan-y;
  }
  .hub-item {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity 0.2s ease,
      translate 0.35s var(--ease-out-soft);
  }
  .hub-item[data-active] {
    opacity: 1;
    translate: none;
  }
</style>
