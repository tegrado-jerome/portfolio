---
// A TUI status line pinned to the bottom (vim / btop): mode badge, the pane you're in, key hints and a clock.
// Laptops and desktops only; the keys it names work there: ↑↓ jump between panes, / focuses the AI prompt.
---

<!-- Decorative parts are hidden from screen readers; the two buttons stay reachable and named. -->
<div class="status">
  <span class="mode" aria-hidden="true">tui</span>
  <span class="text-ink" aria-hidden="true"><span class="text-accent">~/</span><span data-status-pane>jerome-tegrado</span></span>
  <span class="ml-auto flex items-center gap-4 text-muted">
    <span aria-hidden="true"><kbd>↑↓</kbd> panes</span>
    <button type="button" data-status-ask aria-label="Ask my AI"><kbd aria-hidden="true">/</kbd> ask</button>
    <button type="button" data-palette-open aria-label="Open command menu"><kbd aria-hidden="true">⌘K</kbd> menu</button>
    <time data-status-clock class="text-ink tabular-nums" aria-hidden="true"></time>
  </span>
</div>

<style>
  .status {
    display: none;
  }
  @media (min-width: 1024px) {
    .status {
      position: fixed;
      inset: auto 0 0;
      z-index: 35;
      display: flex;
      align-items: center;
      gap: 14px;
      height: 32px;
      padding-inline: clamp(20px, 10vw, 200px);
      border-top: 1px solid var(--color-line);
      background: var(--color-paper);
      font-size: var(--text-small);
    }
    /* Room at the page bottom for the bar, and the chat button sits above it. */
    :global(body) {
      padding-bottom: 32px;
    }
    :global([data-chat-open]) {
      bottom: 48px !important;
    }
  }
  .mode {
    padding-inline: 8px;
    background: var(--color-ink);
    color: var(--color-paper);
  }
  kbd {
    margin-right: 4px;
    padding-inline: 4px;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    color: var(--color-ink);
    font: inherit;
  }
  button:hover {
    color: var(--color-ink);
  }
</style>

<script>
  const panes = [...document.querySelectorAll<HTMLElement>("[data-pane]")];
  const paneLabel = document.querySelector<HTMLElement>("[data-status-pane]");
  const clock = document.querySelector<HTMLTimeElement>("[data-status-clock]");

  // The pane whose top is nearest above the middle of the screen is the current one.
  function currentPane() {
    const mid = innerHeight / 2;
    let index = 0;
    panes.forEach((p, i) => {
      if (p.getBoundingClientRect().top <= mid) index = i;
    });
    return index;
  }
  // At most once per frame, and only where the bar is shown (it's hidden below 1024px).
  let queued = false;
  function syncPane() {
    queued = false;
    if (!paneLabel || !panes.length || !paneLabel.offsetParent) return;
    const name = panes[currentPane()].dataset.pane ?? "";
    if (paneLabel.textContent !== name) paneLabel.textContent = name;
  }
  addEventListener(
    "scroll",
    () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(syncPane);
    },
    { passive: true },
  );
  syncPane();

  function tickClock() {
    if (clock) clock.textContent = new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", hour12: false });
  }
  tickClock();
  setInterval(tickClock, 15_000);

  function focusAsk() {
    const ask = document.getElementById("hero-ask");
    if (!ask) return;
    scrollTo({ top: 0, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    ask.focus({ preventScroll: true });
  }
  document.querySelector("[data-status-ask]")?.addEventListener("click", focusAsk);

  // TUI keys, only when not typing and nothing modal is open: ↑↓ jump between panes, / focuses the AI prompt.
  addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || e.defaultPrevented) return;
    const el = e.target as HTMLElement;
    if (el.closest("input, textarea, select, [role=tablist], [contenteditable], dialog, #chat")) return;
    if (document.documentElement.classList.contains("chat-open")) return;
    if (e.key === "/") {
      e.preventDefault();
      focusAsk();
      return;
    }
    const d = e.key === "ArrowDown" ? 1 : e.key === "ArrowUp" ? -1 : 0;
    if (!d || !panes.length) return;
    e.preventDefault();
    const next = panes[Math.min(panes.length - 1, Math.max(0, currentPane() + d))];
    next.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
  });
</script>
