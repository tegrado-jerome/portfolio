---
// A credentials section printed as a terminal log (Awards, Certifications): one block per entry with
// "✓ year title" on the first line and each detail on its own indented "└" line, so long details list
// neatly instead of wrapping into a crowded paragraph.
import SectionHead from "./SectionHead.astro";

export interface Credential {
  title: string;
  year: string;
  /** Detail lines under the title, e.g. the issuer and a credential ID. Empty ones are skipped. */
  lines: string[];
  href?: string;
}

interface Props {
  id: string;
  title: string;
  entries: Credential[];
}

const { id, title, entries } = Astro.props;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

{
  entries.length > 0 && (
    <section id={id} class="shell section" aria-labelledby={`${id}-title`}>
      <div class="pane" data-pane={slug}>
        <SectionHead id={`${id}-title`} title={title} meta={`${entries.length} total`} />
        <ul class="flex flex-col gap-5 font-mono text-small sm:text-body">
          {entries.map((e, i) => (
            <li data-reveal style={`--i:${i}`} class="line grid grid-cols-[auto_auto_minmax(0,1fr)] gap-x-[1.2ch] py-1">
              <span class="text-online" aria-hidden="true">✓</span>
              <span class="text-ink tabular-nums">{e.year}</span>
              <span>
                {e.href ? (
                  <a href={e.href} target="_blank" rel="noopener noreferrer" class="link-strong">
                    {e.title}
                  </a>
                ) : (
                  <span class="text-ink">{e.title}</span>
                )}
              </span>
              <span class="col-span-2 col-start-2 mt-1 block text-small leading-[1.7] text-muted">
                {e.lines.filter(Boolean).map((line) => (
                  <span class="block pl-[2ch] -indent-[2ch]">
                    <span aria-hidden="true">└ </span>
                    {line}
                  </span>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  /* Hovering a line highlights it like a selected row in a terminal. */
  .line {
    margin-inline: -8px;
    padding-inline: 8px;
    border-radius: 3px;
    transition: background-color 0.2s ease;
  }
  .line:hover {
    background: color-mix(in srgb, var(--color-ink) 5%, transparent);
  }
</style>
