---
// The page scrollbar drawn as a terminal block bar (btop / lazygit): a ░-style dithered track with a █-style thumb,
// matching the boot screen's progress bar. The same on every device and browser.
// It's a visual mirror of the page scroll: drag the thumb or click the track, and keyboard scrolling still works.
// Beside it, the section you're in shows as its ~/path, at that section's spot on the bar; click it to go to its top.
---

<div class="tui-scroll" data-tui-scroll aria-hidden="true">
  <div class="track" data-track></div>
  <div class="bar" data-thumb></div>
  <span class="here" data-here></span>
</div>

<style>
  /* Same bar on every device and browser. It needs JS, so without it the native scrollbar stays. */
  .tui-scroll {
    display: none;
  }
  :global(html.js) {
    scrollbar-width: none;
  }
  :global(html.js::-webkit-scrollbar) {
    display: none;
  }
  :global(.js) .tui-scroll {
    position: fixed;
    top: 6px;
    right: 3px;
    bottom: 6px;
    z-index: 36;
    display: block;
    width: 6px;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    /* Slides up and down with the header, at the header's speed. */
    transition: top 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* Stops above the status bar where that shows. */
  @media (min-width: 1024px) {
    :global(.js) .tui-scroll {
      bottom: 38px;
    }
  }
  /* Drawn in CSS rather than with ░ █ glyphs, which the web font doesn't have: a 2px dither for the track,
     solid rows with a 1px gap for the thumb. */
  .track {
    position: absolute;
    inset: 0;
    background: repeating-conic-gradient(var(--color-muted) 0 25%, transparent 0 50%) 0 0 / 4px 4px;
    opacity: 0.3;
    cursor: pointer;
  }
  .bar {
    position: absolute;
    left: 0;
    width: 100%;
    background: repeating-linear-gradient(var(--color-bar) 0 9px, transparent 9px 10px);
    cursor: grab;
    /* Dragging the thumb on a touch screen moves the bar, not the page. */
    touch-action: none;
    --color-bar: var(--color-ink);
  }
  /* A wider invisible grab area, since the bar itself is thin. */
  .bar::before {
    content: "";
    position: absolute;
    inset: 0 -6px;
  }
  .bar.is-dragging {
    --color-bar: var(--color-accent);
  }
  /* Hover only on mouse devices; on touch screens it would stick after a tap. */
  @media (hover: hover) {
    .tui-scroll:hover .bar {
      --color-bar: var(--color-accent);
    }
  }
  .bar.is-dragging {
    cursor: grabbing;
  }
  /* The current section's ~/path, in the same inverted look as the site's active tab. It glides between spots. */
  .here {
    position: absolute;
    right: 9px;
    padding: 3px 5px;
    background: var(--color-ink);
    color: var(--color-paper);
    font: var(--text-label) / 1 var(--font-mono);
    white-space: nowrap;
    cursor: pointer;
    transition:
      top 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
  }
  .here:empty {
    opacity: 0;
  }
  @media (hover: hover) {
    .here:hover {
      background: var(--color-accent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .here {
      transition: none;
    }
  }
</style>

<script>
  import { pointTo } from "../scripts/point";

  const root = document.querySelector<HTMLElement>("[data-tui-scroll]");
  if (root) {
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const thumb = root.querySelector<HTMLElement>("[data-thumb]")!;
    const here = root.querySelector<HTMLElement>("[data-here]")!;
    const sections = [...document.querySelectorAll<HTMLElement>("#top, main section[id], #contact")];
    let current = -1;
    const LINE = 10; // px per block row
    let thumbRows = 0;
    let trackRows = 0;

    const doc = document.documentElement;
    const maxScroll = () => Math.max(1, doc.scrollHeight - innerHeight);

    // The bar starts just under the header, and takes its space while it's hidden on scroll.
    // The thumb is sized in whole rows to how much of the page is visible. Rows are counted on the bar's full height
    // (header hidden), so while the bar grows or shrinks with the header the thumb keeps its size and only glides.
    const header = document.getElementById("site-header");
    function layout() {
      if (header) root!.style.top = `${header.classList.contains("is-hidden") ? 6 : header.offsetHeight + 6}px`;
      trackRows = Math.floor((root!.getBoundingClientRect().bottom - 6) / LINE);
      thumbRows = Math.max(3, Math.round(trackRows * (innerHeight / doc.scrollHeight)));
      thumb.style.height = `${thumbRows * LINE}px`;
      root!.style.visibility = doc.scrollHeight > innerHeight + 1 ? "visible" : "hidden";
      position();
    }
    // Move the thumb in row steps, like a real terminal bar. The steps are stretched to the bar's current height
    // (rarely a whole number of rows) so the last one lands flush with the bottom.
    function position() {
      const steps = Math.max(1, trackRows - thumbRows);
      const step = Math.round(Math.min(1, scrollY / maxScroll()) * steps);
      const space = Math.max(0, root!.clientHeight - thumbRows * LINE);
      thumb.style.transform = `translateY(${Math.round((step / steps) * space)}px)`;
      mark();
    }

    // The section you're in is the last one whose top has passed a third of the way down the screen, or the last
    // one at the very bottom. Its label sits at that section's spot, the sections spread evenly down the bar.
    function mark() {
      if (!sections.length) return;
      let i = 0;
      sections.forEach((s, j) => {
        if (s.getBoundingClientRect().top <= innerHeight / 3) i = j;
      });
      if (scrollY >= maxScroll() - 2) i = sections.length - 1;
      if (i !== current) {
        current = i;
        here.textContent = sections[i].id === "top" ? "~/" : `~/${sections[i].id}`;
      }
      const slot = sections.length > 1 ? i / (sections.length - 1) : 0;
      here.style.top = `${Math.round(slot * (root!.clientHeight - here.offsetHeight))}px`;
    }
    here.addEventListener("click", () => pointTo(sections[current]?.id ?? "top"));

    let queued = false;
    addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          position();
        });
      },
      { passive: true },
    );
    const resize = new ResizeObserver(layout);
    resize.observe(document.body);
    resize.observe(root);
    if (header) {
      resize.observe(header);
      new MutationObserver(layout).observe(header, { attributes: true, attributeFilter: ["class"] });
    }
    addEventListener("resize", layout);
    layout();

    // Click the track to jump there; drag the thumb to scroll.
    track.addEventListener("pointerdown", (e) => {
      const rect = root.getBoundingClientRect();
      const ratio = (e.clientY - rect.top - (thumbRows * LINE) / 2) / (rect.height - thumbRows * LINE);
      scrollTo({ top: Math.min(1, Math.max(0, ratio)) * maxScroll() });
    });
    let startY = 0;
    let startScroll = 0;
    thumb.addEventListener("pointerdown", (e) => {
      startY = e.clientY;
      startScroll = scrollY;
      thumb.setPointerCapture(e.pointerId);
      thumb.classList.add("is-dragging");
      doc.style.scrollBehavior = "auto"; // follow the pointer exactly while dragging
    });
    thumb.addEventListener("pointermove", (e) => {
      if (!thumb.hasPointerCapture(e.pointerId)) return;
      const trackSpace = root.clientHeight - thumbRows * LINE;
      scrollTo({ top: startScroll + ((e.clientY - startY) / trackSpace) * maxScroll() });
    });
    const stop = (e: PointerEvent) => {
      if (thumb.hasPointerCapture(e.pointerId)) thumb.releasePointerCapture(e.pointerId);
      thumb.classList.remove("is-dragging");
      doc.style.removeProperty("scroll-behavior");
    };
    thumb.addEventListener("pointerup", stop);
    thumb.addEventListener("pointercancel", stop);
  }
</script>
