---
// The page scrollbar drawn as a terminal block (btop / lazygit): a █-style thumb on an invisible track, matching the
// boot screen's progress bar. The same on every device and browser.
// It's a visual mirror of the page scroll: drag the thumb or click the track, and keyboard scrolling still works.
// It shows while scrolling and fades out a second after.
---

<div class="tui-scroll" data-tui-scroll aria-hidden="true">
  <div class="track" data-track></div>
  <div class="bar" data-thumb></div>
</div>

<style>
  /* Same bar on every device and browser. It needs JS, so without it the native scrollbar stays. */
  .tui-scroll {
    display: none;
  }
  :global(html.js) {
    scrollbar-width: none;
  }
  :global(html.js::-webkit-scrollbar) {
    display: none;
  }
  :global(.js) .tui-scroll {
    position: fixed;
    top: 6px;
    right: 3px;
    bottom: 6px;
    z-index: 36;
    display: block;
    width: 10px;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  /* Stops above the status bar where that shows. */
  @media (min-width: 1024px) {
    :global(.js) .tui-scroll {
      bottom: 38px;
    }
  }
  /* Only the thumb shows. The track is invisible but still takes clicks. The thumb is drawn in CSS rather than
     with █ glyphs, which the web font doesn't have: solid rows with a 1px gap. */
  .track {
    position: absolute;
    inset: 0;
    cursor: pointer;
  }
  .bar {
    position: absolute;
    left: 0;
    width: 100%;
    background: repeating-linear-gradient(var(--color-bar) 0 9px, transparent 9px 10px);
    cursor: grab;
    /* Dragging the thumb on a touch screen moves the bar, not the page. */
    touch-action: none;
    --color-bar: var(--color-ink);
    /* Hidden at rest, like macOS and phone scrollbars: it only shows while the page scrolls or the thumb is dragged. */
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .tui-scroll.is-active .bar,
  .bar.is-dragging {
    opacity: 1;
    transition-duration: 0.15s;
  }
  .bar.is-dragging {
    --color-bar: var(--color-accent);
  }
  /* Hover only on mouse devices; on touch screens it would stick after a tap. */
  @media (hover: hover) {
    .tui-scroll:hover .bar {
      --color-bar: var(--color-accent);
    }
  }
  .bar.is-dragging {
    cursor: grabbing;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-tui-scroll]");
  if (root) {
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const thumb = root.querySelector<HTMLElement>("[data-thumb]")!;
    const LINE = 10; // px per block row
    let thumbRows = 0;
    let trackRows = 0;

    const doc = document.documentElement;
    const maxScroll = () => Math.max(1, doc.scrollHeight - innerHeight);

    // The bar starts just under the header. The thumb is sized in whole rows to how much of the page is visible.
    const header = document.getElementById("site-header");
    function layout() {
      if (header) root!.style.top = `${header.offsetHeight + 6}px`;
      trackRows = Math.floor(root!.clientHeight / LINE);
      thumbRows = Math.max(3, Math.round(trackRows * (innerHeight / doc.scrollHeight)));
      thumb.style.height = `${thumbRows * LINE}px`;
      root!.style.visibility = doc.scrollHeight > innerHeight + 1 ? "visible" : "hidden";
      position();
    }
    // Move the thumb in row steps, like a real terminal bar. The steps are stretched to the bar's real height
    // (rarely a whole number of rows) so the last one lands flush with the bottom.
    function position() {
      const steps = Math.max(1, trackRows - thumbRows);
      const step = Math.round(Math.min(1, scrollY / maxScroll()) * steps);
      const space = root!.clientHeight - thumbRows * LINE;
      thumb.style.transform = `translateY(${Math.round((step / steps) * space)}px)`;
    }

    let queued = false;
    let idle = 0;
    addEventListener(
      "scroll",
      () => {
        root!.classList.add("is-active");
        clearTimeout(idle);
        idle = window.setTimeout(() => root!.classList.remove("is-active"), 1000);
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          position();
        });
      },
      { passive: true },
    );
    const resize = new ResizeObserver(layout);
    resize.observe(document.body);
    if (header) resize.observe(header);
    addEventListener("resize", layout);
    layout();

    // Click the track to jump there; drag the thumb to scroll.
    track.addEventListener("pointerdown", (e) => {
      const rect = root.getBoundingClientRect();
      const ratio = (e.clientY - rect.top - (thumbRows * LINE) / 2) / (rect.height - thumbRows * LINE);
      scrollTo({ top: Math.min(1, Math.max(0, ratio)) * maxScroll() });
    });
    let startY = 0;
    let startScroll = 0;
    thumb.addEventListener("pointerdown", (e) => {
      startY = e.clientY;
      startScroll = scrollY;
      thumb.setPointerCapture(e.pointerId);
      thumb.classList.add("is-dragging");
      doc.style.scrollBehavior = "auto"; // follow the pointer exactly while dragging
    });
    thumb.addEventListener("pointermove", (e) => {
      if (!thumb.hasPointerCapture(e.pointerId)) return;
      const trackSpace = root.clientHeight - thumbRows * LINE;
      scrollTo({ top: startScroll + ((e.clientY - startY) / trackSpace) * maxScroll() });
    });
    const stop = (e: PointerEvent) => {
      if (thumb.hasPointerCapture(e.pointerId)) thumb.releasePointerCapture(e.pointerId);
      thumb.classList.remove("is-dragging");
      doc.style.removeProperty("scroll-behavior");
    };
    thumb.addEventListener("pointerup", stop);
    thumb.addEventListener("pointercancel", stop);
  }
</script>
