// Cloudflare Workers: static site from ./dist plus the /api/chat endpoint in worker/index.ts.
// Deploy with: npm run deploy
// Set the Gemini key once with: npx wrangler secret put GEMINI_API_KEY
{
  "name": "jerome-tegrado-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    // Only this site may call the chat API. Add your own domain here too if you move to one.
    "ALLOWED_ORIGINS": "https://jerome-tegrado-portfolio.tegradojeromebrent.workers.dev"
  },
  // 10 chat messages per visitor IP per minute.
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
