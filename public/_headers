# Browser caching for Cloudflare's static assets. Pages stay fresh (the default revalidates every visit).
# Files in /_astro have a content hash in their name, so a new build always gets a new URL: cache them for good.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and images keep their names across builds, so they're cached for a week and then checked again.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
